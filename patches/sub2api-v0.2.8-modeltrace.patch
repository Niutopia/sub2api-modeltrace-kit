@@ -0,0 +1,99 @@
+package modeltrace
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type proxyRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f proxyRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestAccountsProxy_CallProxyTransport(t *testing.T) {
+	origTransport := http.DefaultTransport
+	defer func() { http.DefaultTransport = origTransport }()
+
+	t.Setenv("MODELTRACE_INTERNAL_URL", "http://127.0.0.1:8081")
+	t.Setenv("MODELTRACE_SECRET", "super-secret")
+
+	// 1. Success case GET /accounts
+	http.DefaultTransport = proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, "Bearer super-secret", r.Header.Get("Authorization"))
+		require.Equal(t, "/accounts", r.URL.Path)
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusOK)
+		_, _ = rec.Write([]byte(`{"accounts":[{"account_id":17,"name":"test"}]}`))
+		return rec.Result(), nil
+	})
+
+	res, err := GetAccounts(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, res.StatusCode)
+	require.Contains(t, string(res.Body), "account_id")
+
+	// 2. GET /accounts/:id
+	http.DefaultTransport = proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, "/accounts/17", r.URL.Path)
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusOK)
+		_, _ = rec.Write([]byte(`{"account_id":17,"name":"test"}`))
+		return rec.Result(), nil
+	})
+
+	res, err = GetAccountDetail(context.Background(), 17)
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, res.StatusCode)
+
+	// 3. POST /accounts/:id/run -> 202 Accepted with body
+	http.DefaultTransport = proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, http.MethodPost, r.Method)
+		require.Equal(t, "/accounts/17/run", r.URL.Path)
+		b, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		require.Equal(t, `{"model":"gpt-4o"}`, string(b))
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusAccepted)
+		_, _ = rec.Write([]byte(`{"queued":true}`))
+		return rec.Result(), nil
+	})
+
+	res, err = RunAccount(context.Background(), 17, []byte(`{"model":"gpt-4o"}`))
+	require.NoError(t, err)
+	require.Equal(t, http.StatusAccepted, res.StatusCode)
+
+	// 4. 404 Not Found on GET
+	http.DefaultTransport = proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusNotFound)
+		return rec.Result(), nil
+	})
+	_, err = GetAccountDetail(context.Background(), 999)
+	require.ErrorIs(t, err, ErrNotFound)
+
+	// 5. POST /accounts/:id/run with 409 Conflict -> preserved status code & body
+	http.DefaultTransport = proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusConflict)
+		_, _ = rec.Write([]byte(`{"error":"already_queued"}`))
+		return rec.Result(), nil
+	})
+	res, err = RunAccount(context.Background(), 17)
+	require.NoError(t, err)
+	require.Equal(t, http.StatusConflict, res.StatusCode)
+	require.Equal(t, `{"error":"already_queued"}`, string(res.Body))
+
+	// 6. Echoes secret -> fail closed
+	http.DefaultTransport = proxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusOK)
+		_, _ = rec.Write([]byte(`{"leak":"super-secret"}`))
+		return rec.Result(), nil
+	})
+	_, err = GetAccounts(context.Background())
+	require.ErrorIs(t, err, ErrUnavailable)
+}
