+
+func modelLimitEntry(t *testing.T, accountID int64, scope string) map[string]any {
+	t.Helper()
+	var raw []byte
+	require.NoError(t, integrationDB.QueryRowContext(context.Background(),
+		`SELECT COALESCE(extra->'model_rate_limits'->$1, 'null'::jsonb) FROM accounts WHERE id = $2`, scope, accountID).Scan(&raw))
+	var entry map[string]any
+	require.NoError(t, json.Unmarshal(raw, &entry))
+	return entry
+}
+
+func TestModelTracePauseKeepsAndRestoresOtherLimit(t *testing.T) {
+	ctx := context.Background()
+	repo := newAccountRepositoryWithSQL(integrationEntClient, integrationDB, nil)
+	account := mustCreateAccount(t, integrationEntClient, &service.Account{Name: "limit-preserve-" + time.Now().Format("150405.000000"), Platform: service.PlatformOpenAI, Type: service.AccountTypeAPIKey})
+	const scope = "gpt-6-luna"
+	const reason = service.ModelTraceRateLimitReason
+
+	cooldownUntil := time.Now().Add(30 * time.Minute).UTC().Truncate(time.Second)
+	require.NoError(t, repo.SetModelRateLimit(ctx, account.ID, scope, cooldownUntil, "upstream_model_access_changed"))
+
+	require.NoError(t, repo.SetModelRateLimitPreservingOther(ctx, account.ID, scope, time.Now().Add(24*time.Hour), reason))
+	entry := modelLimitEntry(t, account.ID, scope)
+	require.Equal(t, reason, entry["reason"])
+	preserved := entry["preserved"].(map[string]any)
+	require.Equal(t, "upstream_model_access_changed", preserved["reason"])
+	require.Equal(t, cooldownUntil.Format(time.RFC3339), preserved["rate_limit_reset_at"])
+
+	// A repeated pause keeps what was preserved instead of preserving itself.
+	require.NoError(t, repo.SetModelRateLimitPreservingOther(ctx, account.ID, scope, time.Now().Add(25*time.Hour), reason))
+	entry = modelLimitEntry(t, account.ID, scope)
+	require.Equal(t, "upstream_model_access_changed", entry["preserved"].(map[string]any)["reason"])
+
+	cleared, err := repo.ClearModelRateLimitScopeIfReason(ctx, account.ID, scope, reason)
+	require.NoError(t, err)
+	require.True(t, cleared)
+	entry = modelLimitEntry(t, account.ID, scope)
+	require.Equal(t, "upstream_model_access_changed", entry["reason"], "the cooldown is still active, so it comes back")
+	require.Equal(t, cooldownUntil.Format(time.RFC3339), entry["rate_limit_reset_at"])
+
+	// The restored cooldown carries another reason, so a second resume leaves it alone.
+	cleared, err = repo.ClearModelRateLimitScopeIfReason(ctx, account.ID, scope, reason)
+	require.NoError(t, err)
+	require.False(t, cleared)
+}
+
+func TestModelTracePauseDropsExpiredOtherLimit(t *testing.T) {
+	ctx := context.Background()
+	repo := newAccountRepositoryWithSQL(integrationEntClient, integrationDB, nil)
+	account := mustCreateAccount(t, integrationEntClient, &service.Account{Name: "limit-expired-" + time.Now().Format("150405.000000"), Platform: service.PlatformOpenAI, Type: service.AccountTypeAPIKey})
+	const scope = "gpt-6-astra"
+
+	require.NoError(t, repo.SetModelRateLimit(ctx, account.ID, scope, time.Now().Add(-time.Minute), "upstream_404_model_not_found"))
+	require.NoError(t, repo.SetModelRateLimitPreservingOther(ctx, account.ID, scope, time.Now().Add(time.Hour), service.ModelTraceRateLimitReason))
+	entry := modelLimitEntry(t, account.ID, scope)
+	require.NotContains(t, entry, "preserved", "an expired limit is not worth keeping")
+
+	cleared, err := repo.ClearModelRateLimitScopeIfReason(ctx, account.ID, scope, service.ModelTraceRateLimitReason)
+	require.NoError(t, err)
+	require.True(t, cleared)
+	require.Nil(t, modelLimitEntry(t, account.ID, scope))
+}
