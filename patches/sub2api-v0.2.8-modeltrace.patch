+	"github.com/stretchr/testify/require"
+)
+
+func TestOpenAIResponsesModelTraceProbeRouting(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	const secret = "test-secret-d1a"
+	t.Setenv(service.ModelTraceSecretEnv, secret)
+
+	t.Run("invalid probe secret behaves as normal request and strips headers", func(t *testing.T) {
+		h, repo, upstream, router, cleanup := newGrokCredentialFailoverHandler(t, "postmap_cancel")
+		defer cleanup()
+		_ = h
+		upstream.failAccountID = 0
+
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/openai/v1/responses", bytes.NewBufferString(`{"model":"grok","input":"hello","stream":false}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set(service.ModelTraceProbeHeader, "wrong-secret")
+		req.Header.Set(service.ModelTraceAccountHeader, "802")
+		router.ServeHTTP(recorder, req)
+
+		require.Equal(t, http.StatusOK, recorder.Code, recorder.Body.String())
+		// Standard scheduler picked account 801 (not forced 802)
+		require.Equal(t, []int64{801}, upstream.accountHits())
+		require.Empty(t, repo.errorIDs())
+
+		// Verify probe headers were stripped before forwarding to upstream
+		require.Empty(t, req.Header.Get(service.ModelTraceProbeHeader))
+		require.Empty(t, req.Header.Get(service.ModelTraceAccountHeader))
+	})
+
+	t.Run("valid probe secret routes strictly to designated account and strips headers", func(t *testing.T) {
+		h, repo, upstream, router, cleanup := newGrokCredentialFailoverHandler(t, "postmap_cancel")
+		defer cleanup()
+		_ = h
+		upstream.failAccountID = 0
+
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/openai/v1/responses", bytes.NewBufferString(`{"model":"grok","input":"hello","stream":false}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set(service.ModelTraceProbeHeader, secret)
+		req.Header.Set(service.ModelTraceAccountHeader, "802")
+		router.ServeHTTP(recorder, req)
+
+		require.Equal(t, http.StatusOK, recorder.Code, recorder.Body.String())
+		require.Contains(t, recorder.Body.String(), "resp_healthy")
+		// Strictly hits designated account 802 (ignoring normal order which starts with 801)
+		require.Equal(t, []int64{802}, upstream.accountHits())
+		require.Empty(t, repo.errorIDs())
+
+		// Headers stripped
+		require.Empty(t, req.Header.Get(service.ModelTraceProbeHeader))
+		require.Empty(t, req.Header.Get(service.ModelTraceAccountHeader))
+	})
+
+	t.Run("designated account unsupported model returns 503 probe_account_unavailable", func(t *testing.T) {
+		h, repo, upstream, router, cleanup := newGrokCredentialFailoverHandler(t, "postmap_cancel")
+		defer cleanup()
+		_ = h
+		upstream.failAccountID = 0
+
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/openai/v1/responses", bytes.NewBufferString(`{"model":"unsupported-model","input":"hello","stream":false}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set(service.ModelTraceProbeHeader, secret)
+		req.Header.Set(service.ModelTraceAccountHeader, "802")
+		router.ServeHTTP(recorder, req)
+
+		require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
+		require.Contains(t, recorder.Body.String(), service.ProbeAccountUnavailableCode)
+		// Upstream never hit
+		require.Empty(t, upstream.accountHits())
+		require.Empty(t, repo.errorIDs())
+	})
+
+	t.Run("designated account nonexistent returns 503 probe_account_unavailable", func(t *testing.T) {
+		h, _, upstream, router, cleanup := newGrokCredentialFailoverHandler(t, "postmap_cancel")
+		defer cleanup()
+		_ = h
+		upstream.failAccountID = 0
+
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/openai/v1/responses", bytes.NewBufferString(`{"model":"grok","input":"hello","stream":false}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set(service.ModelTraceProbeHeader, secret)
+		req.Header.Set(service.ModelTraceAccountHeader, "99999")
+		router.ServeHTTP(recorder, req)
+
+		require.Equal(t, http.StatusServiceUnavailable, recorder.Code)
+		require.Contains(t, recorder.Body.String(), service.ProbeAccountUnavailableCode)
+		require.Empty(t, upstream.accountHits())
+	})
+
+	t.Run("probe request fails upstream without failover or account switching", func(t *testing.T) {
+		// Set failAccountID to 801. In normal flow, 801 fails and fails over to 802.
+		// For probe request on 801, it must fail directly and NOT switch to 802!
+		h, _, upstream, router, cleanup := newGrokCredentialFailoverHandler(t, "postmap_cancel")
+		defer cleanup()
+		_ = h
+		upstream.failAccountID = 801
+
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/openai/v1/responses", bytes.NewBufferString(`{"model":"grok","input":"hello","stream":false}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set(service.ModelTraceProbeHeader, secret)
+		req.Header.Set(service.ModelTraceAccountHeader, "801")
+		router.ServeHTTP(recorder, req)
+
+		// Must fail
+		require.NotEqual(t, http.StatusOK, recorder.Code)
+		// Only 801 hit once, NO failover to 802
+		require.Equal(t, []int64{801}, upstream.accountHits())
+	})
+
+	t.Run("streaming probe request routes to designated account and works", func(t *testing.T) {
+		h, _, upstream, router, cleanup := newGrokCredentialFailoverHandler(t, "postmap_cancel")
+		defer cleanup()
+		_ = h
+		upstream.failAccountID = 0
+
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/openai/v1/responses", bytes.NewBufferString(`{"model":"grok","input":"hello","stream":true}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set(service.ModelTraceProbeHeader, secret)
+		req.Header.Set(service.ModelTraceAccountHeader, "802")
+		router.ServeHTTP(recorder, req)
+
+		require.Equal(t, http.StatusOK, recorder.Code)
+		require.Equal(t, []int64{802}, upstream.accountHits())
+		require.Contains(t, recorder.Body.String(), "response.completed")
+	})
+}
+
