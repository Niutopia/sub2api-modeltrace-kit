diff --git a/frontend/src/api/admin/modelTrace.ts b/frontend/src/api/admin/modelTrace.ts
new file mode 100644
index 000000000..f1e370ee6
--- /dev/null
+++ b/frontend/src/api/admin/modelTrace.ts
@@ -0,0 +1,115 @@
+import { apiClient } from '../client'
+import type { TraceCandidate, TraceSnapshotTiming } from '../modelTrace'
+
+export interface AccountTraceLatest {
+  account_id?: number
+  model: string
+  status: 'match' | 'suspect' | 'uncertain' | 'error' | 'interrupted' | string
+  message_code: string
+  target_probability: number | null
+  best_model: string | null
+  checked_at: string
+  reasoning_effort?: string
+  ranking?: TraceCandidate[]
+}
+
+export interface AccountTracePerModel {
+  model: string
+  latest: AccountTraceLatest | null
+  history: AccountTraceLatest[]
+  /** Until when the checker has paused this model on this target (RFC3339), or null. */
+  paused_until?: string | null
+}
+
+/** One key of a target (a single account has exactly one). */
+export interface AccountTraceMember {
+  account_id: number
+  name: string
+  /** false: the key exists but is outside the host's scheduling pool. */
+  participating: boolean
+  inactive_reason?: string | null
+  models: string[]
+  latest_by_model: Record<string, AccountTraceLatest | null>
+}
+
+export interface AccountTraceItem extends TraceSnapshotTiming {
+  account_id: number
+  name: string
+  cluster_id?: string | null
+  cluster_name?: string | null
+  member_account_ids?: number[]
+  /** Current probeable targets, not the set of models with historical results. */
+  models: string[]
+  /** Actual pending/running job model; independent of historical results. */
+  next_model?: string | null
+  /** May include history for models removed from the current target set. */
+  per_model?: AccountTracePerModel[]
+  mode: 'active' | 'idle' | string
+  /** false: no key of this target is in the scheduling pool; only last results are shown. */
+  participating?: boolean
+  inactive_reason?: string | null
+  members?: AccountTraceMember[]
+  interval_seconds: number
+  last_real_request_at: string | null
+  next_run_at: string | null
+  running: boolean
+  queued: boolean
+  latest: AccountTraceLatest | null
+  history: AccountTraceLatest[]
+  retest_progress?: { done: number; total: number } | null
+}
+
+export interface AccountTraceListResponse {
+  /** Common DB read watermark, including for an empty account list. */
+  snapshot_at?: string
+  accounts: AccountTraceItem[]
+}
+
+export async function getAdminAccountTraces(signal?: AbortSignal): Promise<AccountTraceListResponse> {
+  const { data } = await apiClient.get<AccountTraceListResponse>('/admin/modeltrace/accounts', { signal })
+  return data
+}
+
+export async function getAdminAccountTrace(accountId: number, signal?: AbortSignal): Promise<AccountTraceItem> {
+  const { data } = await apiClient.get<AccountTraceItem>(`/admin/modeltrace/accounts/${accountId}`, { signal })
+  return data
+}
+
+export async function runAdminAccountTrace(accountId: number, model?: string, signal?: AbortSignal): Promise<void> {
+  const payload = model ? { model } : undefined
+  try {
+    await apiClient.post(`/admin/modeltrace/accounts/${accountId}/run`, payload, { signal })
+  } catch (err: any) {
+    const errorKey = err?.error || err?.message
+    if (errorKey === 'not_participating' || err?.message_code === 'not_participating') {
+      const e = new Error('账号未参与调度，已停止探测')
+      Object.assign(e, err)
+      throw e
+    }
+    if (err?.status === 400 || errorKey === 'model_not_supported') {
+      const e = new Error('该模型不在此账号支持列表')
+      Object.assign(e, err)
+      throw e
+    }
+    if (err?.status === 409 || errorKey === 'already_queued') {
+      const e = new Error('已在排队或检测中')
+      Object.assign(e, err)
+      throw e
+    }
+    throw err
+  }
+}
+
+/** Manually lift the checker's pause for a model and clear its suspect verdict. */
+export async function resetAdminAccountTrace(accountId: number, model: string, signal?: AbortSignal): Promise<void> {
+  await apiClient.post(`/admin/modeltrace/accounts/${accountId}/reset`, { model }, { signal })
+}
+
+export const adminModelTraceAPI = {
+  getAccounts: getAdminAccountTraces,
+  getAccount: getAdminAccountTrace,
+  runAccount: runAdminAccountTrace,
+  resetAccount: resetAdminAccountTrace,
+}
+
+export default adminModelTraceAPI
diff --git a/frontend/src/api/modelTrace.ts b/frontend/src/api/modelTrace.ts
new file mode 100644
index 000000000..64831196c
--- /dev/null
+++ b/frontend/src/api/modelTrace.ts
@@ -0,0 +1,87 @@
+import { apiClient } from './client'
+
+export interface TraceCandidate {
+  model: string
+  probability: number
+}
+
+export interface TraceRound {
+  id: number
+  status: string
+  target_probability: number | null
+  best_model: string | null
+  checked_at: string
+  message_code: string
+  ranking: TraceCandidate[]
+}
+
+export interface RetestProgress {
+  done: number
+  total: number
+}
+
+export interface AccountsSummary {
+  model: string
+  total: number
+  match: number
+  suspect: number
+  uncertain: number
+  error: number
+  active: number
+}
+
+/** Optional during rollout. Snapshot time is a read watermark, never a check time. */
+export interface TraceSnapshotTiming {
+  snapshot_at?: string
+  queued_at?: string | null
+  available_at?: string | null
+  started_at?: string | null
+  schedule_mode?: 'scheduled' | 'manual'
+}
+
+/** Compare DB read watermarks without dropping UTC ISO sub-millisecond precision. */
+export function isOlderTraceSnapshot(incoming: string | undefined, current: string | undefined): boolean {
+  const currentMs = Date.parse(current || '')
+  if (!Number.isFinite(currentMs)) return false
+  const incomingMs = Date.parse(incoming || '')
+  if (!Number.isFinite(incomingMs)) return true
+  if (incomingMs !== currentMs) return incomingMs < currentMs
+  const micros = (value: string | undefined) =>
+    (value?.match(/\.(\d+)(?:Z|[+-]\d{2}:\d{2})$/i)?.[1] || '').padEnd(6, '0').slice(3, 6)
+  return micros(incoming) < micros(current)
+}
+
+export interface TraceSnapshot extends TraceSnapshotTiming {
+  monitor_id: number
+  model: string
+  scope_label: string
+  enabled: boolean
+  supported: boolean
+  running: boolean
+  /** Optional during rollout from sidecars without explicit scheduling state. */
+  queued?: boolean
+  interval_seconds: number
+  last_checked_at: string | null
+  next_run_at: string | null
+  paused_budget?: boolean
+  paused_reconciliation?: boolean
+  next_run_after?: string | null
+  stale: boolean
+  latest: TraceRound | null
+  history: TraceRound[]
+  protocol: string
+  reasoning_effort: string
+  service_tier: string
+  retest_progress?: RetestProgress | null
+  accounts_summary?: AccountsSummary | null
+}
+
+export async function getModelTrace(id: number, signal?: AbortSignal): Promise<TraceSnapshot> {
+  const { data } = await apiClient.get<TraceSnapshot>(`/channel-monitors/${id}/modeltrace`, { signal })
+  return data
+}
+
+// Cancel the local submission when its panel is replaced; an already accepted job may still run.
+export async function runModelTrace(id: number, signal?: AbortSignal): Promise<void> {
+  await apiClient.post(`/admin/channel-monitors/${id}/modeltrace/run`, undefined, { signal })
+}
