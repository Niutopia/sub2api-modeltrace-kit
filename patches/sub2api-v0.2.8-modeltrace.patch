diff --git a/backend/internal/pkg/modeltrace/accounts_proxy.go b/backend/internal/pkg/modeltrace/accounts_proxy.go
new file mode 100644
index 000000000..47e493283
--- /dev/null
+++ b/backend/internal/pkg/modeltrace/accounts_proxy.go
@@ -0,0 +1,179 @@
+package modeltrace
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+)
+
+var (
+	ErrNotFound = errors.New("model consistency resource not found")
+)
+
+// ForwardResult holds raw JSON response and HTTP status for proxy endpoints.
+type ForwardResult struct {
+	StatusCode int
+	Body       []byte
+}
+
+func callProxy(ctx context.Context, method, subpath string, body []byte) (*ForwardResult, error) {
+	base := strings.TrimRight(os.Getenv("MODELTRACE_INTERNAL_URL"), "/")
+	secret := os.Getenv("MODELTRACE_SECRET")
+	u, err := url.Parse(base)
+	if err != nil || !isAllowedInternalURL(u) || secret == "" {
+		return nil, ErrUnavailable
+	}
+
+	path := fmt.Sprintf("%s%s", base, subpath)
+	var requestBody io.Reader
+	if len(body) > 0 {
+		requestBody = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, path, requestBody)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	req.Header.Set("Authorization", "Bearer "+secret)
+	if len(body) > 0 {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	client := &http.Client{
+		Timeout: 5 * time.Second,
+		CheckRedirect: func(_ *http.Request, _ []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	res, err := client.Do(req)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	defer res.Body.Close()
+
+	responseBody, err := io.ReadAll(io.LimitReader(res.Body, 524289))
+	if err != nil || len(responseBody) > 524288 {
+		return nil, ErrUnavailable
+	}
+
+	switch res.StatusCode {
+	case http.StatusNotFound:
+		return nil, ErrNotFound
+	case http.StatusConflict:
+		if modelTraceMessageCode(responseBody) == "duplicate" {
+			return nil, ErrBusy
+		}
+		return nil, ErrUnavailable
+	case http.StatusTooManyRequests:
+		return nil, ErrBusy
+	}
+
+	if res.StatusCode < 200 || res.StatusCode >= 300 {
+		return nil, ErrUnavailable
+	}
+
+	// Fail closed if the payload contains MODELTRACE_SECRET
+	encodedSecret, _ := json.Marshal(secret)
+	if bytes.Contains(responseBody, encodedSecret[1:len(encodedSecret)-1]) {
+		return nil, ErrUnavailable
+	}
+
+	return &ForwardResult{
+		StatusCode: res.StatusCode,
+		Body:       responseBody,
+	}, nil
+}
+
+// GetAccounts fetches accounts list from ModelTrace sidecar: GET /accounts.
+func GetAccounts(ctx context.Context) (*ForwardResult, error) {
+	return callProxy(ctx, http.MethodGet, "/accounts", nil)
+}
+
+// GetAccountDetail fetches account detail from ModelTrace sidecar: GET /accounts/:account_id.
+func GetAccountDetail(ctx context.Context, accountID int64) (*ForwardResult, error) {
+	if accountID <= 0 {
+		return nil, ErrNotFound
+	}
+	return callProxy(ctx, http.MethodGet, fmt.Sprintf("/accounts/%d", accountID), nil)
+}
+
+// RunAccountDirect forwards POST /accounts/:account_id/run with transparent status & body handling.
+func RunAccountDirect(ctx context.Context, accountID int64, body []byte) (*ForwardResult, error) {
+	return postAccountAction(ctx, accountID, "run", body)
+}
+
+// ResetAccount forwards POST /accounts/:account_id/reset (manual reset of a paused model).
+func ResetAccount(ctx context.Context, accountID int64, body []byte) (*ForwardResult, error) {
+	return postAccountAction(ctx, accountID, "reset", body)
+}
+
+// postAccountAction forwards POST /accounts/:account_id/<action>, passing ModelTrace's status and body through.
+func postAccountAction(ctx context.Context, accountID int64, action string, body []byte) (*ForwardResult, error) {
+	if accountID <= 0 {
+		return nil, ErrNotFound
+	}
+	base := strings.TrimRight(os.Getenv("MODELTRACE_INTERNAL_URL"), "/")
+	secret := os.Getenv("MODELTRACE_SECRET")
+	u, err := url.Parse(base)
+	if err != nil || !isAllowedInternalURL(u) || secret == "" {
+		return nil, ErrUnavailable
+	}
+
+	path := fmt.Sprintf("%s/accounts/%d/%s", base, accountID, action)
+	var requestBody io.Reader
+	if len(body) > 0 {
+		requestBody = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, path, requestBody)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	req.Header.Set("Authorization", "Bearer "+secret)
+	if len(body) > 0 {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	client := &http.Client{
+		Timeout: 5 * time.Second,
+		CheckRedirect: func(_ *http.Request, _ []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	res, err := client.Do(req)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	defer res.Body.Close()
+
+	responseBody, err := io.ReadAll(io.LimitReader(res.Body, 524289))
+	if err != nil || len(responseBody) > 524288 {
+		return nil, ErrUnavailable
+	}
+
+	// Fail closed if the payload contains MODELTRACE_SECRET
+	encodedSecret, _ := json.Marshal(secret)
+	if bytes.Contains(responseBody, encodedSecret[1:len(encodedSecret)-1]) {
+		return nil, ErrUnavailable
+	}
+
+	return &ForwardResult{
+		StatusCode: res.StatusCode,
+		Body:       responseBody,
+	}, nil
+}
+
+// RunAccount triggers immediate check for account: POST /accounts/:account_id/run.
+func RunAccount(ctx context.Context, accountID int64, body ...[]byte) (*ForwardResult, error) {
+	var payload []byte
+	if len(body) > 0 {
+		payload = body[0]
+	}
+	return RunAccountDirect(ctx, accountID, payload)
+}
