@@ -0,0 +1,314 @@
+import { onBeforeUnmount, onMounted, reactive, watch, type Ref } from 'vue'
+import { isOlderTraceSnapshot } from '@/api/modelTrace'
+import {
+  getAdminAccountTraces,
+  resetAdminAccountTrace,
+  runAdminAccountTrace,
+  type AccountTraceItem,
+} from '@/api/admin/modelTrace'
+
+export const ACCOUNT_TRACE_DEFAULT_INTERVAL_MS = 60 * 1000
+export const ACCOUNT_TRACE_BUSY_INTERVAL_MS = 3 * 1000
+
+export interface AccountTraceState {
+  data: AccountTraceItem | null
+  loading: boolean
+  unavailable: boolean
+  optimisticQueued: boolean
+}
+
+export interface UseAccountTracePollingResult {
+  traces: ReadonlyMap<number, AccountTraceItem>
+  stateFor: (accountId: number) => AccountTraceState
+  runAccount: (accountId: number, model?: string) => Promise<void>
+  resetAccount: (accountId: number, model: string) => Promise<void>
+  refresh: () => Promise<void>
+  start: () => void
+  stop: () => void
+}
+
+function createAccountState(): AccountTraceState {
+  return {
+    data: null,
+    loading: false,
+    unavailable: false,
+    optimisticQueued: false,
+  }
+}
+
+function isAbortError(error: unknown): boolean {
+  if (!error || typeof error !== 'object') return false
+  const value = error as { name?: string; code?: string }
+  return value.name === 'AbortError' || value.code === 'ERR_CANCELED'
+}
+
+interface PendingRun {
+  controller: AbortController
+  accepted: boolean
+  accountIds: number[]
+}
+
+export function useAccountTracePolling(
+  enabledRef?: Ref<boolean>,
+): UseAccountTracePollingResult {
+  const traceMap = reactive(new Map<number, AccountTraceItem>())
+  const states = reactive(new Map<number, AccountTraceState>())
+  // Track optimistic queued account IDs
+  const pendingRuns = new Map<number, PendingRun>()
+  const actionControllers = new Set<AbortController>()
+
+  let pollTimer: ReturnType<typeof setTimeout> | undefined
+  let currentController: AbortController | null = null
+  let enabled = enabledRef ? enabledRef.value : true
+  let disposed = false
+  let lastSnapshotAt: string | undefined
+
+  const isHidden = () => typeof document !== 'undefined' && document.hidden
+
+  function clearPollTimer(): void {
+    if (pollTimer !== undefined) clearTimeout(pollTimer)
+    pollTimer = undefined
+  }
+
+  function hasBusyAccount(): boolean {
+    if (pendingRuns.size > 0) return true
+    for (const item of traceMap.values()) {
+      if (item.running || item.queued) return true
+    }
+    return false
+  }
+
+  function schedulePoll(): void {
+    clearPollTimer()
+    if (!enabled || disposed || isHidden()) return
+    const interval = hasBusyAccount()
+      ? ACCOUNT_TRACE_BUSY_INTERVAL_MS
+      : ACCOUNT_TRACE_DEFAULT_INTERVAL_MS
+    pollTimer = setTimeout(() => {
+      pollTimer = undefined
+      void refresh()
+    }, interval)
+  }
+
+  function getOrCreateState(accountId: number): AccountTraceState {
+    let state = states.get(accountId)
+    if (!state) {
+      state = createAccountState()
+      states.set(accountId, state)
+    }
+    return state
+  }
+
+  function isOptimisticQueued(accountId: number): boolean {
+    return [...pendingRuns.values()].some(run => run.accountIds.includes(accountId))
+  }
+
+  function updateOptimisticQueuedStates(): void {
+    for (const [id, state] of states.entries()) {
+      state.optimisticQueued = isOptimisticQueued(id)
+    }
+  }
+
+  function cancelRefresh(): void {
+    currentController?.abort()
+    currentController = null
+    for (const state of states.values()) state.loading = false
+  }
+
+  async function refresh(): Promise<void> {
+    if (!enabled || disposed || isHidden()) return
+    clearPollTimer()
+    cancelRefresh()
+    const controller = new AbortController()
+    currentController = controller
+    // Only a GET begun after POST acceptance may settle local optimism.
+    // Historical checked_at is never evidence that this new job finished.
+    const acceptedRuns = new Map([...pendingRuns].filter(([, run]) => run.accepted))
+
+    for (const state of states.values()) {
+      state.loading = true
+    }
+
+    try {
+      const res = await getAdminAccountTraces(controller.signal)
+      if (disposed || controller.signal.aborted || currentController !== controller) return
+      if (isOlderTraceSnapshot(res.snapshot_at, lastSnapshotAt)) return
+      for (const acc of res.accounts || []) {
+        const existing = traceMap.get(acc.account_id)
+          ?? acc.member_account_ids?.map(id => traceMap.get(id)).find(Boolean)
+        // Do not apply an older read view, including its membership deletions.
+        if (isOlderTraceSnapshot(acc.snapshot_at ?? res.snapshot_at, existing?.snapshot_at)) return
+      }
+      lastSnapshotAt = res.snapshot_at
+
+      traceMap.clear()
+      const receivedIds = new Set<number>()
+      for (const acc of res.accounts || []) {
+        // One entry per upstream: every member key id resolves to it, so the
+        // account page can look the upstream up by any of its keys.
+        const ids = [...new Set([acc.account_id, ...(acc.member_account_ids || [])])]
+        for (const id of ids) {
+          traceMap.set(id, acc)
+          receivedIds.add(id)
+          const state = getOrCreateState(id)
+          state.data = acc
+          state.unavailable = false
+        }
+      }
+      // Fresh idle (or removed) targets also settle an accepted job, even
+      // when it finished between polls without producing a scored result.
+      for (const [id, run] of acceptedRuns) {
+        if (pendingRuns.get(id) === run) pendingRuns.delete(id)
+      }
+
+      // For accounts in states that weren't returned:
+      for (const [id, state] of states.entries()) {
+        if (!receivedIds.has(id)) {
+          state.data = null
+          state.unavailable = false
+        }
+      }
+      updateOptimisticQueuedStates()
+    } catch (err: unknown) {
+      if (disposed || controller.signal.aborted || currentController !== controller) return
+      if (isAbortError(err)) return
+      for (const state of states.values()) {
+        state.unavailable = true
+      }
+    } finally {
+      if (currentController === controller) {
+        currentController = null
+        for (const state of states.values()) {
+          state.loading = false
+        }
+        schedulePoll()
+      }
+    }
+  }
+
+  async function runAccount(accountId: number, model?: string): Promise<void> {
+    if (disposed || isOptimisticQueued(accountId)) return
+    cancelRefresh()
+    // Also add cluster members if known
+    const item = traceMap.get(accountId)
+    const affectedIds = [accountId, ...(item ? [item.account_id] : [])]
+    if (item?.member_account_ids) {
+      for (const mId of item.member_account_ids) {
+        affectedIds.push(mId)
+      }
+    }
+    const controller = new AbortController()
+    const run: PendingRun = { controller, accepted: false, accountIds: [...new Set(affectedIds)] }
+    pendingRuns.set(accountId, run)
+    actionControllers.add(controller)
+    for (const id of run.accountIds) {
+      const state = getOrCreateState(id)
+      state.optimisticQueued = true
+    }
+
+    try {
+      await runAdminAccountTrace(accountId, model, controller.signal)
+      if (disposed || controller.signal.aborted || pendingRuns.get(accountId) !== run) return
+      run.accepted = true
+      // Invalidate a GET that raced the POST, even if the page is hidden.
+      cancelRefresh()
+      // On success, trigger polling immediately (3s or immediate)
+      void refresh()
+    } catch (err) {
+      if (disposed || controller.signal.aborted || pendingRuns.get(accountId) !== run) return
+      pendingRuns.delete(accountId)
+      updateOptimisticQueuedStates()
+      void refresh()
+      throw err
+    } finally {
+      actionControllers.delete(controller)
+    }
+  }
+
+  async function resetAccount(accountId: number, model: string): Promise<void> {
+    if (disposed) return
+    const controller = new AbortController()
+    actionControllers.add(controller)
+    cancelRefresh()
+    try {
+      await resetAdminAccountTrace(accountId, model, controller.signal)
+      if (disposed || controller.signal.aborted) return
+      cancelRefresh()
+      void refresh()
+    } catch (err) {
+      if (disposed || controller.signal.aborted) return
+      void refresh()
+      throw err
+    } finally {
+      actionControllers.delete(controller)
+    }
+  }
+
+  function stateFor(accountId: number): AccountTraceState {
+    const state = getOrCreateState(accountId)
+    const data = traceMap.get(accountId) ?? null
+    state.data = data
+    state.optimisticQueued = isOptimisticQueued(accountId)
+    return state
+  }
+
+  function start(): void {
+    if (disposed) return
+    enabled = true
+    if (!isHidden() && !currentController) void refresh()
+  }
+
+  function stop(): void {
+    enabled = false
+    clearPollTimer()
+    cancelRefresh()
+  }
+
+  function handleVisibilityChange(): void {
+    if (isHidden()) {
+      clearPollTimer()
+      cancelRefresh()
+    } else if (enabled) {
+      void refresh()
+    }
+  }
+
+  if (enabledRef) {
+    watch(
+      enabledRef,
+      (val) => {
+        if (val) start()
+        else stop()
+      },
+      { immediate: true }
+    )
+  }
+
+  onMounted(() => {
+    if (typeof document !== 'undefined') {
+      document.addEventListener('visibilitychange', handleVisibilityChange)
+    }
+    if (enabled) start()
+  })
+
+  onBeforeUnmount(() => {
+    disposed = true
+    for (const controller of actionControllers) controller.abort()
+    actionControllers.clear()
+    pendingRuns.clear()
+    if (typeof document !== 'undefined') {
+      document.removeEventListener('visibilitychange', handleVisibilityChange)
+    }
+    stop()
+  })
+
+  return {
+    traces: traceMap,
+    stateFor,
+    runAccount,
+    resetAccount,
+    refresh,
+    start,
+    stop,
+  }
+}
