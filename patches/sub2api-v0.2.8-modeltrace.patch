@@ -0,0 +1,171 @@
+package admin
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type handlerProxyRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f handlerProxyRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestModelTraceHandler(t *testing.T) {
+	origTransport := http.DefaultTransport
+	defer func() { http.DefaultTransport = origTransport }()
+
+	t.Setenv("MODELTRACE_INTERNAL_URL", "http://127.0.0.1:8081")
+	t.Setenv("MODELTRACE_SECRET", "test-secret")
+
+	gin.SetMode(gin.TestMode)
+	h := NewModelTraceHandler()
+
+	r := gin.New()
+	r.GET("/accounts", h.GetAccounts)
+	r.GET("/accounts/:account_id", h.GetAccountDetail)
+	r.POST("/accounts/:account_id/run", h.RunAccount)
+
+	// 1. Invalid ID param
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/accounts/abc", nil))
+	require.Equal(t, http.StatusBadRequest, w.Code)
+
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/0/run", nil))
+	require.Equal(t, http.StatusBadRequest, w.Code)
+
+	// 2. Success GET /accounts
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusOK)
+		_, _ = rec.Write([]byte(`{"accounts":[]}`))
+		return rec.Result(), nil
+	})
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/accounts", nil))
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, `{"accounts":[]}`, w.Body.String())
+
+	// 3. Success GET /accounts/:account_id
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusOK)
+		_, _ = rec.Write([]byte(`{"account_id":17}`))
+		return rec.Result(), nil
+	})
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/accounts/17", nil))
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, `{"account_id":17}`, w.Body.String())
+
+	// 4. Success POST /accounts/:account_id/run with body forwarding
+	var receivedBody []byte
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		var err error
+		receivedBody, err = io.ReadAll(r.Body)
+		require.NoError(t, err)
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusAccepted)
+		_, _ = rec.Write([]byte(`{"queued":true,"model":"gpt-4o"}`))
+		return rec.Result(), nil
+	})
+	w = httptest.NewRecorder()
+	reqBody := `{"model":"gpt-4o"}`
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/17/run", bytes.NewBufferString(reqBody)))
+	require.Equal(t, http.StatusAccepted, w.Code)
+	require.Equal(t, `{"queued":true,"model":"gpt-4o"}`, w.Body.String())
+	require.Equal(t, reqBody, string(receivedBody))
+
+	// 5. POST body exceeds 4KB limit -> 400
+	w = httptest.NewRecorder()
+	hugeBody := strings.Repeat("x", 4097)
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/17/run", bytes.NewBufferString(hugeBody)))
+	require.Equal(t, http.StatusBadRequest, w.Code)
+
+	// 6. Transparent status & JSON passthrough: 400
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusBadRequest)
+		_, _ = rec.Write([]byte(`{"error":"model_not_supported"}`))
+		return rec.Result(), nil
+	})
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/17/run", bytes.NewBufferString(`{"model":"unsupported"}`)))
+	require.Equal(t, http.StatusBadRequest, w.Code)
+	require.Equal(t, `{"error":"model_not_supported"}`, w.Body.String())
+
+	// 7. Transparent status & JSON passthrough: 409
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusConflict)
+		_, _ = rec.Write([]byte(`{"error":"already_queued"}`))
+		return rec.Result(), nil
+	})
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/17/run", nil))
+	require.Equal(t, http.StatusConflict, w.Code)
+	require.Equal(t, `{"error":"already_queued"}`, w.Body.String())
+
+	// 8. Transparent status & JSON passthrough: 404
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusNotFound)
+		_, _ = rec.Write([]byte(`{"error":"not_found"}`))
+		return rec.Result(), nil
+	})
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/999/run", nil))
+	require.Equal(t, http.StatusNotFound, w.Code)
+	require.Equal(t, `{"error":"not_found"}`, w.Body.String())
+
+	// 9. ModelTrace unreachable / connection error -> 503
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		return nil, http.ErrHandlerTimeout
+	})
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/17/run", nil))
+	require.Equal(t, http.StatusServiceUnavailable, w.Code)
+
+	// 10. GET 404 mapping still preserved
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusNotFound)
+		return rec.Result(), nil
+	})
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/accounts/999", nil))
+	require.Equal(t, http.StatusNotFound, w.Code)
+}
+
+func TestModelTraceHandlerResetForwardsToResetPath(t *testing.T) {
+	origTransport := http.DefaultTransport
+	defer func() { http.DefaultTransport = origTransport }()
+	t.Setenv("MODELTRACE_INTERNAL_URL", "http://127.0.0.1:8081")
+	t.Setenv("MODELTRACE_SECRET", "test-secret")
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	r.POST("/accounts/:account_id/reset", NewModelTraceHandler().ResetAccount)
+
+	var gotPath string
+	var gotBody []byte
+	http.DefaultTransport = handlerProxyRoundTripFunc(func(req *http.Request) (*http.Response, error) {
+		gotPath = req.URL.Path
+		gotBody, _ = io.ReadAll(req.Body)
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusBadRequest)
+		_, _ = rec.Write([]byte(`{"error":"model_not_supported"}`))
+		return rec.Result(), nil
+	})
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/accounts/5/reset", bytes.NewBufferString(`{"model":"gpt-6-astra"}`)))
+	require.Equal(t, "/accounts/5/reset", gotPath)
+	require.JSONEq(t, `{"model":"gpt-6-astra"}`, string(gotBody))
+	require.Equal(t, http.StatusBadRequest, w.Code)
+	require.Equal(t, `{"error":"model_not_supported"}`, w.Body.String())
+}
