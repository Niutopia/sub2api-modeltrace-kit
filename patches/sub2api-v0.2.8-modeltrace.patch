+package handler
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/logger"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"go.uber.org/zap"
+)
+
+// InternalModelTraceHandler handles unexposed/internal ModelTrace requests.
+type InternalModelTraceHandler struct {
+	accountsService *service.ModelTraceAccountsService
+}
+
+// NewInternalModelTraceHandler creates a new InternalModelTraceHandler.
+func NewInternalModelTraceHandler(accountsService *service.ModelTraceAccountsService) *InternalModelTraceHandler {
+	return &InternalModelTraceHandler{
+		accountsService: accountsService,
+	}
+}
+
+// verifyAuth checks the Bearer token against MODELTRACE_SECRET.
+func (h *InternalModelTraceHandler) verifyAuth(c *gin.Context) bool {
+	authHeader := c.GetHeader("Authorization")
+	token := strings.TrimPrefix(authHeader, "Bearer ")
+	if token == authHeader || !service.VerifyModelTraceSecret(strings.TrimSpace(token)) {
+		response.Error(c, http.StatusUnauthorized, "Unauthorized")
+		return false
+	}
+	return true
+}
+
+// GetAccounts GET /api/v1/internal/modeltrace/accounts?models=...
+func (h *InternalModelTraceHandler) GetAccounts(c *gin.Context) {
+	if !h.verifyAuth(c) {
+		return
+	}
+
+	rawModels := c.Query("models")
+	var requestedModels []string
+	if strings.TrimSpace(rawModels) != "" {
+		parts := strings.Split(rawModels, ",")
+		for _, p := range parts {
+			p = strings.TrimSpace(p)
+			if p != "" {
+				requestedModels = append(requestedModels, p)
+			}
+		}
+	}
+
+	includeInactive := c.Query("include_inactive") == "1"
+	resp, err := h.accountsService.GetAccounts(c.Request.Context(), requestedModels, includeInactive)
+	if err != nil {
+		response.Error(c, http.StatusInternalServerError, "Failed to retrieve accounts")
+		return
+	}
+
+	// Contract A1: ModelTrace reads the payload at the top level, without the site-wide response envelope.
+	c.JSON(http.StatusOK, resp)
+}
+
+type ModelPauseRequest struct {
+	Model    string `json:"model"`
+	Minutes  int    `json:"minutes"`
+	Evidence string `json:"evidence"`
+}
+
+// PauseModel POST /api/v1/internal/modeltrace/accounts/:account_id/model-pause
+func (h *InternalModelTraceHandler) PauseModel(c *gin.Context) {
+	if !h.verifyAuth(c) {
+		return
+	}
+
+	accountID, err := strconv.ParseInt(c.Param("account_id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.Error(c, http.StatusBadRequest, "Invalid account ID")
+		return
+	}
+
+	var req ModelPauseRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		response.Error(c, http.StatusBadRequest, "Invalid request body")
+		return
+	}
+
+	model := strings.TrimSpace(req.Model)
+	if model == "" {
+		response.Error(c, http.StatusBadRequest, "model is required")
+		return
+	}
+
+	if req.Minutes < 1 || req.Minutes > 1440 {
+		response.Error(c, http.StatusBadRequest, "minutes must be between 1 and 1440")
+		return
+	}
+
+	result, err := h.accountsService.PauseModel(c.Request.Context(), accountID, model, req.Minutes)
+	if err != nil {
+		if errors.Is(err, service.ErrAccountNotFound) {
+			response.Error(c, http.StatusNotFound, "Account not found or model not supported")
+			return
+		}
+		response.Error(c, http.StatusInternalServerError, "Failed to pause model")
+		return
+	}
+
+	logger.L().Info("modeltrace.model_pause",
+		zap.Int64("account_id", accountID),
+		zap.String("model", model),
+		zap.Int("minutes", req.Minutes),
+		zap.String("evidence", req.Evidence),
+		zap.Bool("changed", result.Changed),
+	)
+
+	c.JSON(http.StatusOK, result)
+}
+
+type ModelResumeRequest struct {
+	Model string `json:"model"`
+}
+
+// ResumeModel POST /api/v1/internal/modeltrace/accounts/:account_id/model-resume
+func (h *InternalModelTraceHandler) ResumeModel(c *gin.Context) {
+	if !h.verifyAuth(c) {
+		return
+	}
+
+	accountID, err := strconv.ParseInt(c.Param("account_id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.Error(c, http.StatusBadRequest, "Invalid account ID")
+		return
+	}
+
+	var req ModelResumeRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		response.Error(c, http.StatusBadRequest, "Invalid request body")
+		return
+	}
+
+	model := strings.TrimSpace(req.Model)
+	if model == "" {
+		response.Error(c, http.StatusBadRequest, "model is required")
+		return
+	}
+
+	result, err := h.accountsService.ResumeModel(c.Request.Context(), accountID, model)
+	if err != nil {
+		if errors.Is(err, service.ErrAccountNotFound) {
+			response.Error(c, http.StatusNotFound, "Account not found or model not supported")
+			return
+		}
+		response.Error(c, http.StatusInternalServerError, "Failed to resume model")
+		return
+	}
+
+	logger.L().Info("modeltrace.model_resume",
+		zap.Int64("account_id", accountID),
+		zap.String("model", model),
+		zap.Bool("resumed", result.Resumed),
+	)
+
+	c.JSON(http.StatusOK, result)
+}
