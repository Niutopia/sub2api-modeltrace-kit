+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// All unimplemented methods panic: metadata may only read configuration once,
+// never decrypt keys, aggregate health, schedule checks or write history.
+type modelTraceMetadataRepo struct {
+	ChannelMonitorRepository
+	monitor *ChannelMonitor
+	err     error
+	ids     []int64
+}
+
+func (r *modelTraceMetadataRepo) GetByID(_ context.Context, id int64) (*ChannelMonitor, error) {
+	r.ids = append(r.ids, id)
+	return r.monitor, r.err
+}
+
+func TestModelTraceMetadataReadOnlyAllowlist(t *testing.T) {
+	monitor := &ChannelMonitor{
+		ID: 7, Enabled: true, PrimaryModel: "model-current", APIKey: "encrypted-private-key",
+		Endpoint: "https://private.invalid", ExtraHeaders: map[string]string{"Authorization": "private-token"},
+	}
+	repo := &modelTraceMetadataRepo{monitor: monitor}
+	metadata, err := NewChannelMonitorService(repo, nil).GetModelTraceMetadata(context.Background(), 7)
+	require.NoError(t, err)
+	require.Equal(t, []int64{7}, repo.ids)
+	encoded, err := json.Marshal(metadata)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"id":7,"primary_model":"model-current"}`, string(encoded))
+	require.Equal(t, "encrypted-private-key", monitor.APIKey)
+	require.Equal(t, "private-token", monitor.ExtraHeaders["Authorization"])
+	monitor.PrimaryModel = "model-new"
+	require.Equal(t, "model-current", metadata.PrimaryModel, "metadata must not alias the full monitor")
+	metadata, err = NewChannelMonitorService(repo, nil).GetModelTraceMetadata(context.Background(), 7)
+	require.NoError(t, err)
+	require.Equal(t, "model-new", metadata.PrimaryModel, "do not cache old primary models")
+}
+
+func TestModelTraceMetadataFailsClosed(t *testing.T) {
+	unavailable := errors.New("repository unavailable")
+	for _, tc := range []struct {
+		name    string
+		monitor *ChannelMonitor
+		err     error
+		wantErr error
+	}{
+		{"missing", nil, ErrChannelMonitorNotFound, ErrChannelMonitorNotFound},
+		{"nil monitor", nil, nil, ErrChannelMonitorNotFound},
+		{"disabled", &ChannelMonitor{ID: 7, PrimaryModel: "model-current"}, nil, ErrChannelMonitorNotFound},
+		{"wrong ID", &ChannelMonitor{ID: 8, Enabled: true, PrimaryModel: "model-current"}, nil, ErrChannelMonitorNotFound},
+		{"empty model", &ChannelMonitor{ID: 7, Enabled: true}, nil, ErrChannelMonitorNotFound},
+		{"blank model", &ChannelMonitor{ID: 7, Enabled: true, PrimaryModel: " \t"}, nil, ErrChannelMonitorNotFound},
+		{"repository error", nil, unavailable, unavailable},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := &modelTraceMetadataRepo{monitor: tc.monitor, err: tc.err}
+			metadata, err := NewChannelMonitorService(repo, nil).GetModelTraceMetadata(context.Background(), 7)
+			require.ErrorIs(t, err, tc.wantErr)
+			require.Nil(t, metadata)
+			require.Equal(t, []int64{7}, repo.ids)
+		})
+	}
+}
+
+func TestModelTraceMetadataInvalidIDAndUnconfiguredService(t *testing.T) {
+	repo := &modelTraceMetadataRepo{}
+	for _, id := range []int64{0, -1} {
+		metadata, err := NewChannelMonitorService(repo, nil).GetModelTraceMetadata(context.Background(), id)
+		require.ErrorIs(t, err, ErrChannelMonitorNotFound)
+		require.Nil(t, metadata)
+	}
+	require.Empty(t, repo.ids)
+	for _, svc := range []*ChannelMonitorService{nil, NewChannelMonitorService(nil, nil)} {
+		metadata, err := svc.GetModelTraceMetadata(context.Background(), 7)
+		require.ErrorIs(t, err, ErrChannelMonitorNotFound)
+		require.Nil(t, metadata)
+	}
+}
