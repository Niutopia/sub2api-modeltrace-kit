+func TestModelTraceRunAdminPreflightsSnapshotBeforeRun(t *testing.T) {
+	for _, tc := range []struct {
+		name, messageCode string
+		sidecar, want     int
+	}{
+		{name: "accepted", sidecar: 202, want: 202},
+		{name: "model mismatch", sidecar: 409, want: 409, messageCode: "expected_model_mismatch"},
+		{name: "duplicate", sidecar: 409, want: 429, messageCode: "duplicate"},
+		{name: "cooldown", sidecar: 429, want: 429},
+		{name: "expected model required", sidecar: 400, want: 503, messageCode: "expected_model_required"},
+		{name: "unavailable", sidecar: 503, want: 503},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var gets, posts atomic.Int64
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("Authorization") != "Bearer test-secret" {
+					t.Error("preflight and run must both authenticate to the sidecar")
+				}
+				switch {
+				case r.Method == http.MethodGet && r.URL.Path == "/v1/monitors/5":
+					gets.Add(1)
+					if posts.Load() != 0 {
+						t.Error("preflight must precede run")
+					}
+					_, _ = w.Write([]byte(`{"monitor_id":5,"model":"model-current"}`))
+				case r.Method == http.MethodPost && r.URL.Path == "/v1/monitors/5/run":
+					posts.Add(1)
+					if gets.Load() != 1 {
+						t.Error("run requires exactly one successful snapshot preflight")
+					}
+					var payload map[string]any
+					if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+						t.Errorf("decode run payload: %v", err)
+					}
+					if got := payload["expected_model"]; got != "model-current" {
+						t.Errorf("expected_model = %#v, want model-current", got)
+					}
+					if len(payload) != 1 {
+						t.Errorf("run payload fields = %d, want exactly 1", len(payload))
+					}
+					w.WriteHeader(tc.sidecar)
+					if tc.messageCode != "" {
+						_, _ = w.Write([]byte(`{"message_code":"` + tc.messageCode + `"}`))
+					} else {
+						_, _ = w.Write([]byte(`{"private":"test-secret"}`))
+					}
+				default:
+					t.Error("unexpected sidecar request")
+					w.WriteHeader(http.StatusNotFound)
+				}
+			}))
+			defer srv.Close()
+			t.Setenv("MODELTRACE_INTERNAL_URL", srv.URL)
+			t.Setenv("MODELTRACE_SECRET", "test-secret")
+			repo := newModelTraceHandlerRepo()
+			h := NewChannelMonitorUserHandler(service.NewChannelMonitorService(repo, nil), nil)
+			w := modelTraceHandlerRequest(h, http.MethodPost, "5")
+			require.Equal(t, tc.want, w.Code)
+			if tc.messageCode == "expected_model_mismatch" {
+				require.Contains(t, w.Body.String(), `"reason":"MODELTRACE_MODEL_MISMATCH"`)
+				require.NotContains(t, w.Body.String(), "检测已排队")
+			}
+			if tc.messageCode == "duplicate" {
+				require.NotContains(t, w.Body.String(), "MODELTRACE_MODEL_MISMATCH")
+				require.Contains(t, w.Body.String(), "检测已排队")
+			}
+			require.NotContains(t, w.Body.String(), "test-secret")
+			require.Equal(t, int64(1), gets.Load())
+			require.Equal(t, int64(1), posts.Load())
+			require.Equal(t, 2, repo.reads)
+			require.Zero(t, repo.latestReads)
+			require.Empty(t, repo.availabilityWindows)
+		})
+	}
