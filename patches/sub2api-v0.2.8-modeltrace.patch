+  }
+})
+
+const conclusionProbability = computed(() => {
+  if (currentSnapshot.value?.stale) return ''
+  if (scoredLatest.value && isProbability(scoredLatest.value.target_probability)) {
+    return percent(scoredLatest.value.target_probability)
+  }
+  return ''
+})
+
+const betterAlternativeModel = computed(() => {
+  if (currentSnapshot.value?.stale) return ''
+  const round = scoredLatest.value
+  if (!round || !round.best_model) return ''
+  if (round.best_model !== props.model) {
+    return round.best_model
+  }
+  return ''
+})
+
+const bestCandidateProbability = computed(() => {
+  const round = scoredLatest.value
+  const topCandidate = Array.isArray(round?.ranking) ? round.ranking[0] : undefined
+  return topCandidate && topCandidate.model === round?.best_model && isProbability(topCandidate.probability)
+    ? topCandidate.probability
+    : null
+})
+
+const failureReasonShort = computed(() => {
+  if (monitorStatus.value !== 'error' && latest.value?.status !== 'error') return ''
+  const code = latest.value?.message_code
+  if (code && Object.prototype.hasOwnProperty.call(SHORT_MESSAGE_LABELS, code)) {
+    return SHORT_MESSAGE_LABELS[code]
+  }
+  if (code && Object.prototype.hasOwnProperty.call(MESSAGE_LABELS, code)) {
+    return MESSAGE_LABELS[code].split('，')[0].split('：')[0].split('。')[0]
+  }
+  return ''
+})
+
+const retestProgressText = computed(() => {
+  if (!currentSnapshot.value?.supported) return ''
+  const progress = currentSnapshot.value.retest_progress
