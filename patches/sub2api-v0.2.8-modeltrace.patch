@@ -0,0 +1,527 @@
+package service
+
+import (
+	"context"
+	"crypto/subtle"
+	"database/sql"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/lib/pq"
+)
+
+const (
+	ModelTraceRateLimitReason = "modeltrace_suspect"
+)
+
+// ModelTracePausedModel represents a model paused by modeltrace on an account.
+type ModelTracePausedModel struct {
+	Model string `json:"model"`
+	Until string `json:"until"`
+}
+
+// ModelTracePauseResult represents the outcome of pausing a model on an account.
+type ModelTracePauseResult struct {
+	Paused  bool   `json:"paused"`
+	Until   string `json:"until"`
+	Changed bool   `json:"changed"`
+}
+
+// ModelTraceResumeResult represents the outcome of resuming a model on an account.
+type ModelTraceResumeResult struct {
+	Resumed bool `json:"resumed"`
+}
+
+type modelRateLimitScopeClearer interface {
+	ClearModelRateLimitScopeIfReason(ctx context.Context, id int64, scope, reason string) (bool, error)
+}
+
+// modelRateLimitPreserver sets a model limit without discarding a still-active
+// limit that another component (e.g. an upstream 403/404 cooldown) placed there.
+type modelRateLimitPreserver interface {
+	SetModelRateLimitPreservingOther(ctx context.Context, id int64, scope string, resetAt time.Time, reason string) error
+}
+
+// ModelTraceAccountActivity represents the detection candidate account returned to ModelTrace.
+type ModelTraceAccountActivity struct {
+	AccountID   int64  `json:"account_id"`
+	Name        string `json:"name"`
+	Platform    string `json:"platform"`
+	Type        string `json:"type"`
+	Schedulable bool   `json:"schedulable"`
+	// InactiveReason is only set for accounts returned via include_inactive:
+	// they still exist on the host but are not in the scheduling pool.
+	InactiveReason    string                  `json:"inactive_reason,omitempty"`
+	Models            []string                `json:"models"`
+	PausedModels      []ModelTracePausedModel `json:"paused_models"`
+	ClusterID         *string                 `json:"cluster_id"`
+	ClusterName       *string                 `json:"cluster_name"`
+	RealModels10m     []string                `json:"real_models_10m"`
+	LastRealRequestAt *time.Time              `json:"last_real_request_at"`
+	LastRealModel     *string                 `json:"last_real_model"`
+	RealRequests10m   int64                   `json:"real_requests_10m"`
+}
+
+// ModelTraceAccountsResponse represents the JSON response for GET /api/v1/internal/modeltrace/accounts.
+type ModelTraceAccountsResponse struct {
+	GeneratedAt time.Time                   `json:"generated_at"`
+	Accounts    []ModelTraceAccountActivity `json:"accounts"`
+}
+
+// VerifyModelTraceSecret performs constant-time comparison of the provided token against MODELTRACE_SECRET.
+func VerifyModelTraceSecret(token string) bool {
+	secret := os.Getenv("MODELTRACE_SECRET")
+	if strings.TrimSpace(secret) == "" || strings.TrimSpace(token) == "" {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(token), []byte(secret)) == 1
+}
+
+// ParseModelTraceExcludeKeyIDs parses MODELTRACE_ACTIVITY_EXCLUDE_KEY_IDS from environment.
+func ParseModelTraceExcludeKeyIDs() []int64 {
+	raw := strings.TrimSpace(os.Getenv("MODELTRACE_ACTIVITY_EXCLUDE_KEY_IDS"))
+	if raw == "" {
+		return nil
+	}
+	parts := strings.Split(raw, ",")
+	res := make([]int64, 0, len(parts))
+	for _, p := range parts {
+		p = strings.TrimSpace(p)
+		if p == "" {
+			continue
+		}
+		if id, err := strconv.ParseInt(p, 10, 64); err == nil && id > 0 {
+			res = append(res, id)
+		}
+	}
+	return res
+}
+
+// ModelTraceAccountsService provides accounts and activity statistics for ModelTrace.
+type ModelTraceAccountsService struct {
+	accountRepo AccountRepository
+	sqlDB       *sql.DB
+}
+
+// NewModelTraceAccountsService creates a new ModelTraceAccountsService.
+func NewModelTraceAccountsService(accountRepo AccountRepository, sqlDB *sql.DB) *ModelTraceAccountsService {
+	return &ModelTraceAccountsService{
+		accountRepo: accountRepo,
+		sqlDB:       sqlDB,
+	}
+}
+
+type accountActivityStats struct {
+	requests10m       int64
+	realModels10m     []string
+	lastRealRequestAt *time.Time
+	lastRealModel     *string
+}
+
+// GetSchedulableAccounts returns accounts matching query models and their real activity stats.
+func (s *ModelTraceAccountsService) GetSchedulableAccounts(ctx context.Context, requestedModels []string) (*ModelTraceAccountsResponse, error) {
+	return s.GetAccounts(ctx, requestedModels, false)
+}
+
+// modelTraceInactiveReason mirrors the StatusActive list filter: an empty
+// result means the account is in the scheduling pool the detector may probe.
+func modelTraceInactiveReason(acc *Account, now time.Time) string {
+	switch {
+	case acc.Status != StatusActive:
+		if acc.Status == StatusError {
+			return "error"
+		}
+		return "disabled"
+	case !acc.Schedulable:
+		return "unschedulable"
+	case acc.RateLimitResetAt != nil && now.Before(*acc.RateLimitResetAt):
+		return "rate_limited"
+	case acc.TempUnschedulableUntil != nil && now.Before(*acc.TempUnschedulableUntil):
+		return "temp_unschedulable"
+	}
+	return ""
+}
+
+// GetAccounts returns matching accounts. With includeInactive, accounts that
+// exist but are outside the scheduling pool are returned too, marked
+// schedulable=false with a reason, so the detector can keep showing their
+// last result instead of forgetting them. Old detectors never ask for them.
+func (s *ModelTraceAccountsService) GetAccounts(ctx context.Context, requestedModels []string, includeInactive bool) (*ModelTraceAccountsResponse, error) {
+	now := time.Now()
+	resp := &ModelTraceAccountsResponse{
+		GeneratedAt: now,
+		Accounts:    []ModelTraceAccountActivity{},
+	}
+
+	// 1. Query active accounts (deleted_at is nil, status = 'active'), or every
+	// non-deleted account when inactive ones are requested.
+	statusFilter := StatusActive
+	if includeInactive {
+		statusFilter = ""
+	}
+	accounts, err := s.accountRepo.ListAllWithFilters(ctx, "", "", statusFilter, "", 0, "")
+	if err != nil {
+		return nil, err
+	}
+	if len(accounts) == 0 {
+		return resp, nil
+	}
+
+	// Filter accounts with models intersection
+	type matchedAccount struct {
+		account *Account
+		models  []string
+	}
+	var matched []matchedAccount
+	var matchedIDs []int64
+
+	for i := range accounts {
+		acc := &accounts[i]
+		if acc.Platform != PlatformOpenAI {
+			continue
+		}
+		var accModels []string
+		for _, m := range requestedModels {
+			m = strings.TrimSpace(m)
+			if m != "" && acc.IsModelSupported(m) {
+				accModels = append(accModels, m)
+			}
+		}
+		if len(accModels) > 0 {
+			matched = append(matched, matchedAccount{account: acc, models: accModels})
+			matchedIDs = append(matchedIDs, acc.ID)
+		}
+	}
+
+	if len(matched) == 0 {
+		return resp, nil
+	}
+
+	// 2. Query activity stats from usage_logs for matched accounts
+	statsMap, err := s.queryActivityStats(ctx, matchedIDs, now)
+	if err != nil {
+		return nil, err
+	}
+
+	for _, item := range matched {
+		acc := item.account
+		st := statsMap[acc.ID]
+
+		var clusterID *string
+		var clusterName *string
+
+		realModels := []string{}
+		if st != nil && len(st.realModels10m) > 0 {
+			realModels = st.realModels10m
+		}
+
+		pausedModels := modelTracePausedByRequestedModel(acc, item.models, ExtractModelTracePausedModels(acc.Extra, now))
+
+		inactiveReason := ""
+		if includeInactive {
+			inactiveReason = modelTraceInactiveReason(acc, now)
+		}
+		act := ModelTraceAccountActivity{
+			AccountID:      acc.ID,
+			Name:           acc.Name,
+			Platform:       acc.Platform,
+			Type:           acc.Type,
+			Schedulable:    acc.Schedulable && inactiveReason == "",
+			InactiveReason: inactiveReason,
+			Models:         item.models,
+			PausedModels:   pausedModels,
+			ClusterID:      clusterID,
+			ClusterName:    clusterName,
+			RealModels10m:  realModels,
+		}
+		if st != nil {
+			act.RealRequests10m = st.requests10m
+			act.LastRealRequestAt = st.lastRealRequestAt
+			act.LastRealModel = st.lastRealModel
+		}
+		resp.Accounts = append(resp.Accounts, act)
+	}
+
+	return resp, nil
+}
+
+func (s *ModelTraceAccountsService) queryActivityStats(ctx context.Context, accountIDs []int64, now time.Time) (map[int64]*accountActivityStats, error) {
+	result := make(map[int64]*accountActivityStats, len(accountIDs))
+	if len(accountIDs) == 0 || s.sqlDB == nil {
+		return result, nil
+	}
+
+	excludeIDs := ParseModelTraceExcludeKeyIDs()
+	oneDayAgo := now.Add(-24 * time.Hour)
+	tenMinAgo := now.Add(-10 * time.Minute)
+
+	var query string
+	var args []any
+
+	if len(excludeIDs) > 0 {
+		query = `
+			SELECT
+				account_id,
+				COUNT(*) FILTER (WHERE created_at >= $3) as requests_10m,
+				MAX(created_at) as last_request_at,
+				(ARRAY_AGG(model ORDER BY created_at DESC))[1] as last_model
+			FROM usage_logs
+			WHERE account_id = ANY($1)
+			  AND created_at >= $2
+			  AND (api_key_id IS NULL OR NOT (api_key_id = ANY($4)))
+			GROUP BY account_id
+		`
+		args = []any{pq.Array(accountIDs), oneDayAgo, tenMinAgo, pq.Array(excludeIDs)}
+	} else {
+		query = `
+			SELECT
+				account_id,
+				COUNT(*) FILTER (WHERE created_at >= $3) as requests_10m,
+				MAX(created_at) as last_request_at,
+				(ARRAY_AGG(model ORDER BY created_at DESC))[1] as last_model
+			FROM usage_logs
+			WHERE account_id = ANY($1)
+			  AND created_at >= $2
+			GROUP BY account_id
+		`
+		args = []any{pq.Array(accountIDs), oneDayAgo, tenMinAgo}
+	}
+
+	rows, err := s.sqlDB.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = rows.Close() }()
+
+	for rows.Next() {
+		var accountID int64
+		var req10m int64
+		var lastAt sql.NullTime
+		var lastModel sql.NullString
+
+		if err := rows.Scan(&accountID, &req10m, &lastAt, &lastModel); err != nil {
+			return nil, err
+		}
+
+		st := &accountActivityStats{
+			requests10m:   req10m,
+			realModels10m: []string{},
+		}
+		if lastAt.Valid {
+			t := lastAt.Time
+			st.lastRealRequestAt = &t
+		}
+		if lastModel.Valid && lastModel.String != "" {
+			m := lastModel.String
+			st.lastRealModel = &m
+		}
+		result[accountID] = st
+	}
+
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+
+	// Query 10m models by request count descending for each account
+	var modelsQuery string
+	var modelsArgs []any
+
+	if len(excludeIDs) > 0 {
+		modelsQuery = `
+			SELECT
+				account_id,
+				model,
+				COUNT(*) as req_count
+			FROM usage_logs
+			WHERE account_id = ANY($1)
+			  AND created_at >= $2
+			  AND (api_key_id IS NULL OR NOT (api_key_id = ANY($3)))
+			GROUP BY account_id, model
+			ORDER BY account_id, req_count DESC, model ASC
+		`
+		modelsArgs = []any{pq.Array(accountIDs), tenMinAgo, pq.Array(excludeIDs)}
+	} else {
+		modelsQuery = `
+			SELECT
+				account_id,
+				model,
+				COUNT(*) as req_count
+			FROM usage_logs
+			WHERE account_id = ANY($1)
+			  AND created_at >= $2
+			GROUP BY account_id, model
+			ORDER BY account_id, req_count DESC, model ASC
+		`
+		modelsArgs = []any{pq.Array(accountIDs), tenMinAgo}
+	}
+
+	modelRows, err := s.sqlDB.QueryContext(ctx, modelsQuery, modelsArgs...)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = modelRows.Close() }()
+
+	for modelRows.Next() {
+		var accountID int64
+		var model string
+		var reqCount int64
+
+		if err := modelRows.Scan(&accountID, &model, &reqCount); err != nil {
+			return nil, err
+		}
+
+		model = strings.TrimSpace(model)
+		if model == "" {
+			continue
+		}
+
+		st, exists := result[accountID]
+		if !exists {
+			st = &accountActivityStats{
+				realModels10m: []string{},
+			}
+			result[accountID] = st
+		}
+		st.realModels10m = append(st.realModels10m, model)
+	}
+
+	return result, modelRows.Err()
+}
+
+// ExtractModelTracePausedModels extracts non-expired modeltrace paused models from account extra.
+func ExtractModelTracePausedModels(extra map[string]any, now time.Time) []ModelTracePausedModel {
+	pausedModels := make([]ModelTracePausedModel, 0)
+	if extra == nil {
+		return pausedModels
+	}
+	rawLimits, ok := extra["model_rate_limits"].(map[string]any)
+	if !ok || len(rawLimits) == 0 {
+		return pausedModels
+	}
+	for scope, val := range rawLimits {
+		entry, ok := val.(map[string]any)
+		if !ok {
+			continue
+		}
+		reason, _ := entry["reason"].(string)
+		if reason != ModelTraceRateLimitReason {
+			continue
+		}
+		resetAtRaw, _ := entry["rate_limit_reset_at"].(string)
+		if strings.TrimSpace(resetAtRaw) == "" {
+			continue
+		}
+		resetAt, err := time.Parse(time.RFC3339, resetAtRaw)
+		if err != nil || !resetAt.After(now) {
+			continue
+		}
+		pausedModels = append(pausedModels, ModelTracePausedModel{
+			Model: scope,
+			Until: resetAt.UTC().Format(time.RFC3339),
+		})
+	}
+	return pausedModels
+}
+
+// modelTracePausedByRequestedModel reports pauses under the model names ModelTrace
+// asked for: limits are stored per mapped model (scope), which may differ.
+func modelTracePausedByRequestedModel(acc *Account, requested []string, paused []ModelTracePausedModel) []ModelTracePausedModel {
+	out := make([]ModelTracePausedModel, 0, len(paused))
+	for _, p := range paused {
+		matched := false
+		for _, m := range requested {
+			if strings.TrimSpace(acc.GetMappedModel(m)) == p.Model {
+				out = append(out, ModelTracePausedModel{Model: m, Until: p.Until})
+				matched = true
+			}
+		}
+		if !matched {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// PauseModel pauses a specific model on an OpenAI account.
+func (s *ModelTraceAccountsService) PauseModel(ctx context.Context, accountID int64, model string, minutes int) (*ModelTracePauseResult, error) {
+	acc, err := s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, err
+	}
+	if acc == nil {
+		return nil, ErrAccountNotFound
+	}
+	if acc.Platform != PlatformOpenAI {
+		return nil, ErrAccountNotFound
+	}
+	if !acc.IsModelSupported(model) {
+		return nil, ErrAccountNotFound
+	}
+
+	scope := strings.TrimSpace(acc.GetMappedModel(model))
+	if scope == "" {
+		scope = strings.TrimSpace(model)
+	}
+
+	now := time.Now().UTC()
+	newResetAt := now.Add(time.Duration(minutes) * time.Minute)
+
+	if existingResetAt := acc.modelRateLimitResetAt(scope); existingResetAt != nil && existingResetAt.After(newResetAt) {
+		return &ModelTracePauseResult{
+			Paused:  true,
+			Until:   existingResetAt.UTC().Format(time.RFC3339),
+			Changed: false,
+		}, nil
+	}
+
+	if preserver, ok := s.accountRepo.(modelRateLimitPreserver); ok {
+		err = preserver.SetModelRateLimitPreservingOther(ctx, accountID, scope, newResetAt, ModelTraceRateLimitReason)
+	} else {
+		err = s.accountRepo.SetModelRateLimit(ctx, accountID, scope, newResetAt, ModelTraceRateLimitReason)
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	return &ModelTracePauseResult{
+		Paused:  true,
+		Until:   newResetAt.Format(time.RFC3339),
+		Changed: true,
+	}, nil
+}
+
+// ResumeModel resumes a specific model on an OpenAI account if paused by modeltrace.
+func (s *ModelTraceAccountsService) ResumeModel(ctx context.Context, accountID int64, model string) (*ModelTraceResumeResult, error) {
+	acc, err := s.accountRepo.GetByID(ctx, accountID)
+	if err != nil {
+		return nil, err
+	}
+	if acc == nil {
+		return nil, ErrAccountNotFound
+	}
+	if acc.Platform != PlatformOpenAI {
+		return nil, ErrAccountNotFound
+	}
+	if !acc.IsModelSupported(model) {
+		return nil, ErrAccountNotFound
+	}
+
+	scope := strings.TrimSpace(acc.GetMappedModel(model))
+	if scope == "" {
+		scope = strings.TrimSpace(model)
+	}
+
+	clearer, ok := s.accountRepo.(modelRateLimitScopeClearer)
+	if !ok {
+		return &ModelTraceResumeResult{Resumed: false}, nil
+	}
+
+	cleared, err := clearer.ClearModelRateLimitScopeIfReason(ctx, accountID, scope, ModelTraceRateLimitReason)
+	if err != nil {
+		return nil, err
+	}
+
+	return &ModelTraceResumeResult{Resumed: cleared}, nil
+}
