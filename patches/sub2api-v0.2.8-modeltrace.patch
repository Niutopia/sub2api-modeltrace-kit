@@ -0,0 +1,30 @@
+package service
+
+import (
+	"context"
+	"strings"
+)
+
+// ChannelMonitorModelTraceMetadata contains only the fields needed to bind a
+// sidecar snapshot to a visible monitor. Never expose the full monitor or keys.
+type ChannelMonitorModelTraceMetadata struct {
+	ID           int64  `json:"id"`
+	PrimaryModel string `json:"primary_model"`
+}
+
+// GetModelTraceMetadata preserves GetUserDetail's enabled-only visibility with
+// one configuration read: no credential decryption, history, or health aggregates.
+// Feature/mode and viewer permissions remain enforced by the handler and routes.
+func (s *ChannelMonitorService) GetModelTraceMetadata(ctx context.Context, id int64) (*ChannelMonitorModelTraceMetadata, error) {
+	if s == nil || s.repo == nil || id <= 0 {
+		return nil, ErrChannelMonitorNotFound
+	}
+	m, err := s.repo.GetByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if m == nil || m.ID != id || !m.Enabled || strings.TrimSpace(m.PrimaryModel) == "" {
+		return nil, ErrChannelMonitorNotFound
+	}
+	return &ChannelMonitorModelTraceMetadata{ID: m.ID, PrimaryModel: m.PrimaryModel}, nil
+}
