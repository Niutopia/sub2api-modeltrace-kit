+	require.False(t, cleared)
+
+	cleared, err = repo.ClearModelRateLimitScopeIfReason(context.Background(), 123, "gpt-5.6-sol", "   ")
+	require.NoError(t, err)
+	require.False(t, cleared)
+
+	require.NoError(t, mock.ExpectationsWereMet())
+}
