+func TestOpenAIModelTraceProbeAuthentication(t *testing.T) {
+	t.Setenv("MODELTRACE_SECRET", "offline-secret")
+	t.Setenv(openAIModelTraceProbeTimeoutEnv, "")
+	for _, tt := range []struct {
+		name    string
+		change  func(*gin.Context)
+		trusted bool
+	}{
+		{name: "valid admin", trusted: true},
+		{name: "ordinary UA signed", change: func(c *gin.Context) {
+			c.Request.Header.Set("User-Agent", "curl/8")
+			c.Request.Header.Set(openAIModelTraceProbeSignatureHeader, modelTraceProbeTestSignature("offline-secret", "curl/8"))
+		}},
+		{name: "forged", change: func(c *gin.Context) {
+			c.Request.Header.Set(openAIModelTraceProbeSignatureHeader, strings.Repeat("0", 64))
+		}},
+		{name: "wrong secret", change: func(c *gin.Context) {
+			c.Request.Header.Set(openAIModelTraceProbeSignatureHeader, modelTraceProbeTestSignature("wrong", modelTraceProbeTestUA))
+		}},
+		{name: "missing signature", change: func(c *gin.Context) { c.Request.Header.Del(openAIModelTraceProbeSignatureHeader) }},
+		{name: "invalid hex", change: func(c *gin.Context) {
+			c.Request.Header.Set(openAIModelTraceProbeSignatureHeader, strings.Repeat("z", 64))
+		}},
+		{name: "short signature", change: func(c *gin.Context) { c.Request.Header.Set(openAIModelTraceProbeSignatureHeader, "aa") }},
+		{name: "duplicate signature", change: func(c *gin.Context) {
+			c.Request.Header.Add(openAIModelTraceProbeSignatureHeader, modelTraceProbeTestSignature("offline-secret", modelTraceProbeTestUA))
+		}},
+		{name: "mixed case duplicate signature", change: func(c *gin.Context) {
+			c.Request.Header[strings.ToLower(openAIModelTraceProbeSignatureHeader)] = []string{"fake"}
+		}},
+		{name: "duplicate UA", change: func(c *gin.Context) { c.Request.Header.Add("User-Agent", modelTraceProbeTestUA) }},
+		{name: "non admin", change: func(c *gin.Context) { c.Set("api_key", &APIKey{User: &User{Role: RoleUser}}) }},
+		{name: "missing user", change: func(c *gin.Context) { c.Set("api_key", &APIKey{}) }},
+		{name: "missing key", change: func(c *gin.Context) { c.Set("api_key", nil) }},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			body := []byte(`{"input":"offline prompt remains unchanged","max_output_tokens":2048}`)
+			c := modelTraceProbeTestContext(body)
+			if tt.change != nil {
+				tt.change(c)
+			}
+			parent, cancelParent := context.WithCancel(context.Background())
+			defer cancelParent()
+			start := time.Now()
+			ctx, cancel := openAIModelTraceProbeContext(parent, c)
+			defer cancel()
+			require.Equal(t, tt.trusted, isTrustedOpenAIModelTraceProbeContext(ctx))
+			requireModelTraceHeaderAbsent(t, c.Request.Header)
+			got, err := io.ReadAll(c.Request.Body)
+			require.NoError(t, err)
+			require.Equal(t, body, got)
+			deadline, bounded := ctx.Deadline()
+			require.Equal(t, tt.trusted, bounded)
+			if tt.trusted {
+				require.WithinDuration(t, start.Add(120*time.Second), deadline, time.Second)
+			} else {
+				require.Equal(t, parent, ctx)
+			}
+			upstream, release := detachUpstreamContext(ctx)
+			release() // Existing callers release immediately, before Do: must remain a noop.
+			require.NoError(t, upstream.Err())
+			cancelParent()
+			if tt.trusted {
+				require.ErrorIs(t, upstream.Err(), context.Canceled)
+			} else {
+				require.NoError(t, upstream.Err())
+			}
+		})
+	}
+}
