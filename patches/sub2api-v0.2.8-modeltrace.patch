+package modeltrace
+
+// AccountsSummary represents the aggregated account consistency counts for a monitor model.
+// Privacy contract: it only contains counts and the model identifier; no account names, IDs, or credentials.
+type AccountsSummary struct {
+	Model     string `json:"model"`
+	Total     int    `json:"total"`
+	Match     int    `json:"match"`
+	Suspect   int    `json:"suspect"`
+	Uncertain int    `json:"uncertain"`
+	Error     int    `json:"error"`
+	Active    int    `json:"active"`
+}
diff --git a/backend/internal/pkg/modeltrace/client.go b/backend/internal/pkg/modeltrace/client.go
new file mode 100644
index 000000000..2720a403e
--- /dev/null
+++ b/backend/internal/pkg/modeltrace/client.go
@@ -0,0 +1,230 @@
+// Package modeltrace exposes a bounded, authenticated private sidecar bridge.
+// It never accepts a caller-provided upstream URL or credentials.
+package modeltrace
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+)
+
+type RetestProgress struct {
+	Done  int `json:"done"`
+	Total int `json:"total"`
+}
+
+type Candidate struct {
+	Model       string  `json:"model"`
+	Probability float64 `json:"probability"`
+}
+type Round struct {
+	ID                int64       `json:"id"`
+	Status            string      `json:"status"`
+	TargetProbability *float64    `json:"target_probability"`
+	BestModel         *string     `json:"best_model"`
+	CheckedAt         string      `json:"checked_at"`
+	MessageCode       string      `json:"message_code"`
+	Ranking           []Candidate `json:"ranking"`
+}
+type Snapshot struct {
+	MonitorID            int64            `json:"monitor_id"`
+	Model                string           `json:"model"`
+	ScopeLabel           string           `json:"scope_label"`
+	Enabled              bool             `json:"enabled"`
+	Supported            bool             `json:"supported"`
+	Running              bool             `json:"running"`
+	Queued               bool             `json:"queued"`
+	ScheduleMode         string           `json:"schedule_mode"`
+	SnapshotAt           string           `json:"snapshot_at"`
+	QueuedAt             *string          `json:"queued_at"`
+	AvailableAt          *string          `json:"available_at"`
+	StartedAt            *string          `json:"started_at"`
+	IntervalSeconds      int              `json:"interval_seconds"`
+	LastCheckedAt        *string          `json:"last_checked_at"`
+	NextRunAt            *string          `json:"next_run_at"`
+	Stale                bool             `json:"stale"`
+	PausedBudget         bool             `json:"paused_budget"`
+	PausedReconciliation bool             `json:"paused_reconciliation"`
+	NextRunAfter         *string          `json:"next_run_after"`
+	Latest               *Round           `json:"latest"`
+	History              []Round          `json:"history"`
+	Protocol             string           `json:"protocol"`
+	ReasoningEffort      string           `json:"reasoning_effort"`
+	RetestProgress       *RetestProgress  `json:"retest_progress"`
+	ServiceTier          string           `json:"service_tier"`
+	AccountsSummary      *AccountsSummary `json:"accounts_summary,omitempty"`
+}
+
+var ErrUnavailable = errors.New("model consistency service unavailable")
+var ErrBusy = errors.New("model consistency check already queued or cooling down")
+var ErrModelMismatch = errors.New("model consistency snapshot does not match current monitor model")
+
+const (
+	modelTraceDockerServiceHost = "sub2api-modeltrace"
+	modelTraceDockerCompatHost  = "modeltrace"
+	modelTraceDockerServicePort = "8081"
+	// The Run contract is intentionally tiny: only expected_model is sent.
+	// Keep the bound small so this bridge can never become a generic POST proxy.
+	maxModelTraceRunBodyBytes = 256
+)
+
+type modelTraceRunRequest struct {
+	ExpectedModel string `json:"expected_model"`
+}
+
+func isAllowedInternalURL(u *url.URL) bool {
+	if u == nil || u.Host == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+		return false
+	}
+	if u.Scheme != "http" && u.Scheme != "https" {
+		return false
+	}
+	// MODELTRACE_INTERNAL_URL is a base URL, not a proxy target. A trailing
+	// slash is harmless and is already removed by call; any other path would
+	// make the bridge's fixed endpoint ambiguous.
+	if u.Path != "" && u.Path != "/" || u.RawPath != "" {
+		return false
+	}
+
+	host := strings.ToLower(u.Hostname())
+	if host == "localhost" {
+		return true
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		return ip.IsLoopback()
+	}
+	// The production sidecar is reached over the private Docker network. Do
+	// not permit arbitrary DNS names, even when they use HTTPS.
+	return (host == modelTraceDockerServiceHost || host == modelTraceDockerCompatHost) && u.Port() == modelTraceDockerServicePort
+}
+
+func call(ctx context.Context, method string, id int64, dst any, body []byte) error {
+	base := strings.TrimRight(os.Getenv("MODELTRACE_INTERNAL_URL"), "/")
+	secret := os.Getenv("MODELTRACE_SECRET")
+	u, err := url.Parse(base)
+	if err != nil || !isAllowedInternalURL(u) || secret == "" || id <= 0 {
+		return ErrUnavailable
+	}
+	if method == http.MethodPost {
+		if len(body) == 0 || len(body) > maxModelTraceRunBodyBytes {
+			return ErrUnavailable
+		}
+	} else if len(body) != 0 {
+		return ErrUnavailable
+	}
+	path := fmt.Sprintf("%s/v1/monitors/%d", base, id)
+	if method == http.MethodPost {
+		path += "/run"
+	}
+	var requestBody io.Reader
+	if len(body) > 0 {
+		requestBody = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, path, requestBody)
+	if err != nil {
+		return ErrUnavailable
+	}
+	req.Header.Set("Authorization", "Bearer "+secret)
+	if len(body) > 0 {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	client := &http.Client{Timeout: 4 * time.Second, CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }}
+	res, err := client.Do(req)
+	if err != nil {
+		return ErrUnavailable
+	}
+	defer res.Body.Close()
+	responseBody, err := io.ReadAll(io.LimitReader(res.Body, 262145))
+	if err != nil || len(responseBody) > 262144 {
+		return ErrUnavailable
+	}
+	switch res.StatusCode {
+	case http.StatusConflict:
+		if method != http.MethodPost {
+			return ErrUnavailable
+		}
+		switch modelTraceMessageCode(responseBody) {
+		case "expected_model_mismatch", "model_mismatch":
+			return ErrModelMismatch
+		case "duplicate":
+			return ErrBusy
+		default:
+			// Never guess from the status alone: the sidecar also uses 409
+			// for duplicate queue requests.
+			return ErrUnavailable
+		}
+	case http.StatusTooManyRequests:
+		return ErrBusy
+	}
+	if res.StatusCode < 200 || res.StatusCode >= 300 {
+		return ErrUnavailable
+	}
+	if dst != nil {
+		if json.Unmarshal(responseBody, dst) != nil {
+			return ErrUnavailable
+		}
+		// Drop private fields first, then fail closed if an allowed field echoes
+		// the bridge credential. Compare JSON-escaped text to cover escapes too.
+		public, err := json.Marshal(dst)
+		encodedSecret, _ := json.Marshal(secret)
+		if err != nil || bytes.Contains(public, encodedSecret[1:len(encodedSecret)-1]) {
+			return ErrUnavailable
+		}
+	}
+	return nil
+}
+
+func modelTraceMessageCode(body []byte) string {
+	var payload struct {
+		MessageCode string `json:"message_code"`
+	}
+	if json.Unmarshal(body, &payload) != nil {
+		return ""
+	}
+	return strings.TrimSpace(payload.MessageCode)
+}
+
+// Get binds a public snapshot to the monitor's current primary model, not a
+// caller-supplied model or the sidecar's potentially stale configuration.
+func Get(ctx context.Context, id int64, primaryModel string) (*Snapshot, error) {
+	if strings.TrimSpace(primaryModel) == "" {
+		return nil, ErrUnavailable
+	}
+	var s Snapshot
+	if err := call(ctx, http.MethodGet, id, &s, nil); err != nil {
+		return nil, err
+	}
+	if s.MonitorID != id || len(s.History) > 16 {
+		return nil, ErrUnavailable
+	}
+	if s.Model != primaryModel {
+		return nil, ErrModelMismatch
+	}
+	// Re-encode only this explicitly public schema: never forward opaque sidecar JSON.
+	return &s, nil
+}
+
+// Run asks the sidecar to re-check the exact model the main site just read.
+// The sidecar compares this field with its current monitor configuration and
+// returns 409 when the configuration changed between the GET preflight and run.
+// Rollout order is main site first, sidecar second: the old sidecar ignores the
+// extra JSON body, while the new sidecar rejects old clients that omit it.
+func Run(ctx context.Context, id int64, expectedModel string) error {
+	if strings.TrimSpace(expectedModel) == "" {
+		return ErrUnavailable
+	}
+	body, err := json.Marshal(modelTraceRunRequest{ExpectedModel: expectedModel})
+	if err != nil || len(body) > maxModelTraceRunBodyBytes {
+		return ErrUnavailable
+	}
+	return call(ctx, http.MethodPost, id, nil, body)
+}
diff --git a/backend/internal/pkg/modeltrace/client_accounts_test.go b/backend/internal/pkg/modeltrace/client_accounts_test.go
