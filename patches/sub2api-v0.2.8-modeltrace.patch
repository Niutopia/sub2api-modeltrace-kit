+  if (!currentSnapshot.value?.supported) return '未接入'
+  if (isEffectivelyRunning.value) return '本轮结束后更新'
+  if (isEffectivelyQueued.value) return shortTime(currentSnapshot.value.available_at ?? currentSnapshot.value.next_run_at)
+  if (isManualSchedule.value) return '手动触发'
+  if (currentSnapshot.value.paused_budget || currentSnapshot.value.paused_reconciliation) return '暂停调度'
+  return remoteSnapshot.value.enabled ? (remoteSnapshot.value.next_run_at ? shortTime(remoteSnapshot.value.next_run_at) : '暂无计划') : '未启用定时'
+})
+
+function shortTime(value: string | null | undefined): string {
+  if (!value) return '—'
+  const date = new Date(value)
+  if (!Number.isFinite(date.getTime())) return '—'
+  const hm = date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false })
+  const now = new Date()
+  const sameDay = date.getFullYear() === now.getFullYear() && date.getMonth() === now.getMonth() && date.getDate() === now.getDate()
+  return sameDay ? hm : `${date.getMonth() + 1}/${date.getDate()} ${hm}`
+}
+
+const nextRunLabel = computed(() => {
+  return nextRunShort.value
+})
+
+const detailMessage = computed(() => {
+  const code = latest.value?.message_code
+  return code && Object.prototype.hasOwnProperty.call(MESSAGE_LABELS, code) ? MESSAGE_LABELS[code] : ''
+})
+
+function isProbability(value: number | null | undefined): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= 1
+}
+
+function isScoredRound(round: TraceRound | null | undefined): round is TraceRound & { target_probability: number } {
+  return !!round && SCORED_STATUSES.has(round.status) && isProbability(round.target_probability)
+}
+
+function percent(probability: number): string {
+  return `${(probability * 100).toFixed(1)}%`
+}
+
+function formatTime(value: string | null | undefined): string {
+  if (!value) return '—'
+  const date = new Date(value)
+  return Number.isFinite(date.getTime()) ? date.toLocaleString('zh-CN', { hour12: false }) : '—'
+}
+
+
+function checkMobile() {
+  if (typeof window === 'undefined') return
+  isMobile.value = window.innerWidth < 640
+}
+
+function updatePosition() {
+  if (isMobile.value || !triggerRef.value) return
+  const rect = getLayoutRect(triggerRef.value)
+  const viewport = getLayoutViewport()
+  const popoverWidth = 320 // w-80 is 20rem = 320px
+  const viewportPadding = 12
+  const gap = 8
+
+  // 水平定位：优先右对齐触发器（因为在标题右侧），若左侧溢出则贴紧左边距
+  let left = rect.right - popoverWidth
+  if (left < viewportPadding) {
+    left = Math.max(viewportPadding, rect.left)
+  }
+  if (left + popoverWidth > viewport.width - viewportPadding) {
+    left = viewport.width - viewportPadding - popoverWidth
+  }
+
+  // 垂直定位：优先放在触发器下方，若下方空间不够（< 360px）且上方空间更大则翻到上方
+  let top = rect.bottom + gap
+  const estimatedHeight = 360
+  if (top + estimatedHeight > viewport.height - viewportPadding && rect.top > estimatedHeight) {
+    top = rect.top - gap - estimatedHeight
+  }
+
+  popoverPositionStyle.value = {
+    top: `${Math.max(viewportPadding, top)}px`,
+    left: `${Math.max(viewportPadding, left)}px`,
+  }
+}
+
+function togglePopover() {
+  if (showPopover.value) {
+    closePopover()
+  } else {
+    openPopover()
+  }
+}
+
+function openPopover() {
+  checkMobile()
+  showPopover.value = true
+  nextTick(() => {
+    updatePosition()
+  })
+}
+
+function closePopover() {
+  showPopover.value = false
+}
+
+function handleKeydown(e: KeyboardEvent) {
+  if (e.key === 'Escape' && showPopover.value) {
+    closePopover()
+  }
+}
+
+function handleResize() {
+  checkMobile()
+  if (showPopover.value) {
+    updatePosition()
+  }
+}
+
+function handleScroll(e: Event) {
+  if (showPopover.value && popoverRef.value && e.target instanceof Node && popoverRef.value.contains(e.target)) {
+    return
+  }
+  if (showPopover.value && !isMobile.value) {
+    closePopover()
+  }
+}
+
+function startElapsedTimer() {
+  if (elapsedTimer !== undefined) return
+  elapsedTimer = setInterval(() => {
+    nowTick.value = Date.now()
+  }, 1000)
+}
+
+function stopElapsedTimer() {
+  if (elapsedTimer !== undefined) {
+    clearInterval(elapsedTimer)
+    elapsedTimer = undefined
+  }
+}
+
+watch([isEffectivelyQueued, isEffectivelyRunning], ([q, r]) => {
+  if (q || r) {
+    startElapsedTimer()
+  } else {
+    stopElapsedTimer()
+  }
+}, { immediate: true })
+
+onMounted(() => {
+  checkMobile()
+  window.addEventListener('keydown', handleKeydown)
+  window.addEventListener('resize', handleResize)
+  window.addEventListener('scroll', handleScroll, true)
+})
+
+onBeforeUnmount(() => {
+  disposed = true
+  stopElapsedTimer()
+  runController?.abort()
+  window.removeEventListener('keydown', handleKeydown)
+  window.removeEventListener('resize', handleResize)
+  window.removeEventListener('scroll', handleScroll, true)
+})
+
+function isCurrentRun(controller: AbortController): boolean {
+  return !disposed && !controller.signal.aborted && runController === controller
+}
+
+async function run(): Promise<void> {
+  if (!auth.isAdmin || !canRun.value) return
+  const controller = new AbortController()
+  runController?.abort()
+  runController = controller
+  submitting.value = true
+  actionMessage.value = ''
+
+  // 立即切换为“排队中”（乐观状态）
+  localOptimisticQueued.value = true
+  localOptimisticStartTime.value = Date.now()
+  nowTick.value = Date.now()
+  emit('runSubmitted', props.monitorId)
+
+  try {
+    await runModelTrace(props.monitorId, controller.signal)
+    if (!isCurrentRun(controller)) return
+    actionMessage.value = '已提交，后台串行检测，不影响正常调用。'
+    emit('refresh')
+  } catch {
+    if (!isCurrentRun(controller)) return
+    // 请求失败则回退并显示错误
+    localOptimisticQueued.value = false
+    localOptimisticStartTime.value = null
+    emit('runFailed', props.monitorId)
+    actionMessage.value = '未能提交：检测可能已排队、正在冷却或服务暂不可用。'
+  } finally {
+    if (runController === controller) {
+      runController = undefined
+      submitting.value = false
+    }
+  }
+}
+
+watch(() => [props.snapshot, props.running, props.queued], () => {
+  if (props.running || props.queued || currentSnapshot.value?.running || currentSnapshot.value?.queued) {
+    localOptimisticQueued.value = false
+  } else if (!submitting.value && currentSnapshot.value?.queued === false) {
+    localOptimisticQueued.value = false
+    localOptimisticStartTime.value = null
+  }
+})
+
+watch(() => props.snapshot?.latest?.checked_at, () => {
+  if (!props.running && !props.queued) {
+    localOptimisticQueued.value = false
+    localOptimisticStartTime.value = null
+  }
+})
+
+watch(() => [props.monitorId, props.model], () => {
+  runController?.abort()
+  runController = undefined
+  submitting.value = false
+  localOptimisticQueued.value = false
+  localOptimisticStartTime.value = null
+  actionMessage.value = ''
+}, { flush: 'sync' })
+</script>
