+	// 3. resume 成功
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/accounts/1/model-resume", strings.NewReader(`{"model":"gpt-5.6-sol"}`))
+	req.Header.Set("Authorization", "Bearer secret")
