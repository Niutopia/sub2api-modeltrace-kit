@@ -0,0 +1,441 @@
+import { onBeforeUnmount, onMounted, reactive, watch, type Ref } from 'vue'
+import { getModelTrace, isOlderTraceSnapshot, type TraceSnapshot } from '@/api/modelTrace'
+
+/** ModelTrace is hour-level data; normal refresh is 5 minutes. */
+export const MODEL_TRACE_POLL_INTERVAL_MS = 5 * 60 * 1000
+export const MODEL_TRACE_HIGH_FREQ_INTERVAL_MS = 3 * 1000
+export const MODEL_TRACE_DEGRADED_INTERVAL_MS = 15 * 1000
+export const MODEL_TRACE_DEGRADED_AFTER_MS = 10 * 60 * 1000
+
+export interface ModelTracePollTarget {
+  id: number
+  model: string
+}
+
+export interface ModelTraceActiveRun {
+  queuedAt: number
+  runningAt?: number
+  baselineCheckedAt?: string | null
+}
+
+export interface ModelTraceState {
+  snapshot: TraceSnapshot | null
+  loading: boolean
+  unavailable: boolean
+  mappingMismatch: boolean
+  queued: boolean
+  running: boolean
+  queuedAt: number | null
+  runningAt: number | null
+}
+
+export interface UseModelTracePollingResult {
+  states: ReadonlyMap<number, ModelTraceState>
+  stateFor: (monitorId: number) => ModelTraceState
+  refreshMonitor: (monitorId: number) => Promise<void>
+  notifyRunSubmitted: (monitorId: number) => void
+  notifyRunFailed: (monitorId: number) => void
+  start: () => void
+  stop: () => void
+}
+
+function createState(): ModelTraceState {
+  return {
+    snapshot: null,
+    loading: false,
+    unavailable: false,
+    mappingMismatch: false,
+    queued: false,
+    running: false,
+    queuedAt: null,
+    runningAt: null,
+  }
+}
+
+function isAbortError(error: unknown): boolean {
+  if (!error || typeof error !== 'object') return false
+  const value = error as { name?: string; code?: string }
+  return value.name === 'AbortError' || value.code === 'ERR_CANCELED'
+}
+
+function timestamp(value: string | null | undefined): number | undefined {
+  const parsed = value ? Date.parse(value) : NaN
+  return Number.isFinite(parsed) ? parsed : undefined
+}
+
+/**
+ * Owns one page-level ModelTrace cache and timers for all cards on the page.
+ * Fast-polls active (queued or running) monitors without disturbing normal cards.
+ */
+export function useModelTracePolling(
+  targets: Ref<readonly ModelTracePollTarget[]>,
+): UseModelTracePollingResult {
+  const states = reactive(new Map<number, ModelTraceState>())
+  const activeRuns = new Map<number, ModelTraceActiveRun>()
+  const controllers = new Map<number, AbortController>()
+  const targetModels = new Map<number, string>()
+  const snapshotWatermarks = new Map<number, string>()
+  let pollTimer: ReturnType<typeof setTimeout> | undefined
+  const activeTimers = new Map<number, ReturnType<typeof setTimeout>>()
+  let cyclePromise: Promise<void> | null = null
+  let cycleGeneration = 0
+  let targetRevision = 0
+  let enabled = false
+  let disposed = false
+
+  const isHidden = () => typeof document !== 'undefined' && document.hidden
+
+  function targetMap(): Map<number, ModelTracePollTarget> {
+    const result = new Map<number, ModelTracePollTarget>()
+    for (const target of targets.value) {
+      if (!result.has(target.id)) result.set(target.id, { id: target.id, model: target.model })
+    }
+    return result
+  }
+
+  function clearActiveTimer(monitorId: number): void {
+    const timer = activeTimers.get(monitorId)
+    if (timer !== undefined) {
+      clearTimeout(timer)
+      activeTimers.delete(monitorId)
+    }
+  }
+
+  function clearAllActiveTimers(): void {
+    for (const timer of activeTimers.values()) {
+      clearTimeout(timer)
+    }
+    activeTimers.clear()
+  }
+
+  function syncTargets(): void {
+    const current = targetMap()
+    let changed = false
+    for (const [monitorId, model] of targetModels) {
+      if (current.get(monitorId)?.model !== model) {
+        changed = true
+        controllers.get(monitorId)?.abort()
+        controllers.delete(monitorId)
+        states.delete(monitorId)
+        activeRuns.delete(monitorId)
+        clearActiveTimer(monitorId)
+        targetModels.delete(monitorId)
+        snapshotWatermarks.delete(monitorId)
+      }
+    }
+
+    for (const [monitorId, controller] of controllers) {
+      if (!current.has(monitorId)) {
+        controller.abort()
+        controllers.delete(monitorId)
+      }
+    }
+    for (const monitorId of states.keys()) {
+      if (!current.has(monitorId)) {
+        states.delete(monitorId)
+        activeRuns.delete(monitorId)
+        clearActiveTimer(monitorId)
+      }
+    }
+    for (const [monitorId, target] of current) {
+      if (!targetModels.has(monitorId)) {
+        changed = true
+        targetModels.set(monitorId, target.model)
+      }
+      if (!states.has(monitorId)) states.set(monitorId, createState())
+    }
+    if (changed) {
+      targetRevision += 1
+      // An ignored/slow abort must not block fetching the replacement target.
+      cycleGeneration += 1
+      cyclePromise = null
+    }
+  }
+
+  function clearPollTimer(): void {
+    if (pollTimer !== undefined) clearTimeout(pollTimer)
+    pollTimer = undefined
+  }
+
+  function cancelRequests(): void {
+    cycleGeneration += 1
+    cyclePromise = null
+    for (const [monitorId, controller] of controllers) {
+      controller.abort()
+      controllers.delete(monitorId)
+      const state = states.get(monitorId)
+      if (state) state.loading = false
+    }
+  }
+
+  function schedulePoll(): void {
+    clearPollTimer()
+    if (!enabled || disposed || isHidden()) return
+    pollTimer = setTimeout(() => {
+      pollTimer = undefined
+      void refreshAll()
+    }, MODEL_TRACE_POLL_INTERVAL_MS)
+  }
+
+  function scheduleActivePoll(monitorId: number): void {
+    clearActiveTimer(monitorId)
+    if (!enabled || disposed || isHidden()) return
+    const run = activeRuns.get(monitorId)
+    if (!run) return
+
+    const now = Date.now()
+    const activeStartTime = run.runningAt ?? run.queuedAt
+    const elapsed = now - activeStartTime
+    const interval = elapsed >= MODEL_TRACE_DEGRADED_AFTER_MS
+      ? MODEL_TRACE_DEGRADED_INTERVAL_MS
+      : MODEL_TRACE_HIGH_FREQ_INTERVAL_MS
+
+    const timer = setTimeout(() => {
+      activeTimers.delete(monitorId)
+      const target = targetMap().get(monitorId)
+      if (target) {
+        void refreshOne(target).then(() => {
+          if (activeRuns.has(monitorId)) {
+            scheduleActivePoll(monitorId)
+          }
+        })
+      }
+    }, interval)
+    activeTimers.set(monitorId, timer)
+  }
+
+  function updateActiveStateFromSnapshot(target: ModelTracePollTarget, snapshot: TraceSnapshot): void {
+    const state = states.get(target.id)
+    if (!state) return
+
+    let run = activeRuns.get(target.id)
+    const latestCheckedAt = snapshot.latest?.checked_at ?? null
+
+    // Job activity is authoritative even if a new historical round arrives
+    // during a multi-round retest. A result is not a job-completion signal.
+    if (snapshot.running || snapshot.queued) {
+      const now = Date.now()
+      run ??= { queuedAt: now, baselineCheckedAt: latestCheckedAt }
+      run.queuedAt = timestamp(snapshot.queued_at) ?? run.queuedAt
+      run.runningAt = snapshot.running ? (timestamp(snapshot.started_at) ?? run.runningAt ?? now) : undefined
+      activeRuns.set(target.id, run)
+      state.queued = !snapshot.running
+      state.running = snapshot.running
+      state.queuedAt = run.queuedAt
+      state.runningAt = run.runningAt ?? null
+      scheduleActivePoll(target.id)
+    } else if (run && snapshot.queued === undefined && run.runningAt === undefined
+      && latestCheckedAt === run.baselineCheckedAt) {
+      // Compatibility for old sidecars that do not expose queue state.
+      state.queued = true
+      state.running = false
+      state.queuedAt = run.queuedAt
+      state.runningAt = null
+      scheduleActivePoll(target.id)
+    } else {
+      activeRuns.delete(target.id)
+      clearActiveTimer(target.id)
+      state.queued = false
+      state.running = false
+      state.queuedAt = null
+      state.runningAt = null
+    }
+  }
+
+  async function refreshOne(target: ModelTracePollTarget): Promise<void> {
+    if (disposed || isHidden()) return
+
+    controllers.get(target.id)?.abort()
+    const controller = new AbortController()
+    controllers.set(target.id, controller)
+    const state = states.get(target.id) ?? createState()
+    states.set(target.id, state)
+    state.loading = true
+
+    try {
+      const result = await getModelTrace(target.id, controller.signal)
+      if (disposed || controller.signal.aborted || controllers.get(target.id) !== controller) return
+      // A later request can still return an older DB read view. Compare the
+      // snapshot watermark, not latest.checked_at (which can stay unchanged).
+      if (isOlderTraceSnapshot(result.snapshot_at, snapshotWatermarks.get(target.id))) return
+
+      const mismatch = result.monitor_id !== target.id || result.model !== target.model
+      state.snapshot = mismatch ? null : result
+      state.mappingMismatch = mismatch
+      state.unavailable = false
+
+      if (!mismatch) {
+        if (timestamp(result.snapshot_at) !== undefined) snapshotWatermarks.set(target.id, result.snapshot_at!)
+        updateActiveStateFromSnapshot(target, result)
+      } else {
+        activeRuns.delete(target.id)
+        clearActiveTimer(target.id)
+        state.queued = false
+        state.running = false
+        state.queuedAt = null
+        state.runningAt = null
+      }
+    } catch (error) {
+      if (disposed || controller.signal.aborted || controllers.get(target.id) !== controller) return
+      if (isAbortError(error)) return
+      const apiError = error as { status?: number; reason?: string } | null
+      state.mappingMismatch = apiError?.status === 409 && apiError.reason === 'MODELTRACE_MODEL_MISMATCH'
+      state.snapshot = null
+      state.unavailable = !state.mappingMismatch
+      activeRuns.delete(target.id)
+      clearActiveTimer(target.id)
+      state.queued = false
+      state.running = false
+      state.queuedAt = null
+      state.runningAt = null
+    } finally {
+      if (controllers.get(target.id) === controller) {
+        controllers.delete(target.id)
+        state.loading = false
+      }
+    }
+  }
+
+  async function refreshAll(): Promise<void> {
+    if (!enabled || disposed || isHidden() || cyclePromise) return
+    syncTargets()
+    const revision = targetRevision
+    const generation = ++cycleGeneration
+    const currentTargets = [...targetMap().values()]
+    const cycle = Promise.all(currentTargets.map(refreshOne)).then(() => undefined)
+    cyclePromise = cycle
+
+    try {
+      await cycle
+    } finally {
+      if (generation === cycleGeneration) {
+        cyclePromise = null
+        if (revision !== targetRevision && enabled && !disposed && !isHidden()) {
+          void refreshAll()
+        } else {
+          schedulePoll()
+        }
+      }
+    }
+  }
+
+  function stateFor(monitorId: number): ModelTraceState {
+    const existing = states.get(monitorId)
+    if (existing) return existing
+    const state = createState()
+    states.set(monitorId, state)
+    return state
+  }
+
+  async function refreshMonitor(monitorId: number): Promise<void> {
+    if (disposed || isHidden()) return
+    const target = targetMap().get(monitorId)
+    if (!target) return
+    if (controllers.has(monitorId)) {
+      cycleGeneration += 1
+      cyclePromise = null
+    }
+    await refreshOne(target)
+    if (enabled && !activeRuns.has(monitorId)) schedulePoll()
+  }
+
+  function notifyRunSubmitted(monitorId: number): void {
+    if (disposed || !targetMap().has(monitorId)) return
+    // A GET started before this mutation cannot acknowledge or finish it.
+    controllers.get(monitorId)?.abort()
+    controllers.delete(monitorId)
+    cycleGeneration += 1
+    cyclePromise = null
+    const state = states.get(monitorId) ?? createState()
+    states.set(monitorId, state)
+    state.loading = false
+    const now = Date.now()
+    const baselineCheckedAt = state.snapshot?.latest?.checked_at ?? null
+
+    activeRuns.set(monitorId, {
+      queuedAt: now,
+      baselineCheckedAt,
+    })
+    state.queued = true
+    state.running = false
+    state.queuedAt = now
+    state.runningAt = null
+
+    scheduleActivePoll(monitorId)
+  }
+
+  function notifyRunFailed(monitorId: number): void {
+    const target = targetMap().get(monitorId)
+    const snapshot = states.get(monitorId)?.snapshot
+    if (target && snapshot && (snapshot.running || snapshot.queued)) {
+      updateActiveStateFromSnapshot(target, snapshot)
+      return
+    }
+    activeRuns.delete(monitorId)
+    clearActiveTimer(monitorId)
+    const state = states.get(monitorId)
+    if (state) {
+      state.queued = false
+      state.running = false
+      state.queuedAt = null
+      state.runningAt = null
+    }
+  }
+
+  function start(): void {
+    if (disposed) return
+    enabled = true
+    syncTargets()
+    if (!isHidden()) void refreshAll()
+  }
+
+  function stop(): void {
+    enabled = false
+    clearPollTimer()
+    clearAllActiveTimers()
+    cancelRequests()
+  }
+
+  function handleVisibilityChange(): void {
+    if (isHidden()) {
+      clearPollTimer()
+      clearAllActiveTimers()
+      cancelRequests()
+    } else if (enabled) {
+      void refreshAll()
+      for (const monitorId of activeRuns.keys()) {
+        scheduleActivePoll(monitorId)
+      }
+    }
+  }
+
+  watch(
+    targets,
+    () => {
+      syncTargets()
+      if (enabled && !isHidden()) void refreshAll()
+    },
+    { immediate: true, deep: true, flush: 'sync' },
+  )
+
+  onMounted(() => {
+    document.addEventListener('visibilitychange', handleVisibilityChange)
+    start()
+  })
+
+  onBeforeUnmount(() => {
+    disposed = true
+    document.removeEventListener('visibilitychange', handleVisibilityChange)
+    stop()
+  })
+
+  return {
+    states,
+    stateFor,
+    refreshMonitor,
+    notifyRunSubmitted,
+    notifyRunFailed,
+    start,
+    stop,
+  }
+}
