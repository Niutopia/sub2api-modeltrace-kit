+  if (accountsSummary.value) {
+    const s = accountsSummary.value
+    return `一致性 ${s.match}/${s.total}`
+  }
+
+  const prob = scoredLatest.value && isProbability(scoredLatest.value.target_probability)
+    ? percent(scoredLatest.value.target_probability)
+    : ''
+
+  switch (tagStatus.value) {
+    case 'match':
+      return prob ? `✓ 一致 ${prob}` : '✓ 一致'
+    case 'suspect':
+      return prob ? `⚠ 可疑 ${prob}` : '⚠ 可疑'
+    case 'uncertain': {
+      if (retestProgressText.value) {
+        return `一致性 · ${retestProgressText.value}`
+      }
+      return prob ? `一致性 · 不确定 ${prob}` : '一致性 · 不确定'
+    }
+    case 'error':
+      return '一致性 · 检测失败'
+    case 'queued':
+      return '一致性 · 排队中'
+    case 'running':
+      return activeElapsedSeconds.value > 0 ? `一致性 · ${runningLabelText.value}` : '一致性 · 检测中'
+    case 'stale':
+      return '一致性 · 已过期'
+    case 'waiting':
+      return '一致性 · 等待首轮'
+  }
+  return ''
+})
+
+const tagBadgeClass = computed(() => {
+  switch (tagStatus.value) {
+    case 'match':
+      return 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/50 ring-1 ring-emerald-500/20'
+    case 'suspect':
+      return 'bg-red-50 text-red-700 hover:bg-red-100 dark:bg-red-950/40 dark:text-red-300 dark:hover:bg-red-900/50 ring-1 ring-red-500/20'
