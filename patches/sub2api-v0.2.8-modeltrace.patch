+package handler
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/Wei-Shaw/sub2api/internal/handler/admin"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/modeltrace"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+// ModelTraceStatus is read-only, and registered behind the existing viewer guard.
+func (h *ChannelMonitorUserHandler) ModelTraceStatus(c *gin.Context) { h.modelTrace(c, false) }
+
+// ModelTraceRun additionally requires administrator auth and the admin audit chain.
+func (h *ChannelMonitorUserHandler) ModelTraceRun(c *gin.Context) {
+	role, ok := middleware.GetUserRoleFromContext(c)
+	if !ok || role != "admin" {
+		response.Error(c, 403, "Administrator access required")
+		return
+	}
+	h.modelTrace(c, true)
+}
+func (h *ChannelMonitorUserHandler) modelTrace(c *gin.Context, run bool) {
+	if !h.featureEnabled(c) {
+		response.ErrorFrom(c, service.ErrChannelMonitorNotFound)
+		return
+	}
+	id, ok := admin.ParseChannelMonitorID(c)
+	if !ok {
+		return
+	}
+	metadata, err := h.monitorService.GetModelTraceMetadata(c.Request.Context(), id)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	// Both reads and manual runs must match the live monitor configuration;
+	// never enqueue a potentially billable check against an old sidecar model.
+	s, err := modeltrace.Get(c.Request.Context(), id, metadata.PrimaryModel)
+	if err != nil {
+		if errors.Is(err, modeltrace.ErrModelMismatch) {
+			response.ErrorWithDetails(c, http.StatusConflict, "检测模型与当前监控主模型不一致，已隐藏旧结果", "MODELTRACE_MODEL_MISMATCH", nil)
+			return
+		}
+		response.Error(c, 503, "模型一致性检测暂不可用")
+		return
+	}
+	if run {
+		// Re-read the main-site monitor after the sidecar GET preflight. This
+		// closes the common edit-between-preflight-and-enqueue window on the
+		// main site; the sidecar's expected_model check closes its own window.
+		currentMetadata, err := h.monitorService.GetModelTraceMetadata(c.Request.Context(), id)
+		if err != nil {
+			response.ErrorFrom(c, err)
+			return
+		}
+		if currentMetadata.ID != metadata.ID || currentMetadata.PrimaryModel != metadata.PrimaryModel {
+			response.ErrorWithDetails(c, http.StatusConflict, "检测模型与当前监控主模型不一致，已隐藏旧结果", "MODELTRACE_MODEL_MISMATCH", nil)
+			return
+		}
+		if err := modeltrace.Run(c.Request.Context(), id, metadata.PrimaryModel); err != nil {
+			switch {
+			case errors.Is(err, modeltrace.ErrModelMismatch):
+				// The sidecar re-checks the same model after the GET preflight.
+				// A 409 means the monitor changed in between, not that the
+				// detector is busy.
+				response.ErrorWithDetails(c, http.StatusConflict, "检测模型与当前监控主模型不一致，已隐藏旧结果", "MODELTRACE_MODEL_MISMATCH", nil)
+			case errors.Is(err, modeltrace.ErrBusy):
+				response.Error(c, 429, "检测已排队或冷却中，请稍后再试")
+			default:
+				response.Error(c, 503, "模型一致性检测暂不可用")
+			}
+			return
+		}
+		response.Accepted(c, gin.H{"queued": true})
+		return
+	}
+	response.Success(c, s)
+}
