+func TestExtractAndStripModelTraceProbeHeaders(t *testing.T) {
+	t.Setenv(ModelTraceSecretEnv, "correct-secret")
+
+	t.Run("valid probe headers match secret", func(t *testing.T) {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		c.Request.Header.Set(ModelTraceProbeHeader, "correct-secret")
+		c.Request.Header.Set(ModelTraceAccountHeader, "123")
+
+		routing := ExtractAndStripModelTraceProbeHeaders(c)
+		require.True(t, routing.Active)
+		require.Equal(t, int64(123), routing.AccountID)
+
+		// Both headers must be removed from request headers
+		require.Empty(t, c.Request.Header.Get(ModelTraceProbeHeader))
+		require.Empty(t, c.Request.Header.Get(ModelTraceAccountHeader))
+	})
+
+	t.Run("wrong secret inactivates and strips headers", func(t *testing.T) {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		c.Request.Header.Set(ModelTraceProbeHeader, "wrong-secret")
+		c.Request.Header.Set(ModelTraceAccountHeader, "123")
+
+		routing := ExtractAndStripModelTraceProbeHeaders(c)
+		require.False(t, routing.Active)
+		require.Zero(t, routing.AccountID)
+
+		// Both headers must be stripped so they never forward upstream
+		require.Empty(t, c.Request.Header.Get(ModelTraceProbeHeader))
+		require.Empty(t, c.Request.Header.Get(ModelTraceAccountHeader))
+	})
+
+	t.Run("empty secret in env inactivates and strips headers", func(t *testing.T) {
+		t.Setenv(ModelTraceSecretEnv, "")
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		c.Request.Header.Set(ModelTraceProbeHeader, "correct-secret")
+		c.Request.Header.Set(ModelTraceAccountHeader, "123")
+
+		routing := ExtractAndStripModelTraceProbeHeaders(c)
+		require.False(t, routing.Active)
+		require.Empty(t, c.Request.Header.Get(ModelTraceProbeHeader))
+		require.Empty(t, c.Request.Header.Get(ModelTraceAccountHeader))
+	})
+
+	t.Run("invalid account id format inactivates and strips headers", func(t *testing.T) {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		c.Request.Header.Set(ModelTraceProbeHeader, "correct-secret")
+		c.Request.Header.Set(ModelTraceAccountHeader, "abc")
+
+		routing := ExtractAndStripModelTraceProbeHeaders(c)
+		require.False(t, routing.Active)
+		require.Empty(t, c.Request.Header.Get(ModelTraceProbeHeader))
+		require.Empty(t, c.Request.Header.Get(ModelTraceAccountHeader))
+	})
+
+	t.Run("case-insensitive header names are stripped", func(t *testing.T) {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		c.Request.Header.Set("x-modeltrace-probe", "correct-secret")
+		c.Request.Header.Set("x-modeltrace-account", "456")
+
+		routing := ExtractAndStripModelTraceProbeHeaders(c)
+		require.True(t, routing.Active)
+		require.Equal(t, int64(456), routing.AccountID)
+		require.Empty(t, c.Request.Header.Get("x-modeltrace-probe"))
+		require.Empty(t, c.Request.Header.Get("x-modeltrace-account"))
+	})
+}
