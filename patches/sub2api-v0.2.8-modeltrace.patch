+func TestOpenAIModelTraceProbeTimeoutConfiguration(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		raw  string
+		want time.Duration
+	}{
+		{name: "default", raw: "", want: 120 * time.Second},
+		{name: "minimum", raw: "60", want: 60 * time.Second},
+		{name: "maximum", raw: "300", want: 300 * time.Second},
+		{name: "below minimum", raw: "59", want: 120 * time.Second},
+		{name: "above maximum", raw: "301", want: 120 * time.Second},
+		{name: "invalid", raw: "not-a-number", want: 120 * time.Second},
+		{name: "fractional", raw: "60.5", want: 120 * time.Second},
+		{name: "max int", raw: strconv.FormatInt(int64(^uint(0)>>1), 10), want: 120 * time.Second},
+		{name: "oversized", raw: strings.Repeat("9", 40), want: 120 * time.Second},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv(openAIModelTraceProbeTimeoutEnv, tc.raw)
+			require.Equal(t, tc.want, resolveOpenAIModelTraceProbeTimeout())
+		})
+	}
