diff --git a/backend/internal/server/routes/admin_modeltrace_test.go b/backend/internal/server/routes/admin_modeltrace_test.go
new file mode 100644
index 000000000..346f84410
--- /dev/null
+++ b/backend/internal/server/routes/admin_modeltrace_test.go
@@ -0,0 +1,120 @@
+package routes
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/handler"
+	adminhandler "github.com/Wei-Shaw/sub2api/internal/handler/admin"
+	servermiddleware "github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type modeltraceProxyRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f modeltraceProxyRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestAdminModelTraceRoutes_ProxyForwardingAndErrorMapping(t *testing.T) {
+	origTransport := http.DefaultTransport
+	defer func() { http.DefaultTransport = origTransport }()
+
+	t.Setenv("MODELTRACE_INTERNAL_URL", "http://127.0.0.1:8081")
+	t.Setenv("MODELTRACE_SECRET", "super-secret-admin")
+
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	v1 := router.Group("/api/v1")
+
+	adminAuth := servermiddleware.AdminAuthMiddleware(func(c *gin.Context) {
+		c.Set(string(servermiddleware.ContextKeyUserRole), "admin")
+		c.Next()
+	})
+	auditLog := servermiddleware.AuditLogMiddleware(func(c *gin.Context) { c.Next() })
+	stepUp := servermiddleware.StepUpAuthMiddleware(func(c *gin.Context) { c.Next() })
+
+	handlers := &handler.Handlers{
+		Admin: &handler.AdminHandlers{
+			ModelTrace: adminhandler.NewModelTraceHandler(),
+		},
+	}
+
+	RegisterAdminRoutes(v1, handlers, adminAuth, auditLog, stepUp, nil, nil)
+
+	// 1. GET /admin/modeltrace/accounts -> forward to /accounts
+	http.DefaultTransport = modeltraceProxyRoundTripper(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, "/accounts", r.URL.Path)
+		require.Equal(t, "Bearer super-secret-admin", r.Header.Get("Authorization"))
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusOK)
+		_, _ = rec.Write([]byte(`{"accounts":[{"account_id":17,"name":"acc-17"}]}`))
+		return rec.Result(), nil
+	})
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/api/v1/admin/modeltrace/accounts", nil)
+	router.ServeHTTP(rec, req)
+	require.Equal(t, http.StatusOK, rec.Code)
+	require.Contains(t, rec.Body.String(), `"acc-17"`)
+
+	// 2. GET /admin/modeltrace/accounts/:account_id -> forward to /accounts/:account_id
+	http.DefaultTransport = modeltraceProxyRoundTripper(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, "/accounts/17", r.URL.Path)
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusOK)
+		_, _ = rec.Write([]byte(`{"account_id":17,"name":"acc-17"}`))
+		return rec.Result(), nil
+	})
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/api/v1/admin/modeltrace/accounts/17", nil)
+	router.ServeHTTP(rec, req)
+	require.Equal(t, http.StatusOK, rec.Code)
+	require.Contains(t, rec.Body.String(), `"acc-17"`)
+
+	// 3. POST /admin/modeltrace/accounts/:account_id/run -> forward to /accounts/:account_id/run with body
+	var forwardedBody []byte
+	http.DefaultTransport = modeltraceProxyRoundTripper(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, http.MethodPost, r.Method)
+		require.Equal(t, "/accounts/17/run", r.URL.Path)
+		var err error
+		forwardedBody, err = io.ReadAll(r.Body)
+		require.NoError(t, err)
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusAccepted)
+		_, _ = rec.Write([]byte(`{"queued":true,"model":"gpt-5.6-sol"}`))
+		return rec.Result(), nil
+	})
+	rec = httptest.NewRecorder()
+	body := `{"model":"gpt-5.6-sol"}`
+	req = httptest.NewRequest(http.MethodPost, "/api/v1/admin/modeltrace/accounts/17/run", bytes.NewBufferString(body))
+	router.ServeHTTP(rec, req)
+	require.Equal(t, http.StatusAccepted, rec.Code)
+	require.Contains(t, rec.Body.String(), `"queued":true`)
+	require.Equal(t, body, string(forwardedBody))
+
+	// 4. 404 mapping on GET
+	http.DefaultTransport = modeltraceProxyRoundTripper(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusNotFound)
+		return rec.Result(), nil
+	})
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/api/v1/admin/modeltrace/accounts/999", nil)
+	router.ServeHTTP(rec, req)
+	require.Equal(t, http.StatusNotFound, rec.Code)
+
+	// 5. 409 Passthrough on POST
+	http.DefaultTransport = modeltraceProxyRoundTripper(func(r *http.Request) (*http.Response, error) {
+		rec := httptest.NewRecorder()
+		rec.WriteHeader(http.StatusConflict)
+		_, _ = rec.Write([]byte(`{"error":"already_queued"}`))
+		return rec.Result(), nil
+	})
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/api/v1/admin/modeltrace/accounts/17/run", nil)
+	router.ServeHTTP(rec, req)
+	require.Equal(t, http.StatusConflict, rec.Code)
+	require.Contains(t, rec.Body.String(), `"already_queued"`)
+}
