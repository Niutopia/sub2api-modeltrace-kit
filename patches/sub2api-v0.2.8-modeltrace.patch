+
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/openai/v1/chat/completions", bytes.NewBufferString(`{"model":"grok","messages":[{"role":"user","content":"hi"}],"stream":false}`))
