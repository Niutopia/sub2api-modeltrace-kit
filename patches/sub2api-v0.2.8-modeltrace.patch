+	t.Cleanup(func() { _ = client.Close() })
+
+	accountID := int64(123)
+	scope := "gpt-5.6-sol"
+	reason := "modeltrace_suspect"
+
+	mock.ExpectExec(regexp.QuoteMeta("UPDATE accounts SET")).
+		WithArgs(scope, accountID, reason, sqlmock.AnyArg()).
+		WillReturnResult(sqlmock.NewResult(1, 1))
+
+	mock.ExpectExec(regexp.QuoteMeta("INSERT INTO scheduler_outbox")).
+		WithArgs(service.SchedulerOutboxEventAccountChanged, &accountID, nil, nil, sqlmock.AnyArg()).
+		WillReturnResult(sqlmock.NewResult(1, 1))
