+
+func TestInternalModelTraceRoutes_Success(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("MODELTRACE_SECRET", "test-secret-value")
+	t.Setenv("MODELTRACE_ACTIVITY_EXCLUDE_KEY_IDS", "99")
+
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+
+	repo := &mockAccountRepo{
+		accounts: []service.Account{
+			{
+				ID:          17,
+				Name:        "acc-17@example.com",
+				Platform:    service.PlatformOpenAI,
+				Type:        service.AccountTypeOAuth,
+				Credentials: map[string]any{"model_mapping": map[string]any{"gpt-5.6-sol": "gpt-5.6-sol"}},
+				Status:      service.StatusActive,
+				Schedulable: true,
+			},
+		},
+	}
+
+	svc := service.NewModelTraceAccountsService(repo, db)
+	h := &handler.Handlers{
+		InternalModelTrace: handler.NewInternalModelTraceHandler(svc),
+	}
+
+	router := gin.New()
+	v1 := router.Group("/api/v1")
+	RegisterInternalModelTraceRoutes(v1, h)
+
+	now := time.Now()
+	rows := sqlmock.NewRows([]string{"account_id", "requests_10m", "last_request_at", "last_model"}).
+		AddRow(17, 3, now.Add(-time.Minute), "gpt-5.6-sol")
+
+	mock.ExpectQuery("SELECT account_id, COUNT\\(\\*\\) FILTER .* FROM usage_logs").
+		WillReturnRows(rows)
+
+	modelRows := sqlmock.NewRows([]string{"account_id", "model", "req_count"}).
+		AddRow(17, "gpt-5.6-sol", 3)
+
+	mock.ExpectQuery("SELECT account_id, model, COUNT\\(\\*\\) as req_count FROM usage_logs").
+		WillReturnRows(modelRows)
+
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/api/v1/internal/modeltrace/accounts?models=gpt-5.6-sol,gpt-4", nil)
+	req.Header.Set("Authorization", "Bearer test-secret-value")
+	router.ServeHTTP(rec, req)
+
+	require.Equal(t, http.StatusOK, rec.Code)
+
+	// Contract A1: the payload is top-level (no code/data envelope) so ModelTrace can read "accounts" directly.
+	var raw map[string]json.RawMessage
+	require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &raw))
+	require.Contains(t, raw, "accounts")
+	require.Contains(t, raw, "generated_at")
+	require.NotContains(t, raw, "data")
+	var body service.ModelTraceAccountsResponse
+	require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &body))
+	require.Len(t, body.Accounts, 1)
+
+	acc := body.Accounts[0]
+	require.Equal(t, int64(17), acc.AccountID)
+	require.Equal(t, "acc-17@example.com", acc.Name)
+	require.Equal(t, []string{"gpt-5.6-sol"}, acc.Models)
+	require.Equal(t, int64(3), acc.RealRequests10m)
+	require.Equal(t, "gpt-5.6-sol", *acc.LastRealModel)
+	require.Equal(t, []string{"gpt-5.6-sol"}, acc.RealModels10m)
+	require.NoError(t, mock.ExpectationsWereMet())
+}
