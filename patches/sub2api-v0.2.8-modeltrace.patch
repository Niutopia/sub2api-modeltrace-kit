+package service
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/DATA-DOG/go-sqlmock"
+	"github.com/stretchr/testify/require"
+)
+
+func TestModelTraceInactiveReason(t *testing.T) {
+	now := time.Now()
+	later := now.Add(time.Hour)
+	earlier := now.Add(-time.Hour)
+	cases := []struct {
+		name string
+		acc  Account
+		want string
+	}{
+		{"pool", Account{Status: StatusActive, Schedulable: true}, ""},
+		{"expired windows", Account{Status: StatusActive, Schedulable: true, RateLimitResetAt: &earlier, TempUnschedulableUntil: &earlier}, ""},
+		{"manual off", Account{Status: StatusActive, Schedulable: false}, "unschedulable"},
+		{"rate limited", Account{Status: StatusActive, Schedulable: true, RateLimitResetAt: &later}, "rate_limited"},
+		{"temp", Account{Status: StatusActive, Schedulable: true, TempUnschedulableUntil: &later}, "temp_unschedulable"},
+		{"error", Account{Status: StatusError, Schedulable: true}, "error"},
+		{"disabled", Account{Status: "disabled", Schedulable: true}, "disabled"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.want, modelTraceInactiveReason(&tc.acc, now))
+		})
+	}
+}
+
+func TestModelTraceAccountsService_IncludeInactive(t *testing.T) {
+	later := time.Now().Add(time.Hour)
+	mapping := map[string]any{"model_mapping": map[string]any{"gpt-4o": "gpt-4o"}}
+	repo := &mockAccountRepoForModelTrace{accounts: []Account{
+		{ID: 1, Platform: PlatformOpenAI, Type: AccountTypeOAuth, Status: StatusActive, Schedulable: true, Credentials: mapping},
+		{ID: 2, Platform: PlatformOpenAI, Type: AccountTypeAPIKey, Status: StatusActive, Schedulable: false, Credentials: mapping},
+		{ID: 3, Platform: PlatformOpenAI, Type: AccountTypeOAuth, Status: StatusActive, Schedulable: true, RateLimitResetAt: &later, Credentials: mapping},
+		{ID: 4, Platform: PlatformAnthropic, Type: AccountTypeAPIKey, Status: StatusActive, Schedulable: false, Credentials: mapping},
+	}}
+
+	expectStats := func(mock sqlmock.Sqlmock) {
+		mock.ExpectQuery("SELECT account_id, COUNT\\(\\*\\) FILTER .* FROM usage_logs").
+			WillReturnRows(sqlmock.NewRows([]string{"account_id", "requests_10m", "last_request_at", "last_model"}))
+		mock.ExpectQuery("SELECT account_id, model, COUNT\\(\\*\\) as req_count FROM usage_logs").
+			WillReturnRows(sqlmock.NewRows([]string{"account_id", "model", "req_count"}))
+	}
+
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	expectStats(mock)
+	resp, err := NewModelTraceAccountsService(repo, db).GetAccounts(context.Background(), []string{"gpt-4o"}, true)
+	require.NoError(t, err)
+	require.Len(t, resp.Accounts, 3, "non-OpenAI accounts stay out")
+	got := map[int64]ModelTraceAccountActivity{}
+	for _, a := range resp.Accounts {
+		got[a.AccountID] = a
+	}
+	require.True(t, got[1].Schedulable)
+	require.Empty(t, got[1].InactiveReason)
+	require.False(t, got[2].Schedulable)
+	require.Equal(t, "unschedulable", got[2].InactiveReason)
+	require.False(t, got[3].Schedulable)
+	require.Equal(t, "rate_limited", got[3].InactiveReason)
+
+	// Without the opt-in the pool query is unchanged and no reason is emitted.
+	db2, mock2, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db2.Close()
+	expectStats(mock2)
+	resp, err = NewModelTraceAccountsService(repo, db2).GetSchedulableAccounts(context.Background(), []string{"gpt-4o"})
+	require.NoError(t, err)
+	for _, a := range resp.Accounts {
+		require.Empty(t, a.InactiveReason)
+	}
+}
diff --git a/backend/internal/service/modeltrace_accounts_model_sync_test.go b/backend/internal/service/modeltrace_accounts_model_sync_test.go
new file mode 100644
