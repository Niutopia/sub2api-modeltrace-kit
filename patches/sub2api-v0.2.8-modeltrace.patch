+
+	require.NoError(t, err)
+	require.False(t, cleared)
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestClearModelRateLimitScopeIfReason_EmptyArgs(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
