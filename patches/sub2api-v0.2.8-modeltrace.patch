+  difference_signal: '本题特征偏向另一模型',
+  upstream_no_available_account: '上游暂无可用账号',
+  output_truncated: '上游输出被截断',
+  insufficient_output: '有效回答不足',
+  insufficient_sample: '有效数字样本不足',
+  response_truncated: '响应被截断',
+  invalid_event_stream: '响应事件流格式无效',
+  response_too_large: '响应超过大小限制',
+  upstream_timeout: '上游响应超时',
+  upstream_5xx: '上游服务错误',
+  upstream_unsupported_reasoning_effort: '上游不支持思考档位',
+  calibration_unverified_reasoning_effort: '缺少校准基线',
+  upstream_response_failed: '上游返回失败状态',
+  classifier_sample_mismatch: '分类器样本不一致',
+  classifier_error: '分类器处理失败',
+  mixed_upstream_account: '探针落入不同账号',
+  mixed_route: '探针落入不同账号',
+  upstream_error: '上游请求失败',
+  incomplete_response: '回答被截断',
+  upstream_model_mismatch: '上游模型标识不一致',
+}
+
+const props = withDefaults(defineProps<{
+  monitorId: number
+  model: string
+  snapshot?: TraceSnapshot | null
+  loading?: boolean
+  unavailable?: boolean
+  mappingMismatch?: boolean
+  queued?: boolean
+  running?: boolean
+  queuedAt?: number | null
+  runningAt?: number | null
+}>(), {
+  snapshot: null,
+  loading: false,
+  unavailable: false,
+  mappingMismatch: false,
+  queued: false,
+  running: false,
+  queuedAt: null,
+  runningAt: null,
+})
+
+const emit = defineEmits<{
+  (event: 'refresh'): void
+  (event: 'runSubmitted', monitorId: number): void
+  (event: 'runFailed', monitorId: number): void
+}>()
+
+const auth = useAuthStore()
+const triggerRef = ref<HTMLElement | null>(null)
+const popoverRef = ref<HTMLElement | null>(null)
+const showPopover = ref(false)
+const isMobile = ref(false)
+const popoverPositionStyle = ref<Record<string, string>>({})
+const submitting = ref(false)
+const actionMessage = ref('')
+const localOptimisticQueued = ref(false)
+const localOptimisticStartTime = ref<number | null>(null)
