+import { flushPromises, mount } from '@vue/test-utils'
+import { defineComponent, ref } from 'vue'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { AccountTraceListResponse } from '@/api/admin/modelTrace'
+import {
+  ACCOUNT_TRACE_BUSY_INTERVAL_MS,
+  ACCOUNT_TRACE_DEFAULT_INTERVAL_MS,
+  useAccountTracePolling,
+} from '../useAccountTracePolling'
+
+const { getAdminAccountTraces, runAdminAccountTrace, resetAdminAccountTrace } = vi.hoisted(() => ({
+  getAdminAccountTraces: vi.fn(),
+  runAdminAccountTrace: vi.fn(),
+  resetAdminAccountTrace: vi.fn(),
+}))
+let pageHidden = false
+vi.mock('@/api/admin/modelTrace', () => ({
+  getAdminAccountTraces,
+  runAdminAccountTrace,
+  resetAdminAccountTrace,
+}))
+
+function fakeAccountsResponse(overrides: any[] = []): AccountTraceListResponse {
+  return {
+    accounts: overrides.length > 0 ? overrides : [
+      {
+        account_id: 17,
+        name: 'acc-17',
+        models: ['gpt-5.6-sol'],
+        mode: 'active',
+        interval_seconds: 300,
+        last_real_request_at: '2026-09-24T12:00:00Z',
+        next_run_at: '2026-09-24T12:05:00Z',
+        running: false,
+        queued: false,
+        latest: {
+          model: 'gpt-5.6-sol',
+          status: 'match',
+          message_code: 'compatible',
+          target_probability: 0.8,
+          best_model: null,
+          checked_at: '2026-09-24T12:00:00Z',
+        },
+        history: [],
+      },
+    ],
+  }
+}
+
+function mountHarness(enabled = true) {
+  const enabledRef = ref(enabled)
+  let polling!: ReturnType<typeof useAccountTracePolling>
+  const Harness = defineComponent({
+    setup() {
+      polling = useAccountTracePolling(enabledRef)
+      return { enabledRef, polling }
+    },
+    template: '<div />',
+  })
+  const wrapper = mount(Harness)
+  return { wrapper, enabledRef, get polling() { return polling } }
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  getAdminAccountTraces.mockReset().mockResolvedValue(fakeAccountsResponse())
+  runAdminAccountTrace.mockReset().mockResolvedValue(undefined)
+  resetAdminAccountTrace.mockReset().mockResolvedValue(undefined)
+  pageHidden = false
+  vi.spyOn(document, 'hidden', 'get').mockImplementation(() => pageHidden)
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+describe('useAccountTracePolling', () => {
+  it('polls at default 60s interval when idle', async () => {
+    const { wrapper, polling } = mountHarness()
+    await flushPromises()
+
+    expect(getAdminAccountTraces).toHaveBeenCalledTimes(1)
+    expect(polling.stateFor(17).data?.account_id).toBe(17)
+
+    // Advance 59.9s -> no new call
+    await vi.advanceTimersByTimeAsync(ACCOUNT_TRACE_DEFAULT_INTERVAL_MS - 100)
+    expect(getAdminAccountTraces).toHaveBeenCalledTimes(1)
+
+    // Advance to 60s -> poll triggered
+    await vi.advanceTimersByTimeAsync(100)
+    await flushPromises()
+    expect(getAdminAccountTraces).toHaveBeenCalledTimes(2)
+
+    wrapper.unmount()
+  })
+
+  it('resolves an upstream entry from any of its member key ids', async () => {
+    const base = fakeAccountsResponse().accounts[0]
+    getAdminAccountTraces.mockResolvedValue(fakeAccountsResponse([
+      { ...base, account_id: 5, name: 'Upstream A', cluster_id: 'c1', cluster_name: 'Upstream A', member_account_ids: [5, 7, 23] },
+    ]))
+    const { wrapper, polling } = mountHarness()
+    await flushPromises()
+    for (const id of [5, 7, 23]) {
+      expect(polling.stateFor(id).data?.cluster_name).toBe('Upstream A')
+    }
+    wrapper.unmount()
+  })
+
+  it('polls at busy 3s interval when any account is running or queued', async () => {
+    getAdminAccountTraces.mockResolvedValueOnce(fakeAccountsResponse([
+      {
+        account_id: 17,
+        name: 'acc-17',
+        models: ['gpt-5.6-sol'],
+        mode: 'active',
+        interval_seconds: 300,
+        running: true,
+        queued: false,
+        latest: null,
+        history: [],
+      },
+    ]))
+
+    const { wrapper } = mountHarness()
+    await flushPromises()
+    expect(getAdminAccountTraces).toHaveBeenCalledTimes(1)
+
+    // Advance 3s -> triggers poll because running=true
+    await vi.advanceTimersByTimeAsync(ACCOUNT_TRACE_BUSY_INTERVAL_MS)
+    await flushPromises()
+    expect(getAdminAccountTraces).toHaveBeenCalledTimes(2)
+
+    wrapper.unmount()
+  })
+
+  it('settles an instant completion from a post-acceptance read without inventing a new result', async () => {
+    const { wrapper, polling } = mountHarness()
+    await flushPromises()
+
+    expect(polling.stateFor(17).optimisticQueued).toBe(false)
+
+    // Run account
+    const runPromise = polling.runAccount(17)
+    expect(polling.stateFor(17).optimisticQueued).toBe(true)
+    await runPromise
+    await flushPromises()
+
