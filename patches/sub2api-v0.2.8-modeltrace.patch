+
+func TestOpenAIModelTraceProbeFailoverKeepsDecisionAndDeadline(t *testing.T) {
+	t.Setenv("MODELTRACE_SECRET", "offline-secret")
+	c := modelTraceProbeTestContext(nil)
+	first, cancel := openAIModelTraceProbeContextWithTimeout(context.Background(), c, 50*time.Millisecond)
+	deadline, _ := first.Deadline()
+	cancel()
+	// No signature remains. A later attempt must not reuse the canceled child,
+	// downgrade to ordinary detach, or obtain a fresh configured deadline.
+	second, cancelSecond := openAIModelTraceProbeContext(context.Background(), c)
+	defer cancelSecond()
+	got, ok := second.Deadline()
+	require.True(t, ok)
+	require.Equal(t, deadline, got)
+	require.NoError(t, second.Err())
+	select {
+	case <-second.Done():
+		require.ErrorIs(t, second.Err(), context.DeadlineExceeded)
+	case <-time.After(time.Second):
+		t.Fatal("shared deadline did not expire")
+	}
+	third, cancelThird := openAIModelTraceProbeContext(context.Background(), c)
+	defer cancelThird()
+	require.ErrorIs(t, third.Err(), context.DeadlineExceeded)
+
+	bad := modelTraceProbeTestContext(nil)
+	bad.Request.Header.Set(openAIModelTraceProbeSignatureHeader, "fake")
+	badFirst, release := openAIModelTraceProbeContext(context.Background(), bad)
+	release()
+	require.False(t, isTrustedOpenAIModelTraceProbeContext(badFirst))
+	bad.Request.Header.Set(openAIModelTraceProbeSignatureHeader, modelTraceProbeTestSignature("offline-secret", modelTraceProbeTestUA))
+	badSecond, release := openAIModelTraceProbeContext(context.Background(), bad)
+	defer release()
+	require.False(t, isTrustedOpenAIModelTraceProbeContext(badSecond), "negative decision is immutable within a request")
+	requireModelTraceHeaderAbsent(t, bad.Request.Header)
+}
+
+func TestOpenAIModelTraceProbeEarlierParentDeadlineAndNil(t *testing.T) {
+	t.Setenv("MODELTRACE_SECRET", "offline-secret")
+	parent, cancelParent := context.WithTimeout(context.Background(), time.Second)
+	defer cancelParent()
+	ctx, cancel := openAIModelTraceProbeContext(parent, modelTraceProbeTestContext(nil))
+	defer cancel()
+	d, _ := ctx.Deadline()
+	pd, _ := parent.Deadline()
+	require.Equal(t, pd, d)
+	plain, release := openAIModelTraceProbeContext(parent, nil)
+	release()
+	require.Equal(t, parent, plain)
+	plain, release = detachUpstreamContext(nil)
+	release()
+	require.NotNil(t, plain)
+	require.False(t, isTrustedOpenAIModelTraceProbeContext(nil))
+}
+
+// This adapter uses the real net/http transport against a loopback-only server.
+// Rewriting the URL here avoids DNS/network access to the fixture account URL.
+type modelTraceProbeLocalUpstream struct {
+	client   *http.Client
+	target   *url.URL
+	requests chan *http.Request
+}
+
+func (u *modelTraceProbeLocalUpstream) Do(req *http.Request, _ string, _ int64, _ int) (*http.Response, error) {
+	u.requests <- req
+	local := req.Clone(req.Context())
+	local.URL.Scheme, local.URL.Host, local.Host = u.target.Scheme, u.target.Host, u.target.Host
+	return u.client.Do(local)
+}
+
+func (u *modelTraceProbeLocalUpstream) DoWithTLS(req *http.Request, proxy string, id int64, concurrency int, _ *tlsfingerprint.Profile) (*http.Response, error) {
+	return u.Do(req, proxy, id, concurrency)
+}
+
+func TestOpenAIModelTraceProbeForwardRealReadCancellation(t *testing.T) {
+	t.Setenv("MODELTRACE_SECRET", "offline-secret")
+	for _, accountType := range []string{AccountTypeAPIKey, AccountTypeOAuth} {
+		for _, passthrough := range []bool{false, true} {
+			for _, stream := range []bool{false, true} {
+				for _, mode := range []string{"client_cancel", "deadline", "ordinary_still_detaches", "ordinary_forged", "ordinary_nonadmin"} {
+					t.Run(fmt.Sprintf("type=%s/passthrough=%v/stream=%v/%s", accountType, passthrough, stream, mode), func(t *testing.T) {
+						started, canceled, finish := make(chan struct{}), make(chan struct{}), make(chan struct{})
+						serverHeaders := make(chan http.Header, 1)
+						server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+							_, _ = io.Copy(io.Discard, r.Body)
+							serverHeaders <- r.Header.Clone()
+							if stream || accountType == AccountTypeOAuth {
+								w.Header().Set("Content-Type", "text/event-stream")
+								_, _ = io.WriteString(w, "data: {\"type\":\"response.output_text.delta\",\"delta\":\"x\"}\n\n")
+							} else {
+								w.Header().Set("Content-Type", "application/json")
+								_, _ = io.WriteString(w, `{"output":[`)
+							}
+							w.(http.Flusher).Flush()
+							close(started)
+							select {
+							case <-r.Context().Done():
+								close(canceled)
+							case <-finish:
+								if stream || accountType == AccountTypeOAuth {
+									_, _ = io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}}\n\n")
+								} else {
+									_, _ = io.WriteString(w, `],"usage":{"input_tokens":1,"output_tokens":1}}`)
+								}
+							}
+						}))
+						defer server.Close()
+						var finishOnce sync.Once
+						finishServer := func() { finishOnce.Do(func() { close(finish) }) }
+						defer finishServer()
+						body := []byte(fmt.Sprintf(`{"model":"gpt-5.5","stream":%v,"max_output_tokens":2048,"input":"offline fixture"}`, stream))
+						c := modelTraceProbeTestContext(body)
+						parent, cancelParent := context.WithCancel(c.Request.Context())
+						defer cancelParent()
+						c.Request = c.Request.WithContext(parent)
+						if mode == "ordinary_still_detaches" {
+							c.Request.Header.Del(openAIModelTraceProbeSignatureHeader)
+						}
+						if mode == "ordinary_forged" {
+							c.Request.Header.Set(openAIModelTraceProbeSignatureHeader, "fake")
+						}
+						if mode == "ordinary_nonadmin" {
+							c.Set("api_key", &APIKey{User: &User{Role: RoleUser}})
+						}
+						if mode == "deadline" {
+							// Seed a short first-attempt deadline without changing the configured default.
+							_, cancel := openAIModelTraceProbeContextWithTimeout(parent, c, 600*time.Millisecond)
+							cancel()
+						}
+						target, err := url.Parse(server.URL)
+						require.NoError(t, err)
+						upstream := &modelTraceProbeLocalUpstream{client: server.Client(), target: target, requests: make(chan *http.Request, 1)}
+						svc := newOpenAIRejectedFieldTestService(nil)
+						svc.httpUpstream = upstream
+						account := newOpenAIRejectedFieldTestAccount()
+						if accountType == AccountTypeOAuth {
+							account = newOpenAIOAuthNamespaceTestAccount()
+							account.Extra = map[string]any{"openai_oauth_responses_websockets_v2_mode": OpenAIWSIngressModeOff}
+						}
+						account.Extra["openai_passthrough"] = passthrough
+						done := make(chan error, 1)
+						go func() { _, err := svc.Forward(parent, c, account, body); done <- err }()
+						select {
+						case <-started:
+						case err := <-done:
+							t.Fatalf("Forward ended before read: %v", err)
+						case <-time.After(3 * time.Second):
+							t.Fatal("upstream did not start")
+						}
+						req := <-upstream.requests
+						requireModelTraceHeaderAbsent(t, <-serverHeaders)
+						if mode != "deadline" {
+							cancelParent()
+						}
+						if strings.HasPrefix(mode, "ordinary_") {
+							select {
+							case <-canceled:
+								t.Fatal("ordinary upstream was canceled")
+							case err := <-done:
+								t.Fatalf("ordinary Forward stopped: %v", err)
+							case <-time.After(50 * time.Millisecond):
+							}
+							require.NoError(t, req.Context().Err())
+							// Closing the idle connection at test cleanup is not a production request.
+							// Ask the local server to reach EOF so the detached reader can finish.
+							finishServer()
+						} else {
+							select {
+							case <-canceled:
+							case <-time.After(2 * time.Second):
+								t.Fatal("real upstream connection was not canceled")
+							}
+							require.Error(t, req.Context().Err())
+						}
+						select {
+						case err := <-done:
+							if !strings.HasPrefix(mode, "ordinary_") {
+								require.Error(t, err)
+							}
+						case <-time.After(2 * time.Second):
+							t.Fatal("Forward body read did not stop")
+						}
+						requireModelTraceHeaderAbsent(t, c.Request.Header)
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestOpenAIModelTraceProbeForwardDoesNotChangeBody(t *testing.T) {
+	t.Setenv("MODELTRACE_SECRET", "offline-secret")
+	for _, passthrough := range []bool{false, true} {
+		t.Run(fmt.Sprint(passthrough), func(t *testing.T) {
+			body := []byte(`{"model":"gpt-5.5","stream":false,"input":"offline body","max_output_tokens":2048}`)
+			var baseline []byte
+			for _, signed := range []bool{false, true} {
+				c := modelTraceProbeTestContext(body)
+				if !signed {
+					c.Request.Header.Del(openAIModelTraceProbeSignatureHeader)
+				}
+				upstream := &httpUpstreamRecorder{resp: newOpenAIRejectedFieldTestResponse(http.StatusOK, `{"output":[],"usage":{"input_tokens":1,"output_tokens":1}}`)}
+				account := newOpenAIRejectedFieldTestAccount()
+				account.Extra["openai_passthrough"] = passthrough
+				_, err := newOpenAIRejectedFieldTestService(upstream).Forward(c.Request.Context(), c, account, body)
+				require.NoError(t, err)
+				requireModelTraceHeaderAbsent(t, upstream.lastReq.Header)
+				if signed {
+					require.Equal(t, baseline, upstream.lastBody)
+					require.ErrorIs(t, upstream.lastReq.Context().Err(), context.Canceled, "Forward owns cancellation through return")
+				} else {
+					baseline = append([]byte(nil), upstream.lastBody...)
+				}
+			}
+		})
+	}
+}
+
+func TestOpenAIModelTraceProbeRepeatedForwardKeepsBudget(t *testing.T) {
+	t.Setenv("MODELTRACE_SECRET", "offline-secret")
+	body := []byte(`{"model":"gpt-5.5","stream":false,"input":"offline retry","max_output_tokens":2048}`)
+	c := modelTraceProbeTestContext(body)
+	var firstDeadline time.Time
+	// Handler failover calls Forward again with the original inbound context.
+	// Exercise both dispatch branches with the consumed header and a canceled
+	// prior attempt. Only the deadline (not a canceled child) may be reused.
+	for attempt, passthrough := range []bool{false, true} {
+		upstream := &httpUpstreamRecorder{resp: newOpenAIRejectedFieldTestResponse(http.StatusOK, `{"output":[],"usage":{"input_tokens":1,"output_tokens":1}}`)}
+		account := newOpenAIRejectedFieldTestAccount()
+		account.Extra["openai_passthrough"] = passthrough
+		_, err := newOpenAIRejectedFieldTestService(upstream).Forward(c.Request.Context(), c, account, body)
+		require.NoError(t, err)
+		requireModelTraceHeaderAbsent(t, c.Request.Header)
+		requireModelTraceHeaderAbsent(t, upstream.lastReq.Header)
+		require.True(t, isTrustedOpenAIModelTraceProbeContext(upstream.lastReq.Context()))
+		deadline, ok := upstream.lastReq.Context().Deadline()
+		require.True(t, ok)
+		if attempt == 0 {
+			firstDeadline = deadline
+		} else {
+			require.Equal(t, firstDeadline, deadline)
+		}
+		require.ErrorIs(t, upstream.lastReq.Context().Err(), context.Canceled)
+		require.NoError(t, c.Request.Context().Err(), "attempt cleanup must not cancel inbound context")
+	}
+}
