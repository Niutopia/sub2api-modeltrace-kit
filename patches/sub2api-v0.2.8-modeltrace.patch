 	return nil
 }
 
+// SetModelRateLimitPreservingOther sets a model limit with the given reason. An
+// active limit for the same scope with a different reason is kept under
+// "preserved" (timestamps are RFC3339 UTC, so text comparison orders them), so
+// clearing this reason later restores it instead of lifting it early. The read
+// and write happen in one statement.
+func (r *accountRepository) SetModelRateLimitPreservingOther(ctx context.Context, id int64, scope string, resetAt time.Time, reason string) error {
+	if strings.TrimSpace(scope) == "" || strings.TrimSpace(reason) == "" {
+		return nil
+	}
+	now := time.Now().UTC()
+	raw, err := json.Marshal(map[string]string{
+		"rate_limited_at":     now.Format(time.RFC3339),
+		"rate_limit_reset_at": resetAt.UTC().Format(time.RFC3339),
+		"reason":              reason,
+	})
+	if err != nil {
+		return err
+	}
+	client := clientFromContext(ctx, r.client)
+	result, err := client.ExecContext(
+		ctx,
+		`UPDATE accounts SET
+			extra = jsonb_set(
+				jsonb_set(COALESCE(extra, '{}'::jsonb), '{model_rate_limits}'::text[], COALESCE(extra->'model_rate_limits', '{}'::jsonb), true),
+				ARRAY['model_rate_limits', $1]::text[],
+				$2::jsonb || CASE
+					WHEN extra->'model_rate_limits'->$1->>'reason' IS DISTINCT FROM $4
+					 AND extra->'model_rate_limits'->$1->>'rate_limit_reset_at' > $5
+						THEN jsonb_build_object('preserved', (extra->'model_rate_limits'->$1) - 'preserved')
+					WHEN extra->'model_rate_limits'->$1->>'reason' = $4
+					 AND extra->'model_rate_limits'->$1->'preserved'->>'rate_limit_reset_at' > $5
+						THEN jsonb_build_object('preserved', extra->'model_rate_limits'->$1->'preserved')
+					ELSE '{}'::jsonb
+				END,
+				true
+			),
+			updated_at = NOW()
+		WHERE id = $3 AND deleted_at IS NULL`,
+		scope, raw, id, reason, now.Format(time.RFC3339),
+	)
+	if err != nil {
+		return err
+	}
+	affected, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if affected == 0 {
+		return service.ErrAccountNotFound
+	}
+	if err := enqueueSchedulerOutbox(ctx, r.sql, service.SchedulerOutboxEventAccountChanged, &id, nil, nil); err != nil {
+		logger.LegacyPrintf("repository.account", "[SchedulerOutbox] enqueue model rate limit failed: account=%d err=%v", id, err)
+	}
+	r.syncSchedulerAccountSnapshot(ctx, id)
+	return nil
+}
+
+// ClearModelRateLimitScopeIfReason lifts a model limit only if it carries the
+// given reason. A still-active limit preserved underneath it is restored.
+func (r *accountRepository) ClearModelRateLimitScopeIfReason(ctx context.Context, id int64, scope, reason string) (bool, error) {
+	if strings.TrimSpace(scope) == "" || strings.TrimSpace(reason) == "" {
+		return false, nil
+	}
+	client := clientFromContext(ctx, r.client)
+	result, err := client.ExecContext(
+		ctx,
+		`UPDATE accounts SET
+			extra = jsonb_set(
+				COALESCE(extra, '{}'::jsonb),
+				'{model_rate_limits}'::text[],
+				CASE
+					WHEN extra->'model_rate_limits'->$1->'preserved'->>'rate_limit_reset_at' > $4
+						THEN jsonb_set(COALESCE(extra->'model_rate_limits', '{}'::jsonb), ARRAY[$1]::text[], extra->'model_rate_limits'->$1->'preserved', true)
+					ELSE COALESCE(extra->'model_rate_limits', '{}'::jsonb) - $1::text
+				END,
+				true
+			),
+			updated_at = NOW()
+		WHERE id = $2
+		  AND deleted_at IS NULL
+		  AND extra->'model_rate_limits'->$1->>'reason' = $3`,
+		scope,
+		id,
+		reason,
+		time.Now().UTC().Format(time.RFC3339),
+	)
+	if err != nil {
+		return false, err
+	}
+
+	affected, err := result.RowsAffected()
+	if err != nil {
+		return false, err
+	}
+	if affected == 0 {
+		return false, nil
+	}
+	if err := enqueueSchedulerOutbox(ctx, r.sql, service.SchedulerOutboxEventAccountChanged, &id, nil, nil); err != nil {
+		logger.LegacyPrintf("repository.account", "[SchedulerOutbox] enqueue clear model rate limit scope failed: account=%d err=%v", id, err)
+	}
+	r.syncSchedulerAccountSnapshot(ctx, id)
+	return true, nil
+}
