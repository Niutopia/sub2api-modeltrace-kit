+package service
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestModelTraceProbeHeaderMiddlewareStripsOnEveryRoute(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv(ModelTraceSecretEnv, "probe-secret")
+	for _, tc := range []struct {
+		name   string
+		secret string
+		active bool
+	}{{"valid", "probe-secret", true}, {"wrong", "guess", false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			engine := gin.New()
+			engine.Use(ModelTraceProbeHeaderMiddleware())
+			var seen http.Header
+			var routing ModelTraceProbeRouting
+			// A handler that never looks at probe routing (e.g. /v1/messages).
+			engine.POST("/v1/messages", func(c *gin.Context) {
+				seen = c.Request.Header.Clone()
+				routing = ExtractAndStripModelTraceProbeHeaders(c)
+				c.Status(http.StatusNoContent)
+			})
+			req := httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+			req.Header.Set("x-modeltrace-probe", tc.secret)
+			req.Header.Set("X-ModelTrace-Account", "41")
+			engine.ServeHTTP(httptest.NewRecorder(), req)
+
+			require.NotNil(t, seen)
+			assert.Empty(t, seen.Get(ModelTraceProbeHeader), "the secret never reaches a handler")
+			assert.Empty(t, seen.Get(ModelTraceAccountHeader))
+			assert.Equal(t, tc.active, routing.Active, "handlers still get the verified routing")
+			if tc.active {
+				assert.Equal(t, int64(41), routing.AccountID)
+			}
+		})
+	}
+}
diff --git a/backend/internal/service/modeltrace_probe_routing.go b/backend/internal/service/modeltrace_probe_routing.go
new file mode 100644
index 000000000..8a0a455f2
--- /dev/null
+++ b/backend/internal/service/modeltrace_probe_routing.go
@@ -0,0 +1,225 @@
+package service
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+)
+
+const (
+	ModelTraceProbeHeader   = "X-ModelTrace-Probe"
+	ModelTraceAccountHeader = "X-ModelTrace-Account"
+	ModelTraceSecretEnv     = "MODELTRACE_SECRET"
+
+	ProbeAccountUnavailableCode = "probe_account_unavailable"
+)
+
+// ModelTraceProbeRouting represents the parsed and verified probe routing specification.
+type ModelTraceProbeRouting struct {
+	Active    bool
+	AccountID int64
+}
+
+const modelTraceProbeRoutingContextKey = "modeltrace_probe_routing"
+
+// ModelTraceProbeHeaderMiddleware strips the probe headers from every request
+// before any handler runs, so no entry point can forward them upstream, and
+// keeps the verified routing for handlers that honor it.
+func ModelTraceProbeHeaderMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		ExtractAndStripModelTraceProbeHeaders(c)
+		c.Next()
+	}
+}
+
+// ExtractAndStripModelTraceProbeHeaders extracts and deletes the probe routing headers from the request.
+// If X-ModelTrace-Probe matches MODELTRACE_SECRET via constant-time comparison and X-ModelTrace-Account
+// contains a valid account ID, it returns Active=true and the parsed AccountID.
+// In all cases, both headers are deleted from c.Request.Header so they are never forwarded upstream.
+// The result is cached on the context: after the middleware ran, handlers read it from there.
+func ExtractAndStripModelTraceProbeHeaders(c *gin.Context) ModelTraceProbeRouting {
+	if c == nil || c.Request == nil {
+		return ModelTraceProbeRouting{}
+	}
+	if cached, ok := c.Get(modelTraceProbeRoutingContextKey); ok {
+		if routing, ok := cached.(ModelTraceProbeRouting); ok {
+			return routing
+		}
+	}
+	routing := extractModelTraceProbeHeaders(c)
+	c.Set(modelTraceProbeRoutingContextKey, routing)
+	return routing
+}
+
+func extractModelTraceProbeHeaders(c *gin.Context) ModelTraceProbeRouting {
+
+	var probeVal, accountVal string
+	for key, values := range c.Request.Header {
+		if strings.EqualFold(key, ModelTraceProbeHeader) {
+			if len(values) > 0 {
+				probeVal = values[0]
+			}
+			delete(c.Request.Header, key)
+		} else if strings.EqualFold(key, ModelTraceAccountHeader) {
+			if len(values) > 0 {
+				accountVal = values[0]
+			}
+			delete(c.Request.Header, key)
+		}
+	}
+
+	secret := os.Getenv(ModelTraceSecretEnv)
+	if secret == "" || strings.TrimSpace(probeVal) == "" {
+		return ModelTraceProbeRouting{}
+	}
+
+	if subtle.ConstantTimeCompare([]byte(probeVal), []byte(secret)) != 1 {
+		return ModelTraceProbeRouting{}
+	}
+
+	accountID, err := strconv.ParseInt(strings.TrimSpace(accountVal), 10, 64)
+	if err != nil || accountID <= 0 {
+		return ModelTraceProbeRouting{}
+	}
+
+	return ModelTraceProbeRouting{
+		Active:    true,
+		AccountID: accountID,
+	}
+}
+
+// RespondProbeAccountUnavailable writes the standard 503 response required by contract A2.
+// If streaming is already started (e.g. headers committed), it emits a responses failed event.
+func RespondProbeAccountUnavailable(c *gin.Context, message string, streamStarted bool) {
+	if streamStarted {
+		if flusher, ok := c.Writer.(http.Flusher); ok {
+			c.Writer.Header().Set("Content-Type", "text/event-stream")
+			payload, _ := json.Marshal(gin.H{
+				"type": "response.failed",
+				"response": gin.H{
+					"id":         fmt.Sprintf("resp_%d", time.Now().UnixNano()),
+					"object":     "response",
+					"created_at": time.Now().Unix(),
+					"status":     "failed",
+					"output":     []any{},
+					"error": gin.H{
+						"code":    ProbeAccountUnavailableCode,
+						"message": message,
+					},
+				},
+			})
+			_, _ = fmt.Fprintf(c.Writer, "event: response.failed\ndata: %s\n\n", payload)
+			flusher.Flush()
+			return
+		}
+	}
+	c.JSON(http.StatusServiceUnavailable, gin.H{
+		"error": gin.H{
+			"code":    ProbeAccountUnavailableCode,
+			"message": message,
+		},
+	})
+}
+
+// IsModelTraceProbeRoutablePlatform reports whether a probe may be pinned to an
+// account of this platform. A probe must never push an account through a
+// protocol path it cannot serve; these are the platforms the OpenAI-compatible
+// gateway forwards.
+func IsModelTraceProbeRoutablePlatform(platform string) bool {
+	switch platform {
+	case PlatformOpenAI, PlatformGrok, PlatformDeepseek, PlatformOpenCodeGo:
+		return true
+	default:
+		return false
+	}
+}
+
+// SelectAccountForModelTraceProbe loads the specified account, checks that it is schedulable,
+// and confirms that it supports the requested model. If any check fails, it returns an error.
+func (s *OpenAIGatewayService) SelectAccountForModelTraceProbe(ctx context.Context, accountID int64, requestedModel string) (*AccountSelectionResult, error) {
+	var (
+		account *Account
+		err     error
+	)
+	if s.schedulerSnapshot != nil {
+		account, err = s.schedulerSnapshot.GetAccount(ctx, accountID)
+	} else if s.accountRepo != nil {
+		account, err = s.accountRepo.GetByID(ctx, accountID)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if account == nil || !account.IsActive() || !account.IsSchedulable() {
+		return nil, ErrNoAvailableAccounts
+	}
+	if !IsModelTraceProbeRoutablePlatform(account.Platform) {
+		return nil, ErrNoAvailableAccounts
+	}
+	if requestedModel != "" && !account.IsModelSupported(requestedModel) {
+		return nil, ErrNoAvailableAccounts
+	}
+	// Try acquire concurrency slot
+	result, err := s.tryAcquireAccountSlot(ctx, account.ID, account.Concurrency)
+	if err != nil {
+		return nil, err
+	}
+	if result != nil && result.Acquired {
+		return s.newAcquiredSelectionResult(ctx, account, result.ReleaseFunc)
+	}
+	cfg := s.schedulingConfig()
+	return s.newSelectionResult(ctx, account, false, nil, &AccountWaitPlan{
+		AccountID:      account.ID,
+		MaxConcurrency: account.Concurrency,
+		Timeout:        cfg.FallbackWaitTimeout,
+		MaxWaiting:     cfg.FallbackMaxWaiting,
+	})
+}
+
+// SelectAccountForModelTraceProbe loads the specified account, checks that it is schedulable,
+// and confirms that it supports the requested model for GatewayService.
+func (s *GatewayService) SelectAccountForModelTraceProbe(ctx context.Context, accountID int64, requestedModel string) (*AccountSelectionResult, error) {
+	var (
+		account *Account
+		err     error
+	)
+	if s.schedulerSnapshot != nil {
+		account, err = s.schedulerSnapshot.GetAccount(ctx, accountID)
+	} else if s.accountRepo != nil {
+		account, err = s.accountRepo.GetByID(ctx, accountID)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if account == nil || !account.IsActive() || !account.IsSchedulable() {
+		return nil, ErrNoAvailableAccounts
+	}
+	if requestedModel != "" && !account.IsModelSupported(requestedModel) {
+		return nil, ErrNoAvailableAccounts
+	}
+	result, err := s.tryAcquireAccountSlot(ctx, account.ID, account.Concurrency)
+	if err != nil {
+		return nil, err
+	}
+	if result != nil && result.Acquired {
+		selection, err := s.newSelectionResult(ctx, account, true, result.ReleaseFunc, nil)
+		if err != nil && result.ReleaseFunc != nil {
+			result.ReleaseFunc()
+		}
+		return selection, err
+	}
+	cfg := s.schedulingConfig()
+	return s.newSelectionResult(ctx, account, false, nil, &AccountWaitPlan{
+		AccountID:      account.ID,
+		MaxConcurrency: account.Concurrency,
+		Timeout:        cfg.FallbackWaitTimeout,
+		MaxWaiting:     cfg.FallbackMaxWaiting,
+	})
+}
