+package admin
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func modelTraceHandlerSyncWhitelist(models ...string) map[string]any {
+	mapping := make(map[string]any, len(models))
+	for _, model := range models {
+		mapping[model] = model
+	}
+	return mapping
+}
+
+func TestAccountHandler_ModelTraceModelListDetailKeepsWhitelist(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	svc := newStubAdminService()
+	svc.getAccountResult = &service.Account{
+		ID: 42, Name: "231", Platform: service.PlatformOpenAI,
+		Type: service.AccountTypeAPIKey, Status: service.StatusActive,
+		Credentials: map[string]any{"api_key": "secret-test-key"},
+	}
+	h := NewAccountHandler(svc, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
+	router := gin.New()
+	router.GET("/api/v1/admin/accounts/:id", h.GetByID)
+
+	for _, models := range [][]string{
+		{"gpt-6-astra"},
+		{"codex-auto-review", "gpt-5.5", "gpt-5.6-luna", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-6-astra", "gpt-reserve"},
+	} {
+		mapping := modelTraceHandlerSyncWhitelist(models...)
+		svc.getAccountResult.Credentials["model_mapping"] = mapping
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/api/v1/admin/accounts/42", nil))
+		require.Equal(t, http.StatusOK, w.Code)
+		var payload struct {
+			Data struct {
+				ID                int64           `json:"id"`
+				Name              string          `json:"name"`
+				Credentials       map[string]any  `json:"credentials"`
+				CredentialsStatus map[string]bool `json:"credentials_status"`
+			} `json:"data"`
+		}
+		require.NoError(t, json.Unmarshal(w.Body.Bytes(), &payload))
+		require.Equal(t, int64(42), payload.Data.ID)
+		require.Equal(t, "231", payload.Data.Name)
+		require.Equal(t, mapping, payload.Data.Credentials["model_mapping"])
+		require.NotContains(t, payload.Data.Credentials, "api_key")
+		require.True(t, payload.Data.CredentialsStatus["has_api_key"])
+		require.NotContains(t, w.Body.String(), "secret-test-key")
+	}
+}
+
+func TestAccountHandler_ModelTraceModelListSaveForwardsWhitelist(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	svc := newStubAdminService()
+	h := NewAccountHandler(svc, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
+	router := gin.New()
+	router.PUT("/api/v1/admin/accounts/:id", h.Update)
+	mapping := modelTraceHandlerSyncWhitelist(
+		"codex-auto-review", "gpt-5.5", "gpt-5.6-luna", "gpt-5.6-sol",
+		"gpt-5.6-terra", "gpt-6-astra", "gpt-reserve",
+	)
+	body, err := json.Marshal(map[string]any{"name": "231", "credentials": map[string]any{
+		"base_url": "https://provider.example/v1", "model_mapping": mapping,
+	}})
+	require.NoError(t, err)
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPut, "/api/v1/admin/accounts/42", strings.NewReader(string(body)))
+	req.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, 1, svc.updateAccountCalls)
+	require.Equal(t, "231", svc.lastUpdateAccountInput.Name)
+	require.Equal(t, mapping, svc.lastUpdateAccountInput.Credentials["model_mapping"])
+}
+
+func TestModelTraceHandler_ModelListReadsAreNotCached(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	originalTransport := http.DefaultTransport
+	t.Cleanup(func() { http.DefaultTransport = originalTransport })
+	t.Setenv("MODELTRACE_INTERNAL_URL", "http://127.0.0.1:8081")
+	t.Setenv("MODELTRACE_SECRET", "test-secret")
+	h := NewModelTraceHandler()
+	router := gin.New()
+	router.GET("/api/v1/admin/modeltrace/accounts", h.GetAccounts)
+	router.GET("/api/v1/admin/modeltrace/accounts/:account_id", h.GetAccountDetail)
+
+	for _, suffix := range []string{"/accounts", "/accounts/42"} {
+		t.Run(suffix, func(t *testing.T) {
+			calls := 0
+			var currentBody string
+			http.DefaultTransport = handlerProxyRoundTripFunc(func(req *http.Request) (*http.Response, error) {
+				calls++
+				require.Equal(t, http.MethodGet, req.Method)
+				require.Equal(t, suffix, req.URL.Path)
+				require.Equal(t, "Bearer test-secret", req.Header.Get("Authorization"))
+				w := httptest.NewRecorder()
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.WriteString(currentBody)
+				return w.Result(), nil
+			})
+			for _, models := range [][]string{{"gpt-6-astra"}, {"gpt-6-astra", "gpt-5.6-sol"}} {
+				account := map[string]any{"account_id": 42, "name": "231", "models": models}
+				var payload any = account
+				if suffix == "/accounts" {
+					payload = map[string]any{"accounts": []any{account}}
+				}
+				body, err := json.Marshal(payload)
+				require.NoError(t, err)
+				currentBody = string(body)
+				w := httptest.NewRecorder()
+				router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/api/v1/admin/modeltrace"+suffix, nil))
+				require.Equal(t, http.StatusOK, w.Code)
+				require.JSONEq(t, currentBody, w.Body.String())
+			}
+			require.Equal(t, 2, calls, "each GET must reach the sidecar, without waiting for a Go cache TTL")
+		})
+	}
+}
diff --git a/backend/internal/handler/admin/modeltrace_handler.go b/backend/internal/handler/admin/modeltrace_handler.go
new file mode 100644
index 000000000..ce36087f0
--- /dev/null
+++ b/backend/internal/handler/admin/modeltrace_handler.go
@@ -0,0 +1,103 @@
+package admin
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/modeltrace"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/gin-gonic/gin"
+)
+
+const maxRunAccountBodyBytes = 4096
+
+// ModelTraceHandler handles administrative proxy routes to ModelTrace service.
+type ModelTraceHandler struct{}
+
+// NewModelTraceHandler creates a new ModelTraceHandler.
+func NewModelTraceHandler() *ModelTraceHandler {
+	return &ModelTraceHandler{}
+}
+
+// GetAccounts proxies GET /api/v1/admin/modeltrace/accounts to ModelTrace's GET /accounts.
+func (h *ModelTraceHandler) GetAccounts(c *gin.Context) {
+	result, err := modeltrace.GetAccounts(c.Request.Context())
+	if err != nil {
+		h.handleError(c, err)
+		return
+	}
+	c.Data(result.StatusCode, "application/json; charset=utf-8", result.Body)
+}
+
+// GetAccountDetail proxies GET /api/v1/admin/modeltrace/accounts/:account_id to ModelTrace's GET /accounts/:account_id.
+func (h *ModelTraceHandler) GetAccountDetail(c *gin.Context) {
+	accountID, err := strconv.ParseInt(c.Param("account_id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "Invalid account ID")
+		return
+	}
+
+	result, err := modeltrace.GetAccountDetail(c.Request.Context(), accountID)
+	if err != nil {
+		h.handleError(c, err)
+		return
+	}
+	c.Data(result.StatusCode, "application/json; charset=utf-8", result.Body)
+}
+
+// RunAccount proxies POST /api/v1/admin/modeltrace/accounts/:account_id/run to ModelTrace's POST /accounts/:account_id/run.
+func (h *ModelTraceHandler) RunAccount(c *gin.Context) {
+	h.forwardAccountAction(c, modeltrace.RunAccountDirect)
+}
+
+// ResetAccount proxies POST /api/v1/admin/modeltrace/accounts/:account_id/reset to ModelTrace's POST /accounts/:account_id/reset.
+func (h *ModelTraceHandler) ResetAccount(c *gin.Context) {
+	h.forwardAccountAction(c, modeltrace.ResetAccount)
+}
+
+// forwardAccountAction reads a bounded JSON body and passes ModelTrace's status and body through.
+func (h *ModelTraceHandler) forwardAccountAction(c *gin.Context, forward func(context.Context, int64, []byte) (*modeltrace.ForwardResult, error)) {
+	accountID, err := strconv.ParseInt(c.Param("account_id"), 10, 64)
+	if err != nil || accountID <= 0 {
+		response.BadRequest(c, "Invalid account ID")
+		return
+	}
+
+	var body []byte
+	if c.Request.Body != nil {
+		body, err = io.ReadAll(io.LimitReader(c.Request.Body, maxRunAccountBodyBytes+1))
+		if err != nil {
+			response.BadRequest(c, "Failed to read request body")
+			return
+		}
+		if len(body) > maxRunAccountBodyBytes {
+			response.BadRequest(c, "Request body exceeds maximum allowed size (4KB)")
+			return
+		}
+	}
+
+	result, err := forward(c.Request.Context(), accountID, body)
+	if err != nil {
+		if errors.Is(err, modeltrace.ErrNotFound) {
+			response.NotFound(c, "ModelTrace account not found")
+			return
+		}
+		response.Error(c, http.StatusServiceUnavailable, "模型一致性服务暂不可用")
+		return
+	}
+	c.Data(result.StatusCode, "application/json; charset=utf-8", result.Body)
+}
+
+func (h *ModelTraceHandler) handleError(c *gin.Context, err error) {
+	switch {
+	case errors.Is(err, modeltrace.ErrNotFound):
+		response.NotFound(c, "ModelTrace account not found")
+	case errors.Is(err, modeltrace.ErrBusy):
+		response.Error(c, http.StatusTooManyRequests, "检测已排队或冷却中，请稍后再试")
+	default:
+		response.Error(c, http.StatusServiceUnavailable, "模型一致性服务暂不可用")
+	}
+}
