+  return `复测进度 ${progress.done}/${progress.total}`
+})
+
+const effortBadge = computed(() => {
+  if (!currentSnapshot.value?.supported) return ''
+  const effort = currentSnapshot.value.reasoning_effort?.trim()
+  if (!effort || effort === 'none') return ''
+  return `思考强度 ${effort}`
+})
+
+const subRowItems = computed(() => {
+  const items: string[] = []
+  if (failureReasonShort.value) items.push(failureReasonShort.value)
+  if (retestProgressText.value) items.push(retestProgressText.value)
+  if (effortBadge.value) items.push(effortBadge.value)
+  return items
+})
+
+const dots = computed<(TraceRound | null)[]>(() => {
+  const history = currentSnapshot.value?.supported ? currentSnapshot.value.history : []
+  const rounds = [...(history || [])]
+    .sort((a, b) => Date.parse(a.checked_at) - Date.parse(b.checked_at))
+    .slice(-HISTORY_LIMIT)
+  return [...Array<null>(HISTORY_LIMIT - rounds.length).fill(null), ...rounds]
+})
+
+function dotClass(round: TraceRound | null): string {
+  if (!round) return 'bg-gray-200 dark:bg-dark-700'
+  if (round.status === 'match') return 'bg-emerald-500'
+  if (round.status === 'suspect') return 'bg-red-500'
+  if (round.status === 'uncertain') return 'bg-amber-400'
+  return 'bg-gray-400 dark:bg-dark-500'
+}
+
+function dotTitle(round: TraceRound | null): string {
+  if (!round) return '暂无记录'
+  const time = formatTime(round.checked_at)
+  const conclusion = STATUS_LABELS[round.status] || round.status || '无有效结果'
+  const prob = isProbability(round.target_probability) ? ` · ${percent(round.target_probability)}` : ''
+  return `${time} · ${conclusion}${prob}`
+}
+
+
+const lastRunLabel = computed(() => {
+  return shortTime(currentSnapshot.value?.supported ? currentSnapshot.value.last_checked_at : null)
+})
