@@ -0,0 +1,48 @@
+package modeltrace
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestSnapshotAccountsSummaryUnmarshal(t *testing.T) {
+	raw := `{
+		"monitor_id": 1,
+		"model": "gpt-6-astra",
+		"accounts_summary": {
+			"model": "gpt-6-astra",
+			"total": 3,
+			"match": 2,
+			"suspect": 0,
+			"uncertain": 0,
+			"error": 1,
+			"active": 1
+		}
+	}`
+	var s Snapshot
+	require.NoError(t, json.Unmarshal([]byte(raw), &s))
+	require.Equal(t, int64(1), s.MonitorID)
+	require.Equal(t, "gpt-6-astra", s.Model)
+	require.NotNil(t, s.AccountsSummary)
+	require.Equal(t, "gpt-6-astra", s.AccountsSummary.Model)
+	require.Equal(t, 3, s.AccountsSummary.Total)
+	require.Equal(t, 2, s.AccountsSummary.Match)
+	require.Equal(t, 0, s.AccountsSummary.Suspect)
+	require.Equal(t, 0, s.AccountsSummary.Uncertain)
+	require.Equal(t, 1, s.AccountsSummary.Error)
+	require.Equal(t, 1, s.AccountsSummary.Active)
+
+	// Ensure no private account fields exist in AccountsSummary
+	encoded, err := json.Marshal(s.AccountsSummary)
+	require.NoError(t, err)
+	require.NotContains(t, string(encoded), "account_id")
+	require.NotContains(t, string(encoded), "name")
+	require.NotContains(t, string(encoded), "email")
+
+	rawNull := `{"monitor_id": 1, "model": "gpt-6-astra", "accounts_summary": null}`
+	var sNull Snapshot
+	require.NoError(t, json.Unmarshal([]byte(rawNull), &sNull))
+	require.Nil(t, sNull.AccountsSummary)
+}
diff --git a/backend/internal/pkg/modeltrace/client_test.go b/backend/internal/pkg/modeltrace/client_test.go
