--- /dev/null
+++ b/backend/internal/service/modeltrace_accounts_model_sync_test.go
@@ -0,0 +1,314 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/DATA-DOG/go-sqlmock"
+	"github.com/stretchr/testify/require"
+)
+
+// These are account capabilities, not a claim that ModelTrace has a calibrated
+// probe for every model. The caller supplies the models it can actually probe.
+func modelTraceSyncWhitelist(models ...string) map[string]any {
+	mapping := make(map[string]any, len(models))
+	for _, model := range models {
+		mapping[model] = model
+	}
+	return mapping
+}
+
+func expectModelTraceSyncActivity(mock sqlmock.Sqlmock) {
+	// Recent traffic for one model must not narrow the saved capability list.
+	mock.ExpectQuery("SELECT account_id, COUNT\\(\\*\\) FILTER .* FROM usage_logs").
+		WithArgs("{42}", sqlmock.AnyArg(), sqlmock.AnyArg()).
+		WillReturnRows(sqlmock.NewRows([]string{"account_id", "requests_10m", "last_request_at", "last_model"}).
+			AddRow(42, 1, time.Now().Add(-time.Minute), "gpt-6-astra"))
+	mock.ExpectQuery("SELECT account_id, model, COUNT\\(\\*\\) as req_count FROM usage_logs").
+		WithArgs("{42}", sqlmock.AnyArg()).
+		WillReturnRows(sqlmock.NewRows([]string{"account_id", "model", "req_count"}).
+			AddRow(42, "gpt-6-astra", 1))
+}
+
+func TestModelTraceAccountsService_ModelListSync(t *testing.T) {
+	sevenModels := []string{
+		"codex-auto-review", "gpt-5.5", "gpt-5.6-luna", "gpt-5.6-sol",
+		"gpt-5.6-terra", "gpt-6-astra", "gpt-reserve",
+	}
+	tests := []struct {
+		name      string
+		mapping   map[string]any
+		requested []string
+		want      []string
+	}{
+		{
+			name:      "stored astra only is not expanded to UI defaults",
+			mapping:   modelTraceSyncWhitelist("gpt-6-astra"),
+			requested: sevenModels,
+			want:      []string{"gpt-6-astra"},
+		},
+		{
+			name:      "all seven saved whitelist entries survive a matching request",
+			mapping:   modelTraceSyncWhitelist(sevenModels...),
+			requested: sevenModels,
+			want:      sevenModels,
+		},
+		{
+			name:      "caller probe filter is not replaced by the saved whitelist",
+			mapping:   modelTraceSyncWhitelist(sevenModels...),
+			requested: []string{"gpt-6-astra"},
+			want:      []string{"gpt-6-astra"},
+		},
+		{
+			name:      "request order and public mapping keys are preserved",
+			mapping:   map[string]any{"gpt-6-astra": "private-astra", "gpt-5.6-sol": "private-sol"},
+			requested: []string{" gpt-5.6-sol ", "private-sol", "", "gpt-6-astra", "private-astra"},
+			want:      []string{"gpt-5.6-sol", "gpt-6-astra"},
+		},
+		{
+			name:      "wildcard mappings expand only caller supplied concrete models",
+			mapping:   map[string]any{"gpt-5.6-*": "upstream-model"},
+			requested: []string{"gpt-5.6-sol", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-6-astra", "upstream-model"},
+			want:      []string{"gpt-5.6-sol", "gpt-5.6-luna", "gpt-5.6-terra"},
+		},
+		{
+			name:      "empty mapping allows caller candidates without injecting defaults",
+			mapping:   map[string]any{},
+			requested: []string{"gpt-6-astra", "gpt-5.6-sol"},
+			want:      []string{"gpt-6-astra", "gpt-5.6-sol"},
+		},
+		{
+			name:      "no supported intersection does not query activity",
+			mapping:   modelTraceSyncWhitelist("gpt-6-astra"),
+			requested: []string{"gpt-5.6-sol"},
+		},
+		{
+			name:    "missing model filter is not implicit capability discovery",
+			mapping: modelTraceSyncWhitelist(sevenModels...),
+		},
+		{
+			name:      "blank model filter is not implicit capability discovery",
+			mapping:   modelTraceSyncWhitelist(sevenModels...),
+			requested: []string{"", " "},
+		},
+	}
+
+	for _, accountType := range []string{AccountTypeAPIKey, AccountTypeOAuth} {
+		t.Run(accountType, func(t *testing.T) {
+			for _, tc := range tests {
+				t.Run(tc.name, func(t *testing.T) {
+					t.Setenv("MODELTRACE_ACTIVITY_EXCLUDE_KEY_IDS", "")
+					db, mock, err := sqlmock.New()
+					require.NoError(t, err)
+					t.Cleanup(func() { _ = db.Close() })
+					repo := &mockAccountRepoForModelTrace{accounts: []Account{{
+						ID: 42, Name: "231", Platform: PlatformOpenAI, Type: accountType,
+						Status: StatusActive, Schedulable: true,
+						Credentials: map[string]any{"model_mapping": tc.mapping},
+					}}}
+					if len(tc.want) > 0 {
+						expectModelTraceSyncActivity(mock)
+					}
+					resp, err := NewModelTraceAccountsService(repo, db).GetAccounts(context.Background(), tc.requested, true)
+					require.NoError(t, err)
+					if len(tc.want) == 0 {
+						require.Empty(t, resp.Accounts)
+					} else {
+						require.Len(t, resp.Accounts, 1)
+						require.Equal(t, int64(42), resp.Accounts[0].AccountID)
+						require.Equal(t, "231", resp.Accounts[0].Name)
+						require.Equal(t, tc.want, resp.Accounts[0].Models)
+						require.Equal(t, []string{"gpt-6-astra"}, resp.Accounts[0].RealModels10m)
+					}
+					require.NoError(t, mock.ExpectationsWereMet())
+				})
+			}
+		})
+	}
+}
+
+func TestModelTraceAccountsService_ModelListSyncAfterSavedMappingChanges(t *testing.T) {
+	t.Setenv("MODELTRACE_ACTIVITY_EXCLUDE_KEY_IDS", "")
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+
+	raw := modelTraceSyncWhitelist("gpt-6-astra")
+	repo := &mockAccountRepoForModelTrace{accounts: []Account{{
+		ID: 42, Name: "231", Platform: PlatformOpenAI, Type: AccountTypeAPIKey,
+		Status: StatusActive, Schedulable: true,
+		Credentials: map[string]any{"model_mapping": raw},
+	}}}
+	svc := NewModelTraceAccountsService(repo, db)
+	requested := []string{"gpt-6-astra", "gpt-5.6-sol", "gpt-5.6-luna"}
+	check := func(want []string) {
+		t.Helper()
+		expectModelTraceSyncActivity(mock)
+		resp, err := svc.GetAccounts(context.Background(), requested, true)
+		require.NoError(t, err)
+		require.Len(t, resp.Accounts, 1)
+		require.Equal(t, want, resp.Accounts[0].Models)
+		require.NoError(t, mock.ExpectationsWereMet())
+	}
+
+	// Simulate a repository returning an account with a populated mapping cache.
+	require.Equal(t, map[string]string{"gpt-6-astra": "gpt-6-astra"}, repo.accounts[0].GetModelMapping())
+	check([]string{"gpt-6-astra"})
+
+	// Same credentials/map pointer and same entry count: content changes still
+	// invalidate the signature, rather than freezing the first model forever.
+	delete(raw, "gpt-6-astra")
+	raw["gpt-5.6-sol"] = "private-sol"
+	check([]string{"gpt-5.6-sol"})
+
+	// Replacing the mapping after an account edit must be visible on next read.
+	repo.accounts[0].Credentials["model_mapping"] = modelTraceSyncWhitelist(requested...)
+	check(requested)
+
+	// Removed models must disappear too; a previous response is not a union.
+	repo.accounts[0].Credentials = map[string]any{"model_mapping": modelTraceSyncWhitelist("gpt-5.6-luna")}
+	check([]string{"gpt-5.6-luna"})
+}
+
+// Repository boundary without network access: reads are copies, so tests cannot
+// accidentally treat a mutation of a loaded account as a successful DB write.
+type modelTraceModelSyncRepo struct {
+	mockAccountRepoForModelTrace
+	accountWrites int
+	extraWrites   int
+}
+
+func (r *modelTraceModelSyncRepo) GetByID(_ context.Context, id int64) (*Account, error) {
+	for _, stored := range r.accounts {
+		if stored.ID != id {
+			continue
+		}
+		acc := stored
+		var err error
+		acc.Credentials, err = cloneAccountJSONMap(stored.Credentials)
+		if err != nil {
+			return nil, err
+		}
+		acc.Extra, err = cloneAccountJSONMap(stored.Extra)
+		return &acc, err
+	}
+	return nil, ErrAccountNotFound
+}
+
+func (r *modelTraceModelSyncRepo) Update(_ context.Context, account *Account) error {
+	for i := range r.accounts {
+		if r.accounts[i].ID == account.ID {
+			r.accounts[i] = *account
+			r.accountWrites++
+			return nil
+		}
+	}
+	return ErrAccountNotFound
+}
+
+func (r *modelTraceModelSyncRepo) UpdateExtra(_ context.Context, id int64, updates map[string]any) error {
+	for i := range r.accounts {
+		if r.accounts[i].ID == id {
+			if r.accounts[i].Extra == nil {
+				r.accounts[i].Extra = make(map[string]any)
+			}
+			for key, value := range updates {
+				r.accounts[i].Extra[key] = value
+			}
+			r.extraWrites++
+			return nil
+		}
+	}
+	return ErrAccountNotFound
+}
+
+func TestModelTraceAccountsService_ModelListSyncDiscoveryThenSave(t *testing.T) {
+	t.Setenv("MODELTRACE_ACTIVITY_EXCLUDE_KEY_IDS", "")
+	ctx := context.Background()
+	sevenModels := []string{
+		"codex-auto-review", "gpt-5.5", "gpt-5.6-luna", "gpt-5.6-sol",
+		"gpt-5.6-terra", "gpt-6-astra", "gpt-reserve",
+	}
+	repo := &modelTraceModelSyncRepo{mockAccountRepoForModelTrace: mockAccountRepoForModelTrace{accounts: []Account{{
+		ID: 42, Name: "231", Platform: PlatformOpenAI, Type: AccountTypeAPIKey,
+		Status: StatusActive, Schedulable: true,
+		Credentials: map[string]any{
+			"api_key": "test-key", "base_url": "https://provider.example/v1",
+			"model_mapping": modelTraceSyncWhitelist("gpt-6-astra"),
+		},
+	}}}}
+
+	// Deterministic complete upstream metadata avoids a registry HTTP fallback.
+	// These fixture capabilities do not declare calibrated ModelTrace probes.
+	var models []map[string]any
+	for _, model := range sevenModels {
+		models = append(models, map[string]any{
+			"slug": model, "display_name": model,
+			"supported_reasoning_levels": []map[string]string{{"effort": "low"}},
+			"input_modalities":           []string{"text"}, "context_window": 128000,
+		})
+	}
+	body, err := json.Marshal(map[string]any{"models": models})
+	require.NoError(t, err)
+	upstream := &httpUpstreamRecorder{resp: &http.Response{
+		StatusCode: http.StatusOK,
+		Header:     http.Header{"Content-Type": []string{"application/json"}},
+		Body:       io.NopCloser(strings.NewReader(string(body))),
+	}}
+	catalogService := &AccountTestService{accountRepo: repo, httpUpstream: upstream, cfg: upstreamModelSyncTestConfig()}
+	loaded, err := repo.GetByID(ctx, 42)
+	require.NoError(t, err)
+	catalog, err := catalogService.SyncUpstreamModelCatalog(ctx, loaded)
+	require.NoError(t, err)
+	require.ElementsMatch(t, sevenModels, catalog.Models)
+	require.Len(t, upstream.requests, 1)
+	require.Equal(t, 1, repo.extraWrites, "sync-upstream persists capability metadata only")
+	require.Zero(t, repo.accountWrites, "discovery must not silently widen routing permissions")
+	stored, err := repo.GetByID(ctx, 42)
+	require.NoError(t, err)
+	require.Equal(t, modelTraceSyncWhitelist("gpt-6-astra"), stored.Credentials["model_mapping"])
+	require.NotNil(t, stored.GetUpstreamModelMetadataSnapshot())
+
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+	modelTrace := NewModelTraceAccountsService(repo, db)
+	check := func(want []string) {
+		t.Helper()
+		expectModelTraceSyncActivity(mock)
+		resp, err := modelTrace.GetAccounts(ctx, sevenModels, true)
+		require.NoError(t, err)
+		require.Len(t, resp.Accounts, 1)
+		require.Equal(t, want, resp.Accounts[0].Models)
+		require.NoError(t, mock.ExpectationsWereMet())
+	}
+	check([]string{"gpt-6-astra"})
+
+	// Actual admin service update: redacted PUT omits the API key, but the
+	// non-sensitive model_mapping is replaced, not merged with an old whitelist.
+	admin := &adminServiceImpl{accountRepo: repo}
+	updated, err := admin.UpdateAccount(ctx, 42, &UpdateAccountInput{Credentials: map[string]any{
+		"base_url": "https://provider.example/v1", "model_mapping": modelTraceSyncWhitelist(sevenModels...),
+	}})
+	require.NoError(t, err)
+	require.Equal(t, 1, repo.accountWrites)
+	require.Equal(t, "test-key", updated.Credentials["api_key"])
+	require.Equal(t, modelTraceSyncWhitelist(sevenModels...), updated.Credentials["model_mapping"])
+	check(sevenModels) // no timer, worker, or cache invalidation needed on the host
+
+	detail, err := admin.GetAccount(ctx, 42)
+	require.NoError(t, err)
+	require.Equal(t, modelTraceSyncWhitelist(sevenModels...), detail.Credentials["model_mapping"])
+
+	_, err = admin.UpdateAccount(ctx, 42, &UpdateAccountInput{Credentials: map[string]any{
+		"base_url": "https://provider.example/v1", "model_mapping": modelTraceSyncWhitelist("gpt-5.6-sol"),
+	}})
+	require.NoError(t, err)
+	require.Equal(t, 2, repo.accountWrites)
+	check([]string{"gpt-5.6-sol"})
+}
