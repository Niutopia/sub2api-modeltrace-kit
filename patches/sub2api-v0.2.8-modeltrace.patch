diff --git a/backend/internal/service/openai_gateway_modeltrace_probe.go b/backend/internal/service/openai_gateway_modeltrace_probe.go
new file mode 100644
index 000000000..253b746d8
--- /dev/null
+++ b/backend/internal/service/openai_gateway_modeltrace_probe.go
@@ -0,0 +1,130 @@
+package service
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+)
+
+const (
+	openAIModelTraceProbeSignatureHeader = "X-Sub2API-ModelTrace-Signature"
+	openAIModelTraceProbeStateKey        = "_openai_modeltrace_probe_state"
+	openAIModelTraceProbeTimeout         = 120 * time.Second
+	openAIModelTraceProbeTimeoutMin      = 60 * time.Second
+	openAIModelTraceProbeTimeoutMax      = 300 * time.Second
+	openAIModelTraceProbeTimeoutEnv      = "MODELTRACE_PROBE_TIMEOUT_SECONDS"
+)
+
+// Neither an inbound header nor a UA alone can create this context marker.
+// It deliberately affects inference cancellation only, not billing contexts.
+type openAIModelTraceProbeContextKey struct{}
+
+// Cache negative results too: removing (or replacing) the header on a later
+// failover must not change the decision. Never retain the signature or secret.
+type openAIModelTraceProbeState struct {
+	trusted  bool
+	deadline time.Time
+}
+
+func openAIModelTraceProbeContext(ctx context.Context, c *gin.Context) (context.Context, context.CancelFunc) {
+	return openAIModelTraceProbeContextWithTimeout(ctx, c, resolveOpenAIModelTraceProbeTimeout())
+}
+
+func resolveOpenAIModelTraceProbeTimeout() time.Duration {
+	seconds, err := strconv.Atoi(strings.TrimSpace(os.Getenv(openAIModelTraceProbeTimeoutEnv)))
+	if err != nil || seconds < int(openAIModelTraceProbeTimeoutMin/time.Second) || seconds > int(openAIModelTraceProbeTimeoutMax/time.Second) {
+		return openAIModelTraceProbeTimeout
+	}
+	// Bounds are checked as integers before converting to time.Duration, so a
+	// huge accepted int can never overflow the duration multiplication.
+	return time.Duration(seconds) * time.Second
+}
+
+// This controls the main-site request context only. The sidecar has its own
+// wall-clock timeout, so end-to-end probe duration is bounded by whichever
+// layer is shorter until both components are configured to the same value.
+// Each Forward owns its cancel, but all attempts share the first absolute
+// deadline. Caching a child context here would reuse a canceled prior attempt.
+func openAIModelTraceProbeContextWithTimeout(ctx context.Context, c *gin.Context, timeout time.Duration) (context.Context, context.CancelFunc) {
+	noop := func() {}
+	if c == nil || c.Request == nil {
+		return ctx, noop
+	}
+
+	// Consume this internal header before any forwarding, even when invalid or
+	// already checked. Handle noncanonical map keys and reject duplicate values.
+	var signatures []string
+	for key, values := range c.Request.Header {
+		if strings.EqualFold(key, openAIModelTraceProbeSignatureHeader) {
+			signatures = append(signatures, values...)
+			delete(c.Request.Header, key)
+		}
+	}
+
+	state, _ := c.Get(openAIModelTraceProbeStateKey)
+	probe, checked := state.(*openAIModelTraceProbeState)
+	if !checked || probe == nil {
+		probe = &openAIModelTraceProbeState{}
+		c.Set(openAIModelTraceProbeStateKey, probe)
+		key := getAPIKeyFromContext(c)
+		if key == nil || key.User == nil || key.User.Role != RoleAdmin || len(signatures) != 1 {
+			return ctx, noop
+		}
+		userAgents := c.Request.Header.Values("User-Agent")
+		if len(userAgents) != 1 || !isOpenAIModelTraceProbeUserAgent(userAgents[0]) {
+			return ctx, noop
+		}
+		secret := os.Getenv("MODELTRACE_SECRET")
+		if strings.TrimSpace(secret) == "" || len(signatures[0]) != sha256.Size*2 {
+			return ctx, noop
+		}
+		signature, err := hex.DecodeString(signatures[0])
+		if err != nil {
+			return ctx, noop
+		}
+		mac := hmac.New(sha256.New, []byte(secret))
+		_, _ = mac.Write([]byte(userAgents[0]))
+		if !hmac.Equal(signature, mac.Sum(nil)) {
+			return ctx, noop
+		}
+		probe.trusted = true
+		probe.deadline = time.Now().Add(timeout)
+	}
+	if !probe.trusted {
+		return ctx, noop
+	}
+	if ctx == nil {
+		ctx = c.Request.Context()
+	}
+	ctx = context.WithValue(ctx, openAIModelTraceProbeContextKey{}, true)
+	return context.WithDeadline(ctx, probe.deadline)
+}
+
+func isOpenAIModelTraceProbeUserAgent(ua string) bool {
+	const prefix = "ModelTraceProbe/"
+	if !strings.HasPrefix(ua, prefix) {
+		return false
+	}
+	id := strings.TrimPrefix(ua, prefix)
+	if len(id) != 36 {
+		return false
+	}
+	parsed, err := uuid.Parse(id)
+	return err == nil && parsed != uuid.Nil && parsed.String() == strings.ToLower(id)
+}
+
+func isTrustedOpenAIModelTraceProbeContext(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	trusted, _ := ctx.Value(openAIModelTraceProbeContextKey{}).(bool)
+	return trusted
+}
