+		Credentials: map[string]any{"model_mapping": map[string]any{"gpt-6-astra": "astra-upstream-id"}},
+	}
+	paused := []ModelTracePausedModel{
+		{Model: "astra-upstream-id", Until: "2026-09-25T01:00:00Z"},
+		{Model: "unrelated-scope", Until: "2026-09-25T02:00:00Z"},
+	}
+	got := modelTracePausedByRequestedModel(acc, []string{"gpt-6-astra"}, paused)
+	require.Equal(t, []ModelTracePausedModel{
+		{Model: "gpt-6-astra", Until: "2026-09-25T01:00:00Z"},
+		{Model: "unrelated-scope", Until: "2026-09-25T02:00:00Z"},
+	}, got)
+}
