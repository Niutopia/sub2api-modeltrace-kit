+    const { wrapper, polling } = mountHarness([{ id: 1, model: 'gpt-6-astra' }])
+    polling.notifyRunSubmitted(1)
+    expect(polling.stateFor(1).queued).toBe(true)
+    getModelTrace.mockResolvedValue(snapshot(1, 'gpt-6-astra', { queued: false }))
+    await polling.refreshMonitor(1)
+    expect(polling.stateFor(1).queued).toBe(false)
+    await vi.advanceTimersByTimeAsync(MODEL_TRACE_POLL_INTERVAL_MS)
+    expect(getModelTrace).toHaveBeenCalledTimes(3)
+    old.resolve(snapshot(1, 'gpt-6-astra', { running: true }))
+    await flushPromises()
+    expect(polling.stateFor(1).running).toBe(false)
+    wrapper.unmount()
+  })
+
+  it('rejects an older microsecond read view but accepts a fresh view of older historical results', async () => {
+    const first = snapshot(1, 'gpt-6-astra', { snapshot_at: '2026-09-25T00:00:00.123456+00:00', running: true, queued: false, last_checked_at: '2026-09-24T00:00:00Z' })
+    getModelTrace.mockResolvedValue(first)
+    const { wrapper, polling } = mountHarness([{ id: 1, model: 'gpt-6-astra' }])
+    await flushPromises()
+    getModelTrace.mockResolvedValue({ ...first, snapshot_at: '2026-09-25T00:00:00.123455+00:00', running: false, last_checked_at: '2026-09-25T00:00:00Z' })
+    await polling.refreshMonitor(1)
+    expect(polling.stateFor(1).running).toBe(true)
+    expect(polling.stateFor(1).snapshot?.last_checked_at).toBe('2026-09-24T00:00:00Z')
+    getModelTrace.mockResolvedValue({ ...first, snapshot_at: '2026-09-25T00:00:00.123457+00:00', running: false, last_checked_at: '2026-09-23T00:00:00Z' })
+    await polling.refreshMonitor(1)
+    expect(polling.stateFor(1).running).toBe(false)
+    expect(polling.stateFor(1).snapshot?.last_checked_at).toBe('2026-09-23T00:00:00Z')
+    wrapper.unmount()
+  })
+})
+
+it('retains a read watermark through transient errors instead of accepting an older recovery response', async () => {
+  const fresh = snapshot(1, 'gpt-6-astra', { snapshot_at: '2026-09-25T00:00:00.123456Z', queued: false })
+  getModelTrace.mockResolvedValue(fresh)
+  const { wrapper, polling } = mountHarness([{ id: 1, model: 'gpt-6-astra' }])
+  await flushPromises()
+  getModelTrace.mockRejectedValueOnce(new Error('temporary network failure'))
+  await polling.refreshMonitor(1)
+  expect(polling.stateFor(1).unavailable).toBe(true)
+  getModelTrace.mockResolvedValue({ ...fresh, snapshot_at: '2026-09-25T00:00:00.123455Z', running: true })
+  await polling.refreshMonitor(1)
+  expect(polling.stateFor(1)).toMatchObject({ unavailable: true, snapshot: null, running: false })
+  getModelTrace.mockResolvedValue({ ...fresh, snapshot_at: '2026-09-25T00:00:00.123457Z' })
+  await polling.refreshMonitor(1)
+  expect(polling.stateFor(1).unavailable).toBe(false)
+  wrapper.unmount()
+})
