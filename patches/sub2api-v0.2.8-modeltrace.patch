+type internalHandlerMockAccountRepo struct {
+	service.AccountRepository
+	accounts           map[int64]*service.Account
+	lastSetLimitScope  string
+	lastSetLimitReset  time.Time
+	lastSetLimitReason string
+	clearScopeResult   bool
+}
+
+func (m *internalHandlerMockAccountRepo) ListAllWithFilters(_ context.Context, _, _, status, _ string, _ int64, _ string) ([]service.Account, error) {
+	var res []service.Account
+	for _, acc := range m.accounts {
+		if status == "" || acc.Status == status {
+			res = append(res, *acc)
+		}
+	}
+	return res, nil
+}
+
+func (m *internalHandlerMockAccountRepo) GetByID(_ context.Context, id int64) (*service.Account, error) {
+	acc, ok := m.accounts[id]
+	if !ok {
+		return nil, service.ErrAccountNotFound
+	}
+	return acc, nil
+}
+
+func (m *internalHandlerMockAccountRepo) SetModelRateLimit(_ context.Context, id int64, scope string, resetAt time.Time, reason ...string) error {
+	m.lastSetLimitScope = scope
+	m.lastSetLimitReset = resetAt
+	if len(reason) > 0 {
+		m.lastSetLimitReason = reason[0]
+	}
+	return nil
+}
+
+func (m *internalHandlerMockAccountRepo) ClearModelRateLimitScopeIfReason(_ context.Context, id int64, scope, reason string) (bool, error) {
+	if reason != "modeltrace_suspect" {
+		return false, nil
+	}
+	return m.clearScopeResult, nil
+}
+
+func TestInternalModelTraceHandler_AuthenticationAndFlow(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("MODELTRACE_SECRET", "internal-secret")
+	t.Setenv("MODELTRACE_ACTIVITY_EXCLUDE_KEY_IDS", "5,10")
+
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+
+	repo := &internalHandlerMockAccountRepo{
+		accounts: map[int64]*service.Account{
+			42: {
+				ID:          42,
+				Name:        "test-acc@example.com",
+				Platform:    service.PlatformOpenAI,
+				Type:        service.AccountTypeOAuth,
+				Status:      service.StatusActive,
+				Schedulable: true,
+				Credentials: map[string]any{"model_mapping": map[string]any{"gpt-5.6-sol": "gpt-5.6-sol"}},
+			},
+		},
+	}
+
+	svc := service.NewModelTraceAccountsService(repo, db)
+	h := NewInternalModelTraceHandler(svc)
+
+	r := gin.New()
+	r.GET("/accounts", h.GetAccounts)
+
+	// 1. Auth fail - no header
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/accounts", nil))
+	require.Equal(t, http.StatusUnauthorized, w.Code)
+
+	// 2. Auth fail - wrong token
+	w = httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/accounts", nil)
+	req.Header.Set("Authorization", "Bearer invalid-token")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusUnauthorized, w.Code)
+
+	// 3. Auth success + exclude list + model filter
+	now := time.Now()
+	rows := sqlmock.NewRows([]string{"account_id", "requests_10m", "last_request_at", "last_model"}).
+		AddRow(42, 5, now.Add(-time.Minute), "gpt-5.6-sol")
+
+	mock.ExpectQuery("SELECT account_id, COUNT\\(\\*\\) FILTER .* FROM usage_logs").
+		WillReturnRows(rows)
+
+	modelRows := sqlmock.NewRows([]string{"account_id", "model", "req_count"}).
+		AddRow(42, "gpt-5.6-sol", 5)
+
+	mock.ExpectQuery("SELECT account_id, model, COUNT\\(\\*\\) as req_count FROM usage_logs").
+		WillReturnRows(modelRows)
+
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/accounts?models=gpt-5.6-sol,gpt-4-unknown", nil)
+	req.Header.Set("Authorization", "Bearer internal-secret")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	// Contract A1: top-level payload without the site-wide envelope.
+	var resp service.ModelTraceAccountsResponse
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	require.Len(t, resp.Accounts, 1)
+	require.Equal(t, int64(42), resp.Accounts[0].AccountID)
+	require.Equal(t, []string{"gpt-5.6-sol"}, resp.Accounts[0].Models)
+	require.Equal(t, int64(5), resp.Accounts[0].RealRequests10m)
+	require.Equal(t, "gpt-5.6-sol", *resp.Accounts[0].LastRealModel)
+	require.Equal(t, []string{"gpt-5.6-sol"}, resp.Accounts[0].RealModels10m)
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestInternalModelTraceHandler_PauseModel(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("MODELTRACE_SECRET", "secret")
+
+	repo := &internalHandlerMockAccountRepo{
+		accounts: map[int64]*service.Account{
+			1: {
+				ID:          1,
+				Platform:    service.PlatformOpenAI,
+				Credentials: map[string]any{"model_mapping": map[string]any{"gpt-5.6-sol": "upstream-sol"}},
+			},
+			2: {
+				ID:          2,
+				Platform:    service.PlatformAnthropic,
+				Credentials: map[string]any{"model_mapping": map[string]any{"claude-sonnet": "claude-sonnet"}},
+			},
+			3: {
+				ID:       3,
+				Platform: service.PlatformOpenAI,
+				Extra: map[string]any{
+					"model_rate_limits": map[string]any{
+						"upstream-sol": map[string]any{
+							"rate_limit_reset_at": time.Now().Add(2 * time.Hour).UTC().Format(time.RFC3339),
+							"reason":              "modeltrace_suspect",
+						},
+					},
+				},
+				Credentials: map[string]any{"model_mapping": map[string]any{"gpt-5.6-sol": "upstream-sol"}},
+			},
+		},
+	}
+
+	svc := service.NewModelTraceAccountsService(repo, nil)
+	h := NewInternalModelTraceHandler(svc)
+	r := gin.New()
+	r.POST("/accounts/:account_id/model-pause", h.PauseModel)
+
+	// 1. 未授权 401
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/accounts/1/model-pause", strings.NewReader(`{"model":"gpt-5.6-sol","minutes":60}`))
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusUnauthorized, w.Code)
+
+	// 2. 非 openai 404
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/accounts/2/model-pause", strings.NewReader(`{"model":"claude-sonnet","minutes":60}`))
+	req.Header.Set("Authorization", "Bearer secret")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusNotFound, w.Code)
+
+	// 3. minutes 越界 400 (< 1 或 > 1440)
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/accounts/1/model-pause", strings.NewReader(`{"model":"gpt-5.6-sol","minutes":0}`))
+	req.Header.Set("Authorization", "Bearer secret")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusBadRequest, w.Code)
+
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/accounts/1/model-pause", strings.NewReader(`{"model":"gpt-5.6-sol","minutes":1441}`))
+	req.Header.Set("Authorization", "Bearer secret")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusBadRequest, w.Code)
+
+	// 4. pause 成功调用 SetModelRateLimit（scope 为映射后模型、reason 正确）
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/accounts/1/model-pause", strings.NewReader(`{"model":"gpt-5.6-sol","minutes":60,"evidence":"repeated_other_model gpt-5.6-luna"}`))
+	req.Header.Set("Authorization", "Bearer secret")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	var pauseRes service.ModelTracePauseResult
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &pauseRes))
+	require.True(t, pauseRes.Paused)
+	require.True(t, pauseRes.Changed)
+	require.NotEmpty(t, pauseRes.Until)
+	require.Equal(t, "upstream-sol", repo.lastSetLimitScope)
+	require.Equal(t, "modeltrace_suspect", repo.lastSetLimitReason)
+
+	// 5. 已有更晚限流时 changed=false 且不写 SetModelRateLimit
+	repo.lastSetLimitScope = ""
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/accounts/3/model-pause", strings.NewReader(`{"model":"gpt-5.6-sol","minutes":60}`))
+	req.Header.Set("Authorization", "Bearer secret")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	var pauseResEarlier service.ModelTracePauseResult
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &pauseResEarlier))
+	require.True(t, pauseResEarlier.Paused)
+	require.False(t, pauseResEarlier.Changed)
+	require.Empty(t, repo.lastSetLimitScope)
+}
