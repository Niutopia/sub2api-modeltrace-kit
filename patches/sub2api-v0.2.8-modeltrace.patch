+  }
+  if (isOlderTraceSnapshot(item.snapshot_at, currentTraceItem.value?.snapshot_at)) return
+  currentTraceItem.value = item
+}, { immediate: true, flush: 'sync' })
+
+
+const isVisible = computed(() => {
+  if (props.unavailable) return false
+  if (!currentTraceItem.value) return false
+  return modelRows.value.length > 0
+})
+
+const availableModels = computed(() => {
+  return [...new Set(currentTraceItem.value?.models || [])]
+})
+
+// Preserve a valid user choice; next_model describes a job, not form state.
+watch(availableModels, (models) => {
+  if (models.includes(selectedModel.value)) return
+  const pendingModel = currentTraceItem.value?.next_model
+  selectedModel.value = pendingModel && models.includes(pendingModel) ? pendingModel : (models[0] || '')
+}, { immediate: true, flush: 'sync' })
+
+const headerTitle = computed(() => {
+  const item = currentTraceItem.value
+  if (!item) return `#${props.accountId}`
+  if (item.cluster_id && item.cluster_name) {
+    const keyCount = item.member_account_ids?.length || 0
+    return `${item.cluster_name}（${keyCount} 个 Key）`
+  }
+  return item.name || `#${props.accountId}`
+})
+
+const notParticipating = computed(() => currentTraceItem.value?.participating === false)
+
+interface MemberRow {
+  accountId: number
+  name: string
+  participating: boolean
+  reasonText: string
+  latest: AccountTraceLatest | null
+  statusText: string
+  timeText: string
+}
+
+const memberRows = computed<MemberRow[]>(() => {
+  const members = currentTraceItem.value?.members || []
+  const model = selectedModel.value
+  return members
+    .filter((m) => !model || m.models.includes(model) || m.latest_by_model?.[model])
+    .map((m) => {
+      const latest = (model && m.latest_by_model?.[model]) || null
+      return {
+        accountId: m.account_id,
+        name: m.name || `#${m.account_id}`,
+        participating: m.participating !== false,
+        reasonText: inactiveReasonLabel(m.inactive_reason),
+        latest,
+        statusText: latest ? (STATUS_LABELS[latest.status] || latest.status) : '未检测',
+        timeText: latest ? shortTime(latest.checked_at) : '',
+      }
+    })
+})
+
+const isRunningOrQueued = computed(() => {
+  return props.optimisticQueued || currentTraceItem.value?.running === true || currentTraceItem.value?.queued === true || submitting.value
+})
+
+// Short on purpose: the badge sits in a narrow status column.
+const runningLabel = computed(() => (currentTraceItem.value?.running === true ? '检测中' : '排队中'))
+
+const isRetesting = computed(() => {
+  const p = currentTraceItem.value?.retest_progress
+  return !!p && typeof p.done === 'number' && typeof p.total === 'number' && p.total > 0
+})
+
+/**
+ * 汇总“最差”模型结论：
+ * 可疑 > 不确定 > 检测失败 > 一致；
+ * interrupted 和未检测不参与；
+ * 全部没有结果时显示“未检测”。
+ */
+type WorstRank = 0 | 1 | 2 | 3 | 4 // 4: suspect, 3: uncertain, 2: error, 1: match, 0: none/interrupted
+
+interface WorstEvaluation {
+  rank: WorstRank
+  latest: AccountTraceLatest | null
+}
+
+const worstEvaluation = computed<WorstEvaluation>(() => {
+  const item = currentTraceItem.value
+  if (!item) return { rank: 0, latest: null }
+
+  // Check per_model if present, else fallback to latest
+  let list: (AccountTraceLatest | null)[] = []
+  if (Array.isArray(item.per_model) && item.per_model.length > 0) {
+    list = item.per_model.filter((pm) => item.models.includes(pm.model)).map((pm) => pm.latest)
+  } else if (item.latest && item.models.includes(item.latest.model)) {
+    list = [item.latest]
+  }
+
+  let worstRank: WorstRank = 0
+  let worstLatest: AccountTraceLatest | null = null
+
+  for (const l of list) {
+    if (!l) continue
+    const s = l.status
+    if (s === 'interrupted' || s === 'reset' || s === 'not_tested') continue
+
+    let r: WorstRank = 0
+    if (s === 'suspect') r = 4
+    else if (s === 'uncertain') r = 3
+    else if (s === 'error' || s === 'account_unavailable') r = 2
+    else if (s === 'match') r = 1
+
+    if (r > worstRank) {
+      worstRank = r
+      worstLatest = l
+    }
+  }
+
+  return { rank: worstRank, latest: worstLatest }
+})
+
+const tagStatus = computed<'running' | 'suspect' | 'uncertain' | 'error' | 'match' | 'waiting'>(() => {
+  if (isRunningOrQueued.value) return 'running'
+  const { rank } = worstEvaluation.value
+  if (rank === 4) return 'suspect'
+  if (rank === 3) return 'uncertain'
+  if (rank === 2) return 'error'
+  if (rank === 1) return 'match'
+  return 'waiting'
+})
+
+const modeLabel = computed(() => {
+  if (notParticipating.value) return '未参与调度'
+  if (currentTraceItem.value?.schedule_mode === 'manual') return '手动调度'
+  const mode = currentTraceItem.value?.mode
+  if (mode === 'active') return '活跃·5分钟'
+  return '空闲·1小时'
+})
+
+const modeTooltip = computed(() => {
+  return `检测模式：${modeLabel.value}`
+})
+
+const modeBadgeClass = computed(() => {
+  const mode = currentTraceItem.value?.mode
+  if (mode === 'active') {
+    return 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300'
+  }
+  return 'bg-gray-100 text-gray-700 dark:bg-dark-700 dark:text-gray-300'
+})
+
+const tagText = computed(() => {
+  const text = resultTagText.value
+  // Last result stays visible, but must not read like a live verdict.
+  return notParticipating.value ? `停测 · ${text.replace(/^[✓⚠]\s*/, '')}` : text
+})
+
+const resultTagText = computed(() => {
+  if (availableModels.value.length === 0 && !isRunningOrQueued.value) return '历史结果'
+  const { latest } = worstEvaluation.value
+  const prob = latest && isProbability(latest.target_probability)
+    ? percent(latest.target_probability)
+    : ''
+
+  switch (tagStatus.value) {
+    case 'match':
+      return prob ? `✓ 一致 ${prob}` : '✓ 一致'
+    case 'suspect':
+      if (modelRows.value.some((row) => row.probeable && row.pausedText)) return '⚠ 可疑 · 已暂停'
+      return prob ? `⚠ 可疑 ${prob}` : '⚠ 可疑'
+    case 'uncertain':
+      return prob ? `不确定 ${prob}` : '不确定'
+    case 'error':
+      return '检测失败'
+    case 'running':
+      return runningLabel.value
+    case 'waiting':
+      return '未检测'
+  }
+  return ''
+})
+
+const tagBadgeClass = computed(() => {
+  if (notParticipating.value) {
+    return 'bg-gray-100 text-gray-500 hover:bg-gray-200 dark:bg-dark-700 dark:text-gray-400 dark:hover:bg-dark-600 ring-1 ring-gray-400/20'
+  }
+  switch (tagStatus.value) {
+    case 'match':
+      return 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/50 ring-1 ring-emerald-500/20'
+    case 'suspect':
+      return 'bg-red-50 text-red-700 hover:bg-red-100 dark:bg-red-950/40 dark:text-red-300 dark:hover:bg-red-900/50 ring-1 ring-red-500/20'
+    case 'uncertain':
+      return 'bg-amber-50 text-amber-700 hover:bg-amber-100 dark:bg-amber-950/40 dark:text-amber-300 dark:hover:bg-amber-900/50 ring-1 ring-amber-500/20'
+    case 'running':
+      return 'bg-blue-50 text-blue-700 hover:bg-blue-100 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:bg-blue-900/50 ring-1 ring-blue-500/20'
+    case 'error':
+    case 'waiting':
+    default:
+      return 'bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-dark-700 dark:text-gray-300 dark:hover:bg-dark-600 ring-1 ring-gray-400/20'
+  }
+})
+
+const ariaLabel = computed(() => {
+  const plainText = tagText.value.replace(/^[✓⚠]\s*/, '')
+  return `账号一致性：${plainText}（${modeLabel.value}），点击查看详情`
+})
+
+// 一模型一行模型列表计算
+interface ModelRowData {
+  probeable: boolean
+  pausedText: string
+  model: string
+  latest: AccountTraceLatest | null
+  relativeTime: string
+  keyNote: string
+  probText: string
+  bestCandidateText: string
+  bestCandidate: string
+  bestCandidateProb: string
+  detailText: string
+  reasonText: string
+  effortText: string
+  dots: (AccountTraceLatest | null)[]
+}
+
+const modelRows = computed<ModelRowData[]>(() => {
+  const item = currentTraceItem.value
+  if (!item) return []
+
+  const perModelMap = new Map<string, AccountTracePerModel>()
+  if (Array.isArray(item.per_model)) {
+    for (const pm of item.per_model) {
+      perModelMap.set(pm.model, pm)
+    }
+  }
+
+  const models = [...new Set([
+    ...availableModels.value,
+    ...perModelMap.keys(),
+    ...(item.latest ? [item.latest.model] : []),
+    ...(item.history || []).map((round) => round.model),
+  ])]
+  return models.map((model) => {
+    const pm = perModelMap.get(model)
+    const probeable = availableModels.value.includes(model)
+    // Fallback: if no per_model structure but item.latest is for this model
+    let latest: AccountTraceLatest | null = pm?.latest ?? null
+    let history: AccountTraceLatest[] = pm?.history ?? []
+    if (!pm) {
+      history = (item.history || []).filter((round) => round.model === model)
+      latest = item.latest?.model === model ? item.latest
+        : [...history].sort((a, b) => Date.parse(b.checked_at) - Date.parse(a.checked_at))[0] ?? null
+    }
+
+    const relativeTime = latest?.checked_at ? formatRelativeTime(latest.checked_at) : ''
+    const pausedMs = pm?.paused_until ? Date.parse(pm.paused_until) : NaN
+    const pausedText = probeable && Number.isFinite(pausedMs) && pausedMs > Date.now()
+      ? new Date(pausedMs).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false })
+      : ''
+
+    // Key note for upstream clusters
+    let keyNote = ''
+    if (item.cluster_id && latest?.account_id) {
+      keyNote = `Key ID ${latest.account_id}`
+    }
+
+    const probText = latest && isProbability(latest.target_probability)
+      ? percent(latest.target_probability)
+      : ''
+
+    let bestCandidateText = ''
+    if (latest?.best_model && latest.best_model !== model) {
+      bestCandidateText = latest.best_model
+    }
+    // Only worth showing when the fingerprint points somewhere other than the target.
+    const bestCandidate = latest?.best_model && latest.best_model !== model ? latest.best_model : ''
+    const top = Array.isArray(latest?.ranking) ? latest!.ranking![0] : undefined
+    const bestCandidateProb = top && top.model === bestCandidate && isProbability(top.probability)
+      ? percent(top.probability)
+      : ''
+    const detailCode = latest?.message_code || ''
+    const detailText = detailCode && Object.prototype.hasOwnProperty.call(MESSAGE_LABELS, detailCode)
+      ? MESSAGE_LABELS[detailCode]
+      : ''
+
+    let reasonText = ''
+    if (latest?.status === 'error' || latest?.message_code === 'account_unavailable') {
+      const code = latest.message_code
+      reasonText = SHORT_MESSAGE_LABELS[code] || MESSAGE_LABELS[code] || ''
+    }
+
+    let effortText = ''
+    const effort = latest?.reasoning_effort?.trim()
+    if (effort && effort !== 'none') {
+      effortText = `思考 ${effort}`
+    }
+
+    const rounds = [...history]
+      .sort((a, b) => Date.parse(a.checked_at) - Date.parse(b.checked_at))
+      .slice(-HISTORY_LIMIT)
+    const dots = [...Array<null>(HISTORY_LIMIT - rounds.length).fill(null), ...rounds]
+
+    return {
+      probeable,
+      model,
+      latest,
+      relativeTime,
+      keyNote,
+      pausedText,
+      probText,
+      bestCandidateText,
+      bestCandidate,
+      bestCandidateProb,
+      detailText,
+      reasonText,
+      effortText,
+      dots,
+    }
+  })
+})
+
+function getModelConclusionLabel(latest: AccountTraceLatest | null): string {
+  if (!latest) return '未检测'
+  if (latest.status === 'match') {
+    const prob = isProbability(latest.target_probability) ? ` ${percent(latest.target_probability)}` : ''
+    return `一致${prob}`
+  }
+  if (latest.status === 'suspect') return '可疑'
+  if (latest.status === 'uncertain') return '不确定'
+  if (latest.status === 'error' || latest.status === 'account_unavailable') return '检测失败'
+  if (latest.status === 'interrupted') return '被中断'
+  return STATUS_LABELS[latest.status] || latest.status || '未检测'
+}
+
+function getModelBadgeClass(latest: AccountTraceLatest | null): string {
+  if (!latest) return 'bg-gray-100 text-gray-600 dark:bg-dark-700 dark:text-gray-400'
+  if (latest.status === 'match') {
+    return 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300'
+  }
+  if (latest.status === 'suspect') {
+    return 'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300'
+  }
+  if (latest.status === 'uncertain') {
+    return 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300'
+  }
+  if (latest.status === 'error' || latest.status === 'account_unavailable') {
+    return 'bg-gray-200 text-gray-700 dark:bg-dark-600 dark:text-gray-300'
+  }
+  if (latest.status === 'interrupted') {
+    return 'bg-gray-100 text-gray-600 dark:bg-dark-700 dark:text-gray-400'
+  }
+  return 'bg-gray-100 text-gray-600 dark:bg-dark-700 dark:text-gray-400'
+}
+
+function dotClass(round: AccountTraceLatest | null): string {
+  if (!round) return 'bg-gray-200 dark:bg-dark-700'
+  if (round.status === 'match') return 'bg-emerald-500'
+  if (round.status === 'suspect') return 'bg-red-500'
+  if (round.status === 'uncertain') return 'bg-amber-400'
+  if (round.status === 'interrupted') return 'bg-gray-400 dark:bg-dark-500'
+  return 'bg-gray-400 dark:bg-dark-500'
+}
+
+function dotTitle(round: AccountTraceLatest | null): string {
+  if (!round) return '暂无记录'
+  const time = formatTime(round.checked_at)
+  const conclusion = STATUS_LABELS[round.status] || round.status || '无有效结果'
+  const prob = isProbability(round.target_probability) ? ` · ${percent(round.target_probability)}` : ''
+  return `${time} · ${conclusion}${prob}`
+}
+
+const nextRunShort = computed(() => {
+  if (props.unavailable) return '暂不可用'
+  if (!currentTraceItem.value) return props.loading ? '读取中' : '—'
+  if (currentTraceItem.value.running) return '本轮结束后更新'
+  if (currentTraceItem.value.queued) return shortTime(currentTraceItem.value.available_at ?? currentTraceItem.value.next_run_at)
+  if (notParticipating.value) return '暂停探测'
+  if (currentTraceItem.value.schedule_mode === 'manual') return '手动触发'
+  return currentTraceItem.value.next_run_at ? shortTime(currentTraceItem.value.next_run_at) : '暂无计划'
+})
+
+const canRun = computed(() => {
+  return !props.unavailable && !!currentTraceItem.value && !notParticipating.value && availableModels.value.includes(selectedModel.value) && !isRunningOrQueued.value && !submitting.value
+})
+
+function isProbability(value: number | null | undefined): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= 1
+}
+
+function percent(probability: number): string {
+  if (probability > 0 && probability < 0.001) return '<0.1%'
+  return `${(probability * 100).toFixed(1)}%`
+}
+
+function shortTime(value: string | null | undefined): string {
+  if (!value) return '—'
+  const date = new Date(value)
+  if (!Number.isFinite(date.getTime())) return '—'
+  const hm = date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false })
+  const now = new Date()
+  const sameDay = date.getFullYear() === now.getFullYear() && date.getMonth() === now.getMonth() && date.getDate() === now.getDate()
+  return sameDay ? hm : `${date.getMonth() + 1}/${date.getDate()} ${hm}`
+}
+
+function formatTime(value: string | null | undefined): string {
+  if (!value) return '—'
+  const date = new Date(value)
+  return Number.isFinite(date.getTime()) ? date.toLocaleString('zh-CN', { hour12: false }) : '—'
+}
+
+function formatRelativeTime(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const ts = Date.parse(iso)
+  if (Number.isNaN(ts)) return ''
+  const diffSec = Math.max(0, Math.floor((Date.now() - ts) / 1000))
+  if (diffSec < 60) return `${diffSec} 秒前`
+  const diffMin = Math.floor(diffSec / 60)
+  if (diffMin < 60) return `${diffMin} 分钟前`
+  const diffHour = Math.floor(diffMin / 60)
+  if (diffHour < 24) return `${diffHour} 小时前`
+  const diffDay = Math.floor(diffHour / 24)
+  return `${diffDay} 天前`
+}
+
+function checkMobile() {
+  if (typeof window === 'undefined') return
+  isMobile.value = window.innerWidth < 640
+}
+
+function updatePosition() {
+  if (isMobile.value || !triggerRef.value) return
+  const rect = getLayoutRect(triggerRef.value)
+  const viewport = getLayoutViewport()
+  const popoverWidth = 384
+  const viewportPadding = 12
+  const gap = 8
+
+  let left = rect.right - popoverWidth
+  if (left < viewportPadding) {
+    left = Math.max(viewportPadding, rect.left)
+  }
+  if (left + popoverWidth > viewport.width - viewportPadding) {
+    left = viewport.width - viewportPadding - popoverWidth
+  }
+
+  let top = rect.bottom + gap
+  const estimatedHeight = 420
+  if (top + estimatedHeight > viewport.height - viewportPadding && rect.top > estimatedHeight) {
+    top = rect.top - gap - estimatedHeight
+  }
+
+  popoverPositionStyle.value = {
+    top: `${Math.max(viewportPadding, top)}px`,
+    left: `${Math.max(viewportPadding, left)}px`,
+  }
+}
+
+function togglePopover() {
+  if (showPopover.value) {
+    closePopover()
+  } else {
+    openPopover()
+  }
+}
+
+function openPopover() {
+  checkMobile()
+  showPopover.value = true
+  nextTick(() => {
+    updatePosition()
+  })
+}
+
+function closePopover() {
+  showPopover.value = false
+}
+
+function handleKeydown(e: KeyboardEvent) {
+  if (e.key === 'Escape' && showPopover.value) {
+    closePopover()
+  }
+}
+
+function handleResize() {
+  checkMobile()
+  if (showPopover.value) {
+    updatePosition()
+  }
+}
+
+function handleScroll(e: Event) {
+  if (showPopover.value && popoverRef.value && e.target instanceof Node && popoverRef.value.contains(e.target)) {
+    return
+  }
+  if (showPopover.value && !isMobile.value) {
+    closePopover()
+  }
+}
+
+onMounted(() => {
+  checkMobile()
+  window.addEventListener('keydown', handleKeydown)
+  window.addEventListener('resize', handleResize)
+  window.addEventListener('scroll', handleScroll, true)
+})
+
+onBeforeUnmount(() => {
+  window.removeEventListener('keydown', handleKeydown)
+  window.removeEventListener('resize', handleResize)
+  window.removeEventListener('scroll', handleScroll, true)
+})
+
+const rowBusy = ref<string | null>(null)
+let resetTimer: ReturnType<typeof setTimeout> | undefined
+
+// Every model row is open by default; the admin can collapse any row.
+const rowToggles = ref<Record<string, boolean>>({})
+watch(() => props.accountId, () => {
+  if (resetTimer !== undefined) clearTimeout(resetTimer)
+  rowBusy.value = null
+  rowToggles.value = {}
+  showPopover.value = false
+}, { flush: 'sync' })
+onBeforeUnmount(() => {
+  if (resetTimer !== undefined) clearTimeout(resetTimer)
+})
+function defaultOpen(_row: ModelRowData): boolean {
+  return true
+}
+function chipText(row: ModelRowData): string {
+  const label = getModelConclusionLabel(row.latest)
+  return row.probText && !label.includes('%') ? `${label} ${row.probText}` : label
+}
+
+function isRowOpen(row: ModelRowData): boolean {
+  return rowToggles.value[row.model] ?? defaultOpen(row)
+}
+function toggleRow(row: ModelRowData): void {
+  rowToggles.value = { ...rowToggles.value, [row.model]: !isRowOpen(row) }
+}
+
+function handleRetestModel(model: string): void {
+  if (!availableModels.value.includes(model)) return
+  selectedModel.value = model
+  void handleRun()
+}
+
+function handleResetModel(model: string): void {
+  if (rowBusy.value || !availableModels.value.includes(model)) return
+  rowBusy.value = model
+  actionIsError.value = false
+  actionMessage.value = '已提交重置，几秒后刷新结果。'
+  emit('reset', props.accountId, model)
+  resetTimer = setTimeout(() => {
+    rowBusy.value = null
+    resetTimer = undefined
+  }, 1500)
+}
+
+async function handleRun(): Promise<void> {
+  if (!canRun.value) return
+  submitting.value = true
+  actionMessage.value = ''
+  actionIsError.value = false
+  try {
+    emit('run', props.accountId, selectedModel.value)
+    actionMessage.value = '已请求检测，等待后台确认。'
+  } catch (err: any) {
+    actionIsError.value = true
+    actionMessage.value = err?.message || '未能提交：检测可能已排队、正在冷却或服务暂不可用。'
+  } finally {
+    submitting.value = false
+  }
+}
+</script>
