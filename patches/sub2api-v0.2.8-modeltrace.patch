+func TestModelTraceRunPreflightFailureNeverPosts(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		body   string
+		want   int
+	}{
+		{"model mismatch", 200, `{"monitor_id":5,"model":"model-old","latest":{"target_probability":0.9}}`, 409},
+		{"missing model", 200, `{"monitor_id":5}`, 409},
+		{"wrong monitor", 200, `{"monitor_id":6,"model":"model-current"}`, 503},
+		{"auth denial", 401, `Bearer test-secret`, 503},
+		{"unavailable", 503, `private endpoint`, 503},
+		{"malformed", 200, `not JSON`, 503},
+		{"secret in snapshot", 200, `{"monitor_id":5,"model":"model-current","scope_label":"test-secret"}`, 503},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var gets, posts atomic.Int64
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == http.MethodPost {
+					posts.Add(1)
+					w.WriteHeader(http.StatusAccepted)
+					return
+				}
+				gets.Add(1)
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer srv.Close()
+			t.Setenv("MODELTRACE_INTERNAL_URL", srv.URL)
+			t.Setenv("MODELTRACE_SECRET", "test-secret")
+			repo := newModelTraceHandlerRepo()
+			h := NewChannelMonitorUserHandler(service.NewChannelMonitorService(repo, nil), nil)
+			w := modelTraceHandlerRequest(h, http.MethodPost, "5")
+			require.Equal(t, tc.want, w.Code, w.Body.String())
+			require.Equal(t, int64(1), gets.Load())
+			require.Zero(t, posts.Load(), "failed preflight must never enqueue a billable check")
+			if tc.want == http.StatusConflict {
+				require.Contains(t, w.Body.String(), `"reason":"MODELTRACE_MODEL_MISMATCH"`)
+				status := modelTraceHandlerRequest(h, http.MethodGet, "5")
+				require.Equal(t, status.Code, w.Code)
+				require.JSONEq(t, status.Body.String(), w.Body.String(), "GET and POST must use the same mismatch response")
+			}
+			for _, private := range []string{"test-secret", "private", "model-old", "target_probability", `"queued"`, `"data"`} {
+				require.NotContains(t, w.Body.String(), private)
+			}
+			require.Zero(t, repo.latestReads)
+			require.Empty(t, repo.availabilityWindows)
+		})
+	}
+}
