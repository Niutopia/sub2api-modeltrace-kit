+import { getDisplayScale } from './displayScale'
+
+/** Convert visual viewport pixels to CSS pixels inside the zoomed document. */
+export const toLayoutPixels = (value: number): number => value / getDisplayScale()
+
+export const getLayoutRect = (element: Element): DOMRect => {
+  const rect = element.getBoundingClientRect()
+  return new DOMRect(
+    toLayoutPixels(rect.left), toLayoutPixels(rect.top),
+    toLayoutPixels(rect.width), toLayoutPixels(rect.height)
+  )
+}
+
+export const getLayoutViewport = () => ({
+  width: toLayoutPixels(document.documentElement.clientWidth || window.innerWidth),
+  height: toLayoutPixels(window.innerHeight),
+})
