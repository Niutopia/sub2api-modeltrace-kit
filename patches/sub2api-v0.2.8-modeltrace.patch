+
+// Per-account counts only mean something once some account has a result for
+// this model; before that (or with no checkable account) keep the monitor view.
+const accountsSummary = computed<AccountsSummary | null>(() => {
+  const s = currentSnapshot.value?.accounts_summary
+  if (!s || s.total <= 0) return null
+  if (s.match + s.suspect + s.uncertain + s.error <= 0) return null
+  return s
+})
+
+const latest = computed(() => (
+  currentSnapshot.value?.supported ? currentSnapshot.value.latest : null
+))
+const scoredLatest = computed(() => (
+  !currentSnapshot.value?.stale && isScoredRound(latest.value) ? latest.value : null
+))
+
+const isUpstreamModelMismatch = computed(() => latest.value?.message_code === 'upstream_model_mismatch')
+const isEffectivelyQueued = computed(() => (
+  !isEffectivelyRunning.value && (localOptimisticQueued.value || props.queued || currentSnapshot.value?.queued === true)
+))
+
+const isEffectivelyRunning = computed(() => (
+  props.running || currentSnapshot.value?.running === true
+))
+
+const canRun = computed(() => (
+  auth.isAdmin
+  && currentSnapshot.value?.supported === true
+  && !isEffectivelyQueued.value
+  && !isEffectivelyRunning.value
+  && !submitting.value
+))
+
+// 仅当 ModelTrace 快照 enabled=true 且 supported=true 时显示；否则完全不渲染，不留空位
+const isVisible = computed(() => {
+  if (unavailable.value || mappingMismatch.value) return false
+  return currentSnapshot.value?.enabled === true && currentSnapshot.value?.supported === true
+})
+
+// 状态判定：
+// - running → 检测中 (蓝)
+// - error/其他失败 → 检测失败 (灰)
+// - stale → 已过期 (灰)
+// - match → 一致 XX% (绿)
+// - suspect → 可疑 XX% (红)
+// - uncertain → 不确定 XX% 或复测进度 X/Y (琥珀)
+// - waiting → 等待首轮 (灰)
+type TagStatusType = 'match' | 'suspect' | 'uncertain' | 'error' | 'queued' | 'running' | 'stale' | 'waiting'
+
+const activeElapsedSeconds = computed(() => {
+  const serverStart = currentSnapshot.value?.started_at ? Date.parse(currentSnapshot.value.started_at) : NaN
+  const start = Number.isFinite(serverStart) ? serverStart : props.runningAt ?? props.queuedAt ?? localOptimisticStartTime.value
+  if (start === null || start === undefined) return 0
+  return Math.max(0, Math.floor((nowTick.value - start) / 1000))
+})
+
+const runningLabelText = computed(() => {
+  return `检测中 · 已用 ${activeElapsedSeconds.value} 秒`
+})
+
+// Completed result and pending job are separate facts.
+const resultStatus = computed<TagStatusType>(() => {
+  if (isUpstreamModelMismatch.value || latest.value?.status === 'error') return 'error'
+  if (currentSnapshot.value?.stale) return 'stale'
+  const status = latest.value?.status
+  if (status === 'match') return 'match'
+  if (status === 'suspect') return 'suspect'
+  if (status === 'uncertain') return 'uncertain'
+  if (!latest.value) return 'waiting'
+  return 'error'
+})
+const monitorStatus = computed<TagStatusType>(() => {
+  if (isEffectivelyRunning.value) return 'running'
+  if (submitting.value || isEffectivelyQueued.value) return 'queued'
+  return resultStatus.value
+})
+const jobStatusLabel = computed(() => {
+  if (isEffectivelyRunning.value) return activeElapsedSeconds.value > 0 ? runningLabelText.value : '检测中'
+  if (submitting.value || isEffectivelyQueued.value) {
+    const available = currentSnapshot.value?.available_at
+    return available ? `排队中 · 可执行 ${shortTime(available)}` : '排队中'
+  }
+  return ''
+})
+
+// Status of the card tag. With per-account results the tag summarises accounts
+// ("一致性 2/3": all match → green, any suspect → red, otherwise amber/grey).
+const tagStatus = computed<TagStatusType>(() => {
+  if (monitorStatus.value === 'running' || monitorStatus.value === 'queued') return monitorStatus.value
+  if (accountsSummary.value) {
+    const s = accountsSummary.value
+    if (s.suspect > 0) return 'suspect'
+    if (s.total > 0 && s.match === s.total) return 'match'
+    if (s.uncertain > 0) return 'uncertain'
+    return 'error'
+  }
+  return monitorStatus.value
+})
+
+const conclusionLabel = computed(() => {
+  switch (resultStatus.value) {
+    case 'queued': return '排队中'
+    case 'running': return activeElapsedSeconds.value > 0 ? runningLabelText.value : '检测中'
+    case 'stale': return '结果已过期'
+    case 'match': return '匹配'
+    case 'suspect': return '可疑'
+    case 'uncertain': return '不确定'
+    case 'error': return '检测失败'
+    case 'waiting': return '等待首轮'
+  }
+  return ''
+})
+
+const tagText = computed(() => {
+  if (monitorStatus.value === 'running' || monitorStatus.value === 'queued') return `一致性 · ${jobStatusLabel.value}`
