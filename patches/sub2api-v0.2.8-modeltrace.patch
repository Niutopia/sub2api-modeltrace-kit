+
+const summaryPills = computed(() => {
+  const s = accountsSummary.value
+  if (!s) return []
+  return [
+    { label: '一致', count: s.match, activeClass: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300' },
+    { label: '可疑', count: s.suspect, activeClass: 'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300' },
+    { label: '不确定', count: s.uncertain, activeClass: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300' },
+    { label: '失败', count: s.error, activeClass: 'bg-gray-200 text-gray-700 dark:bg-dark-600 dark:text-gray-200' },
+  ]
