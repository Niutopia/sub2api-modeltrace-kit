+}
+
+const SHORT_MESSAGE_LABELS: Record<string, string> = {
+  compatible: '指纹与目标模型一致',
+  difference_signal: '本题特征偏向另一模型',
+  account_unavailable: '账号不可用',
+  upstream_no_available_account: '上游暂无可用账号',
+  output_truncated: '上游输出被截断',
+  insufficient_output: '有效回答不足',
+  insufficient_sample: '有效数字样本不足',
+  response_truncated: '响应被截断',
+  invalid_event_stream: '响应事件流格式无效',
+  response_too_large: '响应超过大小限制',
+  upstream_timeout: '上游响应超时',
+  upstream_5xx: '上游服务错误',
+  upstream_unsupported_reasoning_effort: '上游不支持思考档位',
+  calibration_unverified_reasoning_effort: '缺少校准基线',
+  upstream_response_failed: '上游返回失败状态',
+  classifier_sample_mismatch: '分类器样本不一致',
+  classifier_error: '分类器处理失败',
+  mixed_upstream_account: '探针落入不同账号',
+  mixed_route: '探针落入不同账号',
+  upstream_error: '上游请求失败',
+  incomplete_response: '回答被截断',
+  upstream_model_mismatch: '上游模型标识不一致',
+}
+
+const props = withDefaults(defineProps<{
+  accountId: number
+  traceItem?: AccountTraceItem | null
+  loading?: boolean
+  unavailable?: boolean
+  optimisticQueued?: boolean
+}>(), {
+  traceItem: null,
+  loading: false,
+  unavailable: false,
+  optimisticQueued: false,
+})
+
+const emit = defineEmits<{
+  (e: 'run', accountId: number, model?: string): void
+  (e: 'reset', accountId: number, model: string): void
+}>()
+
+const triggerRef = ref<HTMLButtonElement | null>(null)
+const popoverRef = ref<HTMLDivElement | null>(null)
+const showPopover = ref(false)
+const isMobile = ref(false)
+const popoverPositionStyle = ref<Record<string, string>>({})
+const submitting = ref(false)
+const actionMessage = ref('')
+const actionIsError = ref(false)
+const selectedModel = ref('')
+const currentTraceItem = ref<AccountTraceItem | null>(null)
+
+watch(() => [props.accountId, props.traceItem] as const, ([id, item], previous) => {
+  if (previous && previous[0] !== id) {
+    currentTraceItem.value = null
+    selectedModel.value = ''
+    actionMessage.value = ''
+    actionIsError.value = false
+  }
+  if (!item || (item.account_id !== id && !item.member_account_ids?.includes(id))) {
+    currentTraceItem.value = null
