+++ b/backend/internal/pkg/modeltrace/client_test.go
@@ -0,0 +1,315 @@
+package modeltrace
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestModelTracePublicAllowlist(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, "Bearer test-secret", r.Header.Get("Authorization"))
+		require.Equal(t, "/v1/monitors/5", r.URL.Path)
+		w.Write([]byte(`{"monitor_id":5,"model":"model-current","supported":true,"history":[{"id":2,"api_key":"secret","ranking":[{"model":"model-current","probability":0.8,"authorization":"test-secret"}]}],"api_key":"test-secret","account_id":14,"endpoint":"https://private.invalid","latest":{"id":1,"status":"match","target_probability":0.9,"account_ids":[14],"raw_output":"private","ranking":[{"model":"model-current","probability":0.9,"credentials":{"token":"test-secret"}}]}}`))
+	}))
+	defer srv.Close()
+	t.Setenv("MODELTRACE_INTERNAL_URL", srv.URL)
+	t.Setenv("MODELTRACE_SECRET", "test-secret")
+	s, err := Get(context.Background(), 5, "model-current")
+	require.NoError(t, err)
+	b, err := json.Marshal(s)
+	require.NoError(t, err)
+	for _, v := range []string{"api_key", "secret", "account_id", "raw_output", "private", "endpoint", "authorization", "credentials"} {
+		require.NotContains(t, string(b), v)
+	}
+}
+func TestModelTraceInternalURLAllowlist(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		raw   string
+		allow bool
+	}{
+		{name: "loopback ipv4", raw: "http://127.0.0.1:8849", allow: true},
+		{name: "loopback ipv6", raw: "http://[::1]:8849", allow: true},
+		{name: "localhost", raw: "http://localhost:8849", allow: true},
+		{name: "docker sidecar", raw: "http://sub2api-modeltrace:8081", allow: true},
+		{name: "docker sidecar tls", raw: "https://sub2api-modeltrace:8081", allow: true},
+		{name: "legacy docker service", raw: "http://modeltrace:8081", allow: true},
+		{name: "arbitrary private ip", raw: "http://10.0.0.5:8081", allow: false},
+		{name: "arbitrary https host", raw: "https://example.com:443", allow: false},
+		{name: "wrong docker port", raw: "http://sub2api-modeltrace:8080", allow: false},
+		{name: "lookalike host", raw: "http://sub2api-modeltrace.example:8081", allow: false},
+		{name: "localhost lookalike", raw: "http://localhost.example:8849", allow: false},
+		{name: "ftp", raw: "ftp://127.0.0.1:8849", allow: false},
+		{name: "query", raw: "http://127.0.0.1:8849?target=example.com", allow: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			u, err := url.Parse(tc.raw)
+			require.NoError(t, err)
+			require.Equal(t, tc.allow, isAllowedInternalURL(u))
+		})
+	}
+}
+
+func TestModelTraceRunSendsExpectedModel(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, http.MethodPost, r.Method)
+		require.Equal(t, "/v1/monitors/5/run", r.URL.Path)
+		require.Equal(t, "application/json", r.Header.Get("Content-Type"))
+		var payload map[string]any
+		require.NoError(t, json.NewDecoder(r.Body).Decode(&payload))
+		require.Equal(t, map[string]any{"expected_model": "gpt-5.6-terra"}, payload)
+		_, _ = w.Write([]byte(`{"queued":true}`))
+	}))
+	defer srv.Close()
+	t.Setenv("MODELTRACE_INTERNAL_URL", srv.URL)
+	t.Setenv("MODELTRACE_SECRET", "test-secret")
+	require.NoError(t, Run(context.Background(), 5, "gpt-5.6-terra"))
+}
+
+func TestModelTraceRunRejectsEmptyExpectedModelWithoutRequest(t *testing.T) {
+	var calls atomic.Int64
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls.Add(1) }))
+	defer srv.Close()
+	t.Setenv("MODELTRACE_INTERNAL_URL", srv.URL)
+	t.Setenv("MODELTRACE_SECRET", "test-secret")
+	require.ErrorIs(t, Run(context.Background(), 5, " \t"), ErrUnavailable)
+	require.Zero(t, calls.Load())
+}
+
+func TestModelTraceFailsClosed(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		body   string
+	}{
+		{"missing", 404, "{}"}, {"wrong monitor", 200, `{"monitor_id":2}`}, {"large", 200, strings.Repeat("x", 262145)}, {"malformed", 200, "not-json"},
+		{"null", 200, "null"}, {"trailing JSON", 200, `{"monitor_id":1,"model":"model-current"}{}`},
+		{"too much history", 200, `{"monitor_id":1,"model":"model-current","history":[` + strings.Repeat(`{},`, 16) + `{}]}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(tc.status); w.Write([]byte(tc.body)) }))
+			defer srv.Close()
+			t.Setenv("MODELTRACE_INTERNAL_URL", srv.URL)
+			t.Setenv("MODELTRACE_SECRET", "secret")
+			snapshot, err := Get(context.Background(), 1, "model-current")
+			require.ErrorIs(t, err, ErrUnavailable)
+			require.Nil(t, snapshot)
+		})
+	}
+}
+func TestModelTraceNoRedirectAndCooldown(t *testing.T) {
+	var redirects atomic.Int64
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { redirects.Add(1) }))
+	defer target.Close()
+	for _, status := range []int{302, 409, 429} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Location", target.URL+"/secret")
+				w.WriteHeader(status)
+				if status == http.StatusConflict {
+					_, _ = w.Write([]byte(`{"message_code":"expected_model_mismatch"}`))
+				}
+			}))
+			defer srv.Close()
+			t.Setenv("MODELTRACE_INTERNAL_URL", srv.URL)
+			t.Setenv("MODELTRACE_SECRET", "secret")
+			err := Run(context.Background(), 1, "model-current")
+			require.Zero(t, redirects.Load(), "redirects must never receive the bridge credential")
+			switch status {
+			case 302:
+				require.ErrorIs(t, err, ErrUnavailable)
+			case http.StatusConflict:
+				require.ErrorIs(t, err, ErrModelMismatch)
+			default:
+				require.ErrorIs(t, err, ErrBusy)
+			}
+		})
+	}
